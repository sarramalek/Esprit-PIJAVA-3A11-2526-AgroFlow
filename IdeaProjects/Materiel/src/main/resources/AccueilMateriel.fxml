<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AccueilMaterielController">

    <!-- ═══════════════════  SIDEBAR UNIFIÉE  ═══════════════════ -->
    <left>
        <VBox prefWidth="240" spacing="0"
              style="-fx-background-color: #2c3e50; -fx-padding: 0;">

            <!-- En-tête logo -->
            <VBox style="-fx-background-color: #1a252f; -fx-padding: 22 18 18 18; -fx-spacing: 4; -fx-alignment: center-left;">
                <Label text="✳ AGROFLOW"
                       style="-fx-text-fill: white; -fx-font-size: 20px; -fx-font-weight: bold;"/>
                <Label text="Gestion Agricole"
                       style="-fx-text-fill: #95a5a6; -fx-font-size: 11px;"/>
            </VBox>

            <Separator style="-fx-background-color: #34495e;"/>

            <!-- Menu de navigation -->
            <VBox spacing="2" style="-fx-padding: 10 0 10 0;">
                <Button text="🐄 Gestion Animaux" onAction="#naviguerAnimaux"
                        prefWidth="240" prefHeight="46"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 13px;
                               -fx-alignment: center-left; -fx-padding: 0 0 0 22; -fx-border-width: 0;
                               -fx-cursor: hand; -fx-background-radius: 0;"/>

                <Button text="🚜 Gestion Matériels" onAction="#naviguerMateriels"
                        prefWidth="240" prefHeight="46"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-alignment: center-left; -fx-padding: 0 0 0 22; -fx-border-width: 0;
                               -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 0;"/>

                <Button text="📦 Gestion Stocks" onAction="#naviguerStocks"
                        prefWidth="240" prefHeight="46"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 13px;
                               -fx-alignment: center-left; -fx-padding: 0 0 0 22; -fx-border-width: 0;
                               -fx-cursor: hand; -fx-background-radius: 0;"/>

                <Button text="🌐 Gestion Terrains" onAction="#naviguerTerrains"
                        prefWidth="240" prefHeight="46"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 13px;
                               -fx-alignment: center-left; -fx-padding: 0 0 0 22; -fx-border-width: 0;
                               -fx-cursor: hand; -fx-background-radius: 0;"/>

                <Button text="📅 Événements" onAction="#naviguerEvenements"
                        prefWidth="240" prefHeight="46"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 13px;
                               -fx-alignment: center-left; -fx-padding: 0 0 0 22; -fx-border-width: 0;
                               -fx-cursor: hand; -fx-background-radius: 0;"/>

                <Button text="👥 Utilisateurs" onAction="#naviguerUsers"
                        prefWidth="240" prefHeight="46"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7; -fx-font-size: 13px;
                               -fx-alignment: center-left; -fx-padding: 0 0 0 22; -fx-border-width: 0;
                               -fx-cursor: hand; -fx-background-radius: 0;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Bouton déconnexion -->
            <Button text="⏻ Déconnexion" onAction="#deconnexion"
                    prefWidth="240" prefHeight="52"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 13px;
                           -fx-border-width: 0; -fx-font-weight: bold; -fx-cursor: hand;
                           -fx-background-radius: 0; -fx-alignment: center-left; -fx-padding: 0 0 0 22;"/>
        </VBox>
    </left>

    <!-- ═══════════════════  CENTER  ═══════════════════ -->
    <center>
        <VBox spacing="40" alignment="CENTER" style="-fx-padding: 40;">

            <Text text="Module Gestion Matériels" fill="#2C3E50">
                <font><Font name="System Bold" size="28"/></font>
            </Text>

            <HBox spacing="40" alignment="CENTER">

                <!-- MACHINES -->
                <VBox spacing="15" alignment="CENTER"
                      onMouseClicked="#ouvrirMachines"
                      prefWidth="200.0" prefHeight="200.0"
                      style="-fx-background-color: white; -fx-padding: 25;
                             -fx-border-radius: 10; -fx-background-radius: 10;
                             -fx-cursor: hand;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);
                             -fx-border-color: #e0e0e0; -fx-border-width: 1;">
                    <Text text="🚜" style="-fx-font-size: 64px;"/>
                    <Text text="Machines"
                          style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #2C3E50;"/>
                    <Text text="Gérer les machines agricoles"
                          style="-fx-font-size: 12px; -fx-fill: #7f8c8d;"/>
                </VBox>

                <!-- MAINTENANCES -->
                <VBox spacing="15" alignment="CENTER"
                      onMouseClicked="#ouvrirMaintenances"
                      prefWidth="200.0" prefHeight="200.0"
                      style="-fx-background-color: white; -fx-padding: 25;
                             -fx-border-radius: 10; -fx-background-radius: 10;
                             -fx-cursor: hand;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);
                             -fx-border-color: #e0e0e0; -fx-border-width: 1;">
                    <Text text="🔧" style="-fx-font-size: 64px;"/>
                    <Text text="Maintenances"
                          style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #2C3E50;"/>
                    <Text text="Planifier les maintenances"
                          style="-fx-font-size: 12px; -fx-fill: #7f8c8d;"/>
                </VBox>

                <!-- ACHATS -->
                <VBox spacing="15" alignment="CENTER"
                      onMouseClicked="#ouvrirAchats"
                      prefWidth="200.0" prefHeight="200.0"
                      style="-fx-background-color: white; -fx-padding: 25;
                             -fx-border-radius: 10; -fx-background-radius: 10;
                             -fx-cursor: hand;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 3);
                             -fx-border-color: #e0e0e0; -fx-border-width: 1;">
                    <Text text="🛒" style="-fx-font-size: 64px;"/>
                    <Text text="Achats"
                          style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-fill: #2C3E50;"/>
                    <Text text="Suivre les achats"
                          style="-fx-font-size: 12px; -fx-fill: #7f8c8d;"/>
                </VBox>

            </HBox>

            <Text text="Cliquez sur une carte pour accéder au module correspondant"
                  fill="#95a5a6" style="-fx-font-size: 14px; -fx-font-style: italic;"/>

        </VBox>
    </center>

</BorderPane>
