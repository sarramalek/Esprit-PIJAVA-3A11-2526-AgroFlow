<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="0" prefWidth="500"
      style="-fx-background-color: white;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.AjouterMaintenanceController">

    <!-- ===== EN-TETE ===== -->
    <VBox style="-fx-background-color: #27ae60; -fx-padding: 20 25;">
        <Label text="Ajouter une Maintenance"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="Remplissez tous les champs obligatoires (*)"
               style="-fx-font-size: 12px; -fx-text-fill: #d5f5e3;"/>
    </VBox>

    <!-- ===== FORMULAIRE ===== -->
    <VBox spacing="14" style="-fx-padding: 25 25 10 25;">

        <!-- Machine (JOINTURE : affiche le NOM, stocke l'idM) -->
        <VBox spacing="5">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Machine" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                <Label text="*" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
            </HBox>
            <!-- ComboBox typée Machine : affiche le nom, retourne l'objet Machine complet -->
            <ComboBox fx:id="comboMachine"
                      promptText="Selectionner une machine"
                      maxWidth="Infinity"
                      style="-fx-background-radius: 6; -fx-border-color: #cbd5e0;
                             -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 4;"/>
            <Label fx:id="errMachine" text=""
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Type de panne -->
        <VBox spacing="5">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Type de Panne" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                <Label text="*" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
            </HBox>
            <TextField fx:id="txtTypePanne"
                       promptText="Ex: Panne moteur, Hydraulique..."
                       style="-fx-background-radius: 6; -fx-border-color: #cbd5e0;
                              -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 8;"/>
            <Label fx:id="errTypePanne" text=""
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Date -->
        <VBox spacing="5">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Date de Maintenance" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                <Label text="*" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
            </HBox>
            <DatePicker fx:id="datePickerMain"
                        maxWidth="Infinity"
                        style="-fx-background-radius: 6; -fx-border-color: #cbd5e0;
                               -fx-border-radius: 6; -fx-font-size: 13px;"/>
            <Label fx:id="errDate" text=""
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Coût -->
        <VBox spacing="5">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Cout (DT)" style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                <Label text="*" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
            </HBox>
            <TextField fx:id="txtCout"
                       promptText="0.00"
                       style="-fx-background-radius: 6; -fx-border-color: #cbd5e0;
                              -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 8;"/>
            <Label fx:id="errCout" text=""
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Description (optionnel) -->
        <VBox spacing="5">
            <Label text="Description (optionnel)"
                   style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
            <TextArea fx:id="txtDescription"
                      prefHeight="90" wrapText="true"
                      promptText="Details de l'intervention, pieces changees..."
                      style="-fx-background-radius: 6; -fx-border-color: #cbd5e0;
                             -fx-border-radius: 6; -fx-font-size: 13px;"/>
        </VBox>

    </VBox>

    <!-- ===== SEPARATEUR ===== -->
    <Separator style="-fx-padding: 0 0 10 0;"/>

    <!-- ===== BOUTONS ===== -->
    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 15 25 20 25;">
        <Button text="Annuler" onAction="#annuler"
                prefWidth="110" prefHeight="38"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                       -fx-cursor: hand; -fx-font-size: 13px;
                       -fx-background-radius: 6; -fx-font-weight: bold;"/>
        <Button text="Enregistrer" onAction="#enregistrer"
                prefWidth="140" prefHeight="38"
                style="-fx-background-color: #27ae60; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;
                       -fx-background-radius: 6;"/>
    </HBox>

</VBox>
