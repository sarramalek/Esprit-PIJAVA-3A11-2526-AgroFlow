<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="650.0" prefWidth="950.0"
            style="-fx-background-color: #f0f2f5;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.ModifierMachineController">

    <!-- ═══════════════════  SIDEBAR  ═══════════════════ -->
    <left>
        <VBox prefWidth="230.0" spacing="5.0"
              style="-fx-background-color: #1e2a35; -fx-padding: 20 15 20 15;">

            <!-- Logo -->
            <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 0 0 5 5;">
                <Text fill="WHITE" text="❋" style="-fx-font-size: 22px;"/>
                <Text fill="WHITE" text="AGROFLOW">
                    <font><Font name="System Bold" size="20.0"/></font>
                </Text>
            </HBox>
            <Text fill="#95a5a6" text="Gestion Agricole" style="-fx-font-size: 13px; -fx-padding: 0 0 0 5;">
                <font><Font name="System Regular" size="13.0"/></font>
            </Text>

            <Separator opacity="0.15" style="-fx-padding: 10 0 10 0;"/>

            <Button text="  🐄  Gestion Animaux" onAction="#naviguerAnimaux"
                    maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #b0bec5;
                           -fx-cursor: hand; -fx-font-size: 14px;
                           -fx-padding: 0 0 0 10; -fx-background-radius: 8;"/>

            <Button text="  🚜  Gestion Matériels" onAction="#naviguerMateriels"
                    maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white;
                           -fx-cursor: hand; -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-padding: 0 0 0 10; -fx-background-radius: 8;"/>

            <Button text="  📦  Gestion Stocks" onAction="#naviguerStocks"
                    maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #b0bec5;
                           -fx-cursor: hand; -fx-font-size: 14px;
                           -fx-padding: 0 0 0 10; -fx-background-radius: 8;"/>

            <Button text="  🗺️  Gestion Terrains" onAction="#naviguerTerrains"
                    maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #b0bec5;
                           -fx-cursor: hand; -fx-font-size: 14px;
                           -fx-padding: 0 0 0 10; -fx-background-radius: 8;"/>

            <Button text="  📅  Événements" onAction="#naviguerEvenements"
                    maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #b0bec5;
                           -fx-cursor: hand; -fx-font-size: 14px;
                           -fx-padding: 0 0 0 10; -fx-background-radius: 8;"/>

            <Button text="  👥  Utilisateurs" onAction="#naviguerUsers"
                    maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                    style="-fx-background-color: transparent; -fx-text-fill: #b0bec5;
                           -fx-cursor: hand; -fx-font-size: 14px;
                           -fx-padding: 0 0 0 10; -fx-background-radius: 8;"/>

            <Region VBox.vgrow="ALWAYS"/>
            <Separator opacity="0.15"/>

            <Button text="⚪  Déconnexion" onAction="#deconnexion"
                    maxWidth="Infinity" alignment="CENTER" prefHeight="45.0"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                           -fx-cursor: hand; -fx-font-size: 14px; -fx-font-weight: bold;
                           -fx-background-radius: 8;"/>
        </VBox>
    </left>

    <!-- ═══════════════════  CENTER  ═══════════════════ -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: #f0f2f5;"
              alignment="TOP_CENTER">

            <!-- En-tête -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Button text="← Retour" onAction="#handleAnnuler"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-padding: 9 16;
                               -fx-background-radius: 7; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Label text="✏️  Modifier une Machine"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </HBox>

            <Separator/>

            <!-- Formulaire -->
            <VBox spacing="0" alignment="CENTER" maxWidth="660.0">
                <GridPane hgap="15.0" vgap="16.0"
                          style="-fx-background-color: white; -fx-padding: 36 40 36 40;
                                 -fx-background-radius: 12; -fx-border-color: #dfe6e9;
                                 -fx-border-width: 1; -fx-border-radius: 12;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.10),12,0,0,3);">
                    <columnConstraints>
                        <ColumnConstraints minWidth="130.0" prefWidth="140.0"/>
                        <ColumnConstraints minWidth="350.0" prefWidth="370.0"/>
                    </columnConstraints>

                    <Label text="Marque :" GridPane.columnIndex="0" GridPane.rowIndex="0"
                           style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                    <TextField fx:id="tfMarque" promptText="Ex : John Deere, Case..."
                               GridPane.columnIndex="1" GridPane.rowIndex="0"
                               style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 6;
                                      -fx-border-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1.2;"/>

                    <Label text="Modèle :" GridPane.columnIndex="0" GridPane.rowIndex="1"
                           style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                    <TextField fx:id="tfModele" promptText="Ex : MX100, X70..."
                               GridPane.columnIndex="1" GridPane.rowIndex="1"
                               style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 6;
                                      -fx-border-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1.2;"/>

                    <Label text="État :" GridPane.columnIndex="0" GridPane.rowIndex="2"
                           style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                    <ComboBox fx:id="tfEtatM" promptText="Sélectionnez l'état"
                              GridPane.columnIndex="1" GridPane.rowIndex="2" maxWidth="Infinity"
                              style="-fx-font-size: 14px; -fx-background-radius: 6;
                                     -fx-border-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1.2;"/>

                    <Label text="N° Série :" GridPane.columnIndex="0" GridPane.rowIndex="3"
                           style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                    <TextField fx:id="tfNumeroSerie" promptText="Ex : SN12345..."
                               GridPane.columnIndex="1" GridPane.rowIndex="3"
                               style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 6;
                                      -fx-border-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1.2;"/>

                    <Label text="Date d'Achat :" GridPane.columnIndex="0" GridPane.rowIndex="4"
                           style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                    <DatePicker fx:id="dpDateAchat" promptText="Sélectionnez la date"
                                GridPane.columnIndex="1" GridPane.rowIndex="4" maxWidth="Infinity"
                                style="-fx-font-size: 14px; -fx-padding: 5;"/>

                    <Label text="Nom :" GridPane.columnIndex="0" GridPane.rowIndex="5"
                           style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                    <TextField fx:id="tfNom" promptText="Nom de la machine"
                               GridPane.columnIndex="1" GridPane.rowIndex="5"
                               style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 6;
                                      -fx-border-radius: 6; -fx-border-color: #bdc3c7; -fx-border-width: 1.2;"/>
                </GridPane>
            </VBox>

            <!-- Boutons -->
            <HBox spacing="20.0" alignment="CENTER">
                <Button text="✏️  MODIFIER" onAction="#handleModifier"
                        prefWidth="180.0" prefHeight="48.0"
                        style="-fx-background-color: #2980b9; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-font-size: 15px; -fx-cursor: hand;
                               -fx-background-radius: 9;
                               -fx-effect: dropshadow(gaussian,rgba(41,128,185,0.4),10,0,0,3);"/>
                <Button text="✖  ANNULER" onAction="#handleAnnuler"
                        prefWidth="180.0" prefHeight="48.0"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-font-size: 15px; -fx-cursor: hand;
                               -fx-background-radius: 9;
                               -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.2),8,0,0,2);"/>
            </HBox>

            <Label text="ℹ  Modifiez les informations puis cliquez sur MODIFIER pour enregistrer les changements."
                   wrapText="true" maxWidth="620"
                   style="-fx-font-size: 12px; -fx-font-style: italic;
                          -fx-text-fill: #7f8c8d; -fx-text-alignment: center;"/>
        </VBox>
    </center>

</BorderPane>
