<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.ModifierMaintenanceController"
      spacing="0" prefWidth="500"
      style="-fx-background-color: white;">

    <!-- ===== EN-TETE ===== -->
    <VBox style="-fx-background-color: #f39c12; -fx-padding: 20 25;">
        <Label text="Modifier une Maintenance"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        <Label text="Modifiez les champs souhaites puis enregistrez (*  = obligatoire)"
               style="-fx-font-size: 12px; -fx-text-fill: #fef9f0;"/>
    </VBox>

    <!-- ===== FORMULAIRE ===== -->
    <VBox spacing="14" style="-fx-padding: 25 25 10 25;">

        <!-- Machine (JOINTURE : ComboBox<Machine> affiche le nom, stocke l'objet) -->
        <VBox spacing="5">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Machine"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                <Label text="*" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
            </HBox>
            <ComboBox fx:id="comboMachine"
                      promptText="Selectionner une machine"
                      maxWidth="Infinity"
                      style="-fx-background-radius: 6; -fx-border-color: #cbd5e0;
                             -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 4;"/>
            <Label fx:id="errMachine" text=""
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Type de Panne -->
        <VBox spacing="5">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Type de Panne"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                <Label text="*" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
            </HBox>
            <TextField fx:id="txtTypePanne"
                       promptText="Ex: Panne moteur, Court-circuit..."
                       style="-fx-background-radius: 6; -fx-border-color: #cbd5e0;
                              -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 8;"/>
            <Label fx:id="errTypePanne" text=""
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Date de Maintenance -->
        <VBox spacing="5">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Date de Maintenance"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                <Label text="*" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
            </HBox>
            <DatePicker fx:id="datePickerMaintenance"
                        maxWidth="Infinity"
                        style="-fx-background-radius: 6; -fx-border-color: #cbd5e0;
                               -fx-border-radius: 6; -fx-font-size: 13px;"/>
            <Label fx:id="errDate" text=""
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Coût -->
        <VBox spacing="5">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Cout (DT)"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                <Label text="*" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
            </HBox>
            <TextField fx:id="txtCout"
                       promptText="Ex: 450.00"
                       style="-fx-background-radius: 6; -fx-border-color: #cbd5e0;
                              -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 8;"/>
            <Label fx:id="errCout" text=""
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
        </VBox>

        <!-- Description -->
        <VBox spacing="5">
            <HBox spacing="4" alignment="CENTER_LEFT">
                <Label text="Description"
                       style="-fx-font-weight: bold; -fx-font-size: 13px; -fx-text-fill: #2c3e50;"/>
                <Label text="*" style="-fx-text-fill: #e74c3c; -fx-font-weight: bold;"/>
            </HBox>
            <TextArea fx:id="txtDescription"
                      prefHeight="100" wrapText="true"
                      promptText="Decrivez la panne, les travaux et les pieces remplacees (min. 10 caracteres)..."
                      style="-fx-background-radius: 6; -fx-border-color: #cbd5e0;
                             -fx-border-radius: 6; -fx-font-size: 13px;"/>
            <Label fx:id="errDescription" text=""
                   style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
        </VBox>

    </VBox>

    <!-- ===== SEPARATEUR ===== -->
    <Separator style="-fx-padding: 0 0 10 0;"/>

    <!-- ===== BOUTONS ===== -->
    <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 15 25 20 25;">
        <Button text="Annuler" onAction="#annuler"
                prefWidth="120" prefHeight="38"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                       -fx-cursor: hand; -fx-font-size: 13px;
                       -fx-background-radius: 6; -fx-font-weight: bold;"/>
        <Button text="Mettre a jour" onAction="#modifier"
                prefWidth="150" prefHeight="38"
                style="-fx-background-color: #f39c12; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px;
                       -fx-background-radius: 6;"/>
    </HBox>

</VBox>
