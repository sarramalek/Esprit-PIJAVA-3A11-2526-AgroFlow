<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            style="-fx-background-color: #ecf0f1;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AfficherAchatsController">

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox prefWidth="260" spacing="0"
              style="-fx-background-color: #2c3e50; -fx-padding: 0;">

            <!-- Header -->
            <VBox style="-fx-background-color: #1a252f; -fx-padding: 20 15;">
                <Label text="AGROFLOW"
                       style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label text="Gestion Agricole"
                       style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
            </VBox>

            <!-- Boutons navigation -->
            <VBox spacing="2" style="-fx-padding: 10 0;">

                <Button text="  Gestion Animaux" onAction="#naviguerAnimaux"
                        prefWidth="260" prefHeight="48"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;
                               -fx-font-size: 13px; -fx-alignment: center-left;
                               -fx-padding: 0 20; -fx-border-width: 0; -fx-cursor: hand;"/>

                <!-- GESTION MATERIELS : actif en vert + cliquable pour revenir -->
                <Button text="  Gestion Materiels" onAction="#naviguerMateriels"
                        prefWidth="260" prefHeight="48"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-alignment: center-left;
                               -fx-padding: 0 20; -fx-border-width: 0;
                               -fx-font-weight: bold; -fx-cursor: hand;"/>

                <Button text="  Gestion Stocks" onAction="#naviguerStocks"
                        prefWidth="260" prefHeight="48"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;
                               -fx-font-size: 13px; -fx-alignment: center-left;
                               -fx-padding: 0 20; -fx-border-width: 0; -fx-cursor: hand;"/>

                <Button text="  Gestion Terrains" onAction="#naviguerTerrains"
                        prefWidth="260" prefHeight="48"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;
                               -fx-font-size: 13px; -fx-alignment: center-left;
                               -fx-padding: 0 20; -fx-border-width: 0; -fx-cursor: hand;"/>

                <Button text="  Evenements" onAction="#naviguerEvenements"
                        prefWidth="260" prefHeight="48"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;
                               -fx-font-size: 13px; -fx-alignment: center-left;
                               -fx-padding: 0 20; -fx-border-width: 0; -fx-cursor: hand;"/>

                <!-- "Gestion Achats" SUPPRIME de la navbar -->

                <Button text="  Utilisateurs" onAction="#naviguerUsers"
                        prefWidth="260" prefHeight="48"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;
                               -fx-font-size: 13px; -fx-alignment: center-left;
                               -fx-padding: 0 20; -fx-border-width: 0; -fx-cursor: hand;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="  Deconnexion" onAction="#deconnexion"
                    prefWidth="260" prefHeight="50"
                    style="-fx-background-color: #c0392b; -fx-text-fill: white;
                           -fx-font-size: 13px; -fx-border-width: 0;
                           -fx-font-weight: bold; -fx-cursor: hand;"/>
        </VBox>
    </left>

    <!-- ================= CENTER ================= -->
    <center>
        <VBox spacing="15" style="-fx-padding: 25; -fx-background-color: #f5f6fa;">

            <!-- En-tête -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="Retour" onAction="#retourAccueil"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-padding: 10 20;
                               -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Label text="Gestion des Achats"
                       style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Nouvel Achat" onAction="#ouvrirAjout"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-padding: 10 20;
                               -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
            </HBox>

            <Separator style="-fx-background-color: #dde1e7;"/>

            <!-- Barre de recherche et filtres -->
            <HBox spacing="12" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-padding: 12 15;
                         -fx-background-radius: 8; -fx-border-color: #e2e8f0;
                         -fx-border-width: 1; -fx-border-radius: 8;">

                <Label text="Recherche :"
                       style="-fx-font-size: 13px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                <TextField fx:id="champRecherche" promptText="Machine, client, CIN..."
                           prefWidth="300" onKeyReleased="#rechercher"
                           style="-fx-padding: 8 12; -fx-background-radius: 6;
                                  -fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-font-size: 13px;"/>

                <Label text="Machine :"
                       style="-fx-font-size: 13px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                <ComboBox fx:id="comboMachine" promptText="Toutes les machines"
                          prefWidth="190" onAction="#filtrer"
                          style="-fx-background-radius: 6; -fx-font-size: 13px;"/>

                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualiser" onAction="#actualiser"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;
                               -fx-padding: 8 18; -fx-background-radius: 6;
                               -fx-cursor: hand; -fx-font-size: 13px; -fx-font-weight: bold;"/>
            </HBox>

            <!-- Tableau principal -->
            <TableView fx:id="tableAchats" VBox.vgrow="ALWAYS" prefHeight="400"
                       style="-fx-background-color: white; -fx-border-color: #e2e8f0;
                              -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="colDateAchat"  text="Date Achat"  prefWidth="130" minWidth="110"/>
                    <TableColumn fx:id="colQuantite"   text="Quantite"    prefWidth="110" minWidth="90"/>
                    <TableColumn fx:id="colMachine"    text="Machine"     prefWidth="200" minWidth="160"/>
                    <TableColumn fx:id="colClient"     text="Client"      prefWidth="200" minWidth="160"/>
                    <TableColumn fx:id="colCin"        text="CIN"         prefWidth="120" minWidth="100"/>
                    <TableColumn fx:id="colActions"    text="Actions"     prefWidth="160" minWidth="140"/>
                </columns>
                <placeholder>
                    <Label text="Aucun achat enregistre"
                           style="-fx-text-fill: #95a5a6; -fx-font-style: italic;
                                  -fx-font-size: 14px; -fx-padding: 40;"/>
                </placeholder>
            </TableView>

            <!-- Statistiques -->
            <HBox spacing="20" alignment="CENTER">

                <HBox alignment="CENTER_LEFT" spacing="15"
                      style="-fx-background-color: white; -fx-padding: 18 30;
                             -fx-border-color: #3498db; -fx-border-width: 0 0 0 5;
                             -fx-border-radius: 2; -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <VBox spacing="3">
                        <Label text="Total Achats"
                               style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotal" text="0"
                               style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15"
                      style="-fx-background-color: white; -fx-padding: 18 30;
                             -fx-border-color: #27ae60; -fx-border-width: 0 0 0 5;
                             -fx-border-radius: 2; -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <VBox spacing="3">
                        <Label text="Quantite Totale"
                               style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                        <Label fx:id="lblQuantiteTotal" text="0"
                               style="-fx-font-size: 38px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </VBox>
                </HBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>
