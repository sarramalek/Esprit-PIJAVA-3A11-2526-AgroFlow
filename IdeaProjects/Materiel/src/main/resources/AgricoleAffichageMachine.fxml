<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="805.0" prefWidth="1520.0"
            style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AgricoleAffichageMachineController">

    <!-- ══════════════════════════════════════════════ -->
    <!-- SIDEBAR AGRICOLE (vert)                        -->
    <!-- ══════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: linear-gradient(to bottom, #2E7D32, #388E3C, #43A047);">
            <padding><Insets bottom="20" top="20" /></padding>

            <!-- Logo -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 0 0 20 0;">
                <Label style="-fx-font-size: 32px;" text="🌱" />
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;"
                           text="AgroFlow">
                        <font><Font name="System Bold" size="26" /></font>
                    </Label>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"
                           text="Mon Exploitation">
                        <font><Font name="System" size="11" /></font>
                    </Label>
                </VBox>
            </HBox>

            <!-- Info Utilisateur -->
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15;
                         -fx-padding: 20;">
                <Label style="-fx-font-size: 30px;" text="👨‍🌾" />
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"
                       text="Agriculteur">
                    <font><Font name="System Bold" size="16" /></font>
                </Label>
                <Label style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);
                              -fx-background-color: rgba(76,175,80,0.3); -fx-padding: 4 12;
                              -fx-background-radius: 15;" text="🌾 AGRICULTEUR">
                    <font><Font name="System Bold" size="12" /></font>
                </Label>
            </VBox>

            <!-- Navigation -->
            <VBox spacing="8" style="-fx-padding: 20 0 0 0;">

                <Button onAction="#handleDashboard" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1;
                               -fx-border-radius: 12;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <Button onAction="#handleMesTerrains" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1;
                               -fx-border-radius: 12;"
                        text="🌾  Mes Terrains">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <Button onAction="#handleMesPlantes" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1;
                               -fx-border-radius: 12;"
                        text="🌱  Mes Plantes">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <Button onAction="#handleMesAnimaux" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1;
                               -fx-border-radius: 12;"
                        text="🐄  Mes Animaux">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <Button onAction="#handleMesStocks" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1;
                               -fx-border-radius: 12;"
                        text="📦  Mes Stocks">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- Actif -->
                <Button prefHeight="48" prefWidth="230"
                        style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049);
                               -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 6, 0, 0, 2);"
                        text="🚜  Mon Matériel">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <Button onAction="#handleMesMaintenances" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1;
                               -fx-border-radius: 12;"
                        text="🔧  Mes Maintenances">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <Button onAction="#naviguerEvenements" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1;
                               -fx-border-radius: 12;"
                        text="📅  Événements">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout -->
            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                           -fx-background-radius: 12; -fx-cursor: hand;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>

    <!-- ══════════════════════════════════════════════ -->
    <!-- CONTENU PRINCIPAL                              -->
    <!-- ══════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #F8F9FA; -fx-border-color: transparent;">
            <VBox spacing="25" style="-fx-background-color: #F8F9FA;">
                <padding><Insets bottom="35" left="35" right="35" top="35" /></padding>

                <!-- ── TOP BAR ── -->
                <HBox alignment="CENTER_LEFT" spacing="15"
                      style="-fx-background-color: white; -fx-background-radius: 15;
                             -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">

                    <Button onAction="#versAccueil"
                            style="-fx-background-color: #EAF5EA; -fx-text-fill: #2D5A27;
                                   -fx-cursor: hand; -fx-background-radius: 20; -fx-font-size: 12px;
                                   -fx-font-weight: bold; -fx-padding: 9 20;
                                   -fx-border-color: #A8C69F; -fx-border-radius: 20;"
                            text="⬅  Retour Accueil">
                        <font><Font name="System Bold" size="12" /></font>
                    </Button>

                    <Region HBox.hgrow="ALWAYS" />

                    <VBox spacing="4" alignment="CENTER">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"
                               text="🚜  Mon Matériel Agricole">
                            <font><Font name="System Bold" size="24" /></font>
                        </Label>
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D;"
                               text="Consultez et analysez vos machines agricoles" />
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <Button onAction="#afficherStatistiquesAvancees"
                            style="-fx-background-color: linear-gradient(to right, #1565C0, #1976D2);
                                   -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 20;
                                   -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 9 20;
                                   -fx-effect: dropshadow(gaussian, rgba(21,101,192,0.4), 6, 0, 0, 2);"
                            text="🏭  Analyse Avancée">
                        <font><Font name="System Bold" size="12" /></font>
                    </Button>

                    <Button onAction="#afficherStatistiquesGraphiques"
                            style="-fx-background-color: linear-gradient(to right, #4A235A, #7D3C98);
                                   -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 20;
                                   -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 9 20;
                                   -fx-effect: dropshadow(gaussian, rgba(74,35,90,0.4), 6, 0, 0, 2);"
                            text="📊  Stats Graphiques">
                        <font><Font name="System Bold" size="12" /></font>
                    </Button>

                    <Label style="-fx-font-size: 26px;
                                  -fx-background-color: linear-gradient(to bottom right, #4CAF50, #388E3C);
                                  -fx-text-fill: white; -fx-padding: 14; -fx-background-radius: 50%;
                                  -fx-min-width: 54; -fx-min-height: 54; -fx-alignment: center;"
                           text="🚜" />
                </HBox>

                <!-- ── LISTE MACHINES ── -->
                <VBox spacing="15"
                      style="-fx-background-color: white; -fx-background-radius: 15;
                             -fx-padding: 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                               text="🚜  Mes Machines">
                            <font><Font name="System Bold" size="20" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblSelectionInfo"
                               style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;
                                      -fx-font-style: italic;"
                               text="Cliquez sur une ligne pour voir les détails" />
                    </HBox>

                    <!-- ── BARRE RECHERCHE + FILTRES ── -->
                    <VBox spacing="10"
                          style="-fx-background-color: #EAF5EA; -fx-padding: 14;
                                 -fx-background-radius: 12; -fx-border-color: #A8C69F;
                                 -fx-border-radius: 12; -fx-border-width: 1;">

                        <!-- Ligne 1 : Recherche -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold;
                                          -fx-text-fill: #2D5A27;" text="🔍 Recherche :">
                                <font><Font name="System Bold" size="13" /></font>
                            </Label>
                            <TextField fx:id="champRecherche"
                                       promptText="Nom, marque, modèle, état, numéro de série..."
                                       prefHeight="38" prefWidth="360"
                                       onKeyReleased="#rechercher"
                                       style="-fx-background-color: white;
                                              -fx-border-color: #A8C69F;
                                              -fx-border-radius: 20; -fx-background-radius: 20;
                                              -fx-font-size: 13px; -fx-padding: 0 15;" />
                            <Button onAction="#effacerRecherche" prefHeight="38"
                                    style="-fx-background-color: white; -fx-text-fill: #2D5A27;
                                           -fx-cursor: hand; -fx-background-radius: 20;
                                           -fx-border-color: #A8C69F; -fx-border-radius: 20;
                                           -fx-font-size: 12px; -fx-padding: 0 16;"
                                    text="↺  Reset">
                                <font><Font name="System" size="12" /></font>
                            </Button>
                            <Button onAction="#actualiser" prefHeight="38"
                                    style="-fx-background-color: #27AE60; -fx-text-fill: white;
                                           -fx-cursor: hand; -fx-background-radius: 20;
                                           -fx-font-size: 12px; -fx-font-weight: bold;
                                           -fx-padding: 0 16;"
                                    text="🔄 Actualiser">
                                <font><Font name="System Bold" size="12" /></font>
                            </Button>
                        </HBox>

                        <!-- Ligne 2 : Filtres + Tri -->
                        <HBox spacing="10" alignment="CENTER_LEFT">

                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold;
                                          -fx-text-fill: #2D5A27;" text="⚙ État :">
                                <font><Font name="System Bold" size="12" /></font>
                            </Label>
                            <ComboBox fx:id="comboEtat" promptText="Tous les états"
                                      prefWidth="160" prefHeight="36"
                                      onAction="#filtrer"
                                      style="-fx-background-radius: 10; -fx-font-size: 12px;
                                             -fx-background-color: white;
                                             -fx-border-color: #A8C69F; -fx-border-radius: 10;" />

                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold;
                                          -fx-text-fill: #2D5A27;" text="🏷 Marque :">
                                <font><Font name="System Bold" size="12" /></font>
                            </Label>
                            <ComboBox fx:id="comboMarque" promptText="Toutes les marques"
                                      prefWidth="170" prefHeight="36"
                                      onAction="#filtrer"
                                      style="-fx-background-radius: 10; -fx-font-size: 12px;
                                             -fx-background-color: white;
                                             -fx-border-color: #A8C69F; -fx-border-radius: 10;" />

                            <Button onAction="#reinitialiserFiltres" prefHeight="36"
                                    style="-fx-background-color: #7F8C8D; -fx-text-fill: white;
                                           -fx-font-size: 12px; -fx-font-weight: bold;
                                           -fx-background-radius: 20; -fx-cursor: hand;
                                           -fx-padding: 0 14;"
                                    text="↺ Réinit.">
                                <font><Font name="System Bold" size="12" /></font>
                            </Button>

                            <Region HBox.hgrow="ALWAYS" />

                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold;
                                          -fx-text-fill: #2D5A27;" text="📅 Trier :">
                                <font><Font name="System Bold" size="12" /></font>
                            </Label>
                            <Button onAction="#trierNomAZ" prefHeight="36"
                                    style="-fx-background-color: #2980b9; -fx-text-fill: white;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-background-radius: 20; -fx-cursor: hand;
                                           -fx-padding: 0 12;"
                                    text="🔠 Nom A→Z">
                                <font><Font name="System Bold" size="11" /></font>
                            </Button>
                            <Button onAction="#trierNomZA" prefHeight="36"
                                    style="-fx-background-color: #7F8C8D; -fx-text-fill: white;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-background-radius: 20; -fx-cursor: hand;
                                           -fx-padding: 0 12;"
                                    text="🔠 Nom Z→A">
                                <font><Font name="System Bold" size="11" /></font>
                            </Button>
                            <Button onAction="#trierDateRecent" prefHeight="36"
                                    style="-fx-background-color: #27AE60; -fx-text-fill: white;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-background-radius: 20; -fx-cursor: hand;
                                           -fx-padding: 0 12;"
                                    text="📅 Récent">
                                <font><Font name="System Bold" size="11" /></font>
                            </Button>
                            <Button onAction="#trierDateAncien" prefHeight="36"
                                    style="-fx-background-color: #E74C3C; -fx-text-fill: white;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-background-radius: 20; -fx-cursor: hand;
                                           -fx-padding: 0 12;"
                                    text="📅 Ancien">
                                <font><Font name="System Bold" size="11" /></font>
                            </Button>
                            <Button onAction="#trierMarqueAZ" prefHeight="36"
                                    style="-fx-background-color: #8E44AD; -fx-text-fill: white;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-background-radius: 20; -fx-cursor: hand;
                                           -fx-padding: 0 12;"
                                    text="🏷 Marque A→Z">
                                <font><Font name="System Bold" size="11" /></font>
                            </Button>
                        </HBox>
                    </VBox>

                    <!-- ── TABLEAU LECTURE SEULE ── -->
                    <TableView fx:id="tableMachines" VBox.vgrow="ALWAYS" prefHeight="380"
                               style="-fx-background-color: white; -fx-border-color: #A8C69F;
                                      -fx-border-width: 1; -fx-border-radius: 12;
                                      -fx-background-radius: 12;">
                        <columns>
                            <TableColumn fx:id="colNom"          text="Nom"            prefWidth="160" minWidth="120"/>
                            <TableColumn fx:id="colMarque"       text="Marque"         prefWidth="130" minWidth="100"/>
                            <TableColumn fx:id="colModele"       text="Modèle"         prefWidth="130" minWidth="100"/>
                            <TableColumn fx:id="colEtat"         text="État"           prefWidth="120" minWidth="90"/>
                            <TableColumn fx:id="colNumeroSerie"  text="N° Série"       prefWidth="150" minWidth="110"/>
                            <TableColumn fx:id="colDateAchat"    text="Date d'achat"   prefWidth="130" minWidth="100"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucune machine trouvée pour ces critères."
                                   style="-fx-text-fill: #A8C69F; -fx-font-style: italic;
                                          -fx-font-size: 14px; -fx-padding: 40;" />
                        </placeholder>
                    </TableView>

                    <!-- ── CARTES STATISTIQUES BAS ── -->
                    <HBox spacing="12" alignment="CENTER">

                        <VBox alignment="CENTER" spacing="4" prefHeight="85"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"
                              style="-fx-background-color: white; -fx-padding: 12 10;
                                     -fx-border-color: #3498db; -fx-border-width: 0 0 0 5;
                                     -fx-background-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #7F8C8D;
                                          -fx-font-weight: bold;" text="🚜 Total Machines" />
                            <Label fx:id="lblTotal" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold;
                                          -fx-text-fill: #3498db;">
                                <font><Font name="System Bold" size="28" /></font>
                            </Label>
                            <Label fx:id="lblTotalFiltre" text="affiché(s)"
                                   style="-fx-font-size: 11px; -fx-text-fill: #3498db;" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="4" prefHeight="85"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"
                              style="-fx-background-color: white; -fx-padding: 12 10;
                                     -fx-border-color: #27ae60; -fx-border-width: 0 0 0 5;
                                     -fx-background-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #7F8C8D;
                                          -fx-font-weight: bold;" text="✅ En bon état" />
                            <Label fx:id="lblNbBonEtat" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold;
                                          -fx-text-fill: #27ae60;">
                                <font><Font name="System Bold" size="28" /></font>
                            </Label>
                            <Label fx:id="lblPctBonEtat" text="—"
                                   style="-fx-font-size: 11px; -fx-text-fill: #27ae60;" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="4" prefHeight="85"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"
                              style="-fx-background-color: white; -fx-padding: 12 10;
                                     -fx-border-color: #f39c12; -fx-border-width: 0 0 0 5;
                                     -fx-background-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #7F8C8D;
                                          -fx-font-weight: bold;" text="🔧 En maintenance" />
                            <Label fx:id="lblNbMaintenance" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold;
                                          -fx-text-fill: #f39c12;">
                                <font><Font name="System Bold" size="28" /></font>
                            </Label>
                            <Label fx:id="lblPctMaintenance" text="—"
                                   style="-fx-font-size: 11px; -fx-text-fill: #f39c12;" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="4" prefHeight="85"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"
                              style="-fx-background-color: white; -fx-padding: 12 10;
                                     -fx-border-color: #e74c3c; -fx-border-width: 0 0 0 5;
                                     -fx-background-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #7F8C8D;
                                          -fx-font-weight: bold;" text="❌ Hors service" />
                            <Label fx:id="lblNbHorsService" text="0"
                                   style="-fx-font-size: 28px; -fx-font-weight: bold;
                                          -fx-text-fill: #e74c3c;">
                                <font><Font name="System Bold" size="28" /></font>
                            </Label>
                            <Label fx:id="lblPctHorsService" text="—"
                                   style="-fx-font-size: 11px; -fx-text-fill: #e74c3c;" />
                        </VBox>

                        <VBox alignment="CENTER" spacing="4" prefHeight="85"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"
                              style="-fx-background-color: white; -fx-padding: 12 10;
                                     -fx-border-color: #9b59b6; -fx-border-width: 0 0 0 5;
                                     -fx-background-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #7F8C8D;
                                          -fx-font-weight: bold;" text="🏷 Marque Dominante" />
                            <Label fx:id="lblMarqueDominante" text="—"
                                   style="-fx-font-size: 14px; -fx-font-weight: bold;
                                          -fx-text-fill: #9b59b6;">
                                <font><Font name="System Bold" size="14" /></font>
