<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Events.AfficherCategoriesController">

    <!-- Sidebar Navigation -->
    <left>
        <VBox prefWidth="230.0" spacing="10.0" style="-fx-background-color: #2C3E50; -fx-padding: 15;">
            <children>
                <Text fill="WHITE" text="AGROFLOW">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Text>

                <Separator opacity="0.2" />

                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="🐾 Gestion Animaux" />

                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="⚙️ Gestion Matériels" />

                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="📦 Gestion Stocks" />

                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="🌱 Gestion Terrains" />

                <Button maxWidth="Infinity" onAction="#goToAccueil" style="-fx-background-color: #2D5A27; -fx-text-fill: white;" text="📅 Événements" />

                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="👥 Utilisateurs" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator opacity="0.1" />
                <Button maxWidth="Infinity" style="-fx-background-color: #E74C3C; -fx-text-fill: white;" text="Déconnexion" />
            </children>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <VBox spacing="20" style="-fx-background-color: #fcf8e6;">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <!-- Top Bar -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Gestion des Catégories">
                        <font>
                            <Font name="System Bold" size="28" />
                        </font>
                    </Label>
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;" text="Organisez et suivez les catégories">
                        <font>
                            <Font name="System" size="14" />
                        </font>
                    </Label>
                </VBox>

                <!-- User Profile & Add Button -->
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="addTaskBtn" onAction="#handleAddCategorie" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="➕ Nouvelle catégorie">
                        <font>
                            <Font name="System" size="14" />
                        </font>
                    </Button>
                    <Label fx:id="userNameLabel" style="-fx-font-size: 14px; -fx-text-fill: #2C3E50;" text="Admin">
                        <font>
                            <Font name="System" size="14" />
                        </font>
                    </Label>
                    <Label style="-fx-font-size: 24px; -fx-background-color: #ECF0F1; -fx-padding: 8; -fx-background-radius: 50%; -fx-cursor: hand;" text="👤" />
                </HBox>
            </HBox>

            <!-- Liste des Tâches -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="25" left="25" right="25" top="25" />
                </padding>

                <!-- Card Header -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Liste des Catégories">
                        <font>
                            <Font name="System Bold" size="20" />
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Table -->
                <TableView fx:id="tasksTable" minHeight="350.0" prefHeight="400.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="titleColumn" prefWidth="300" style="-fx-alignment: CENTER-LEFT;" text="Nom" />
                        <TableColumn fx:id="descriptionColumn" prefWidth="380" style="-fx-alignment: CENTER-LEFT;" text="Description" />
                        <TableColumn fx:id="actionsColumn" prefWidth="200" style="-fx-alignment: CENTER;" text="Actions" />
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>
