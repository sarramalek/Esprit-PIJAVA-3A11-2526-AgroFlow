<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="900" prefWidth="1800" style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AfficherParticipationsController">

    <left>
        <VBox prefWidth="230.0" spacing="10.0" style="-fx-background-color: #2C3E50; -fx-padding: 15;">
            <children>
                <Text fill="WHITE" text="AGROFLOW"><font><Font name="System Bold" size="24.0"/></font></Text>
                <Separator opacity="0.2"/>
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="🐾 Gestion Animaux"/>
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="⚙️ Gestion Matériels"/>
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="📦 Gestion Stocks"/>
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="🌱 Gestion Terrains"/>
                <Button maxWidth="Infinity" style="-fx-background-color: #2D5A27; -fx-text-fill: white;" text="📅 Événements" onAction="#goToAccueil"/>
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="👥 Utilisateurs"/>
                <Region VBox.vgrow="ALWAYS"/>
                <Separator opacity="0.1"/>
                <Button maxWidth="Infinity" style="-fx-background-color: #E74C3C; -fx-text-fill: white;" text="Déconnexion"/>
            </children>
        </VBox>
    </left>

    <center>
        <VBox spacing="20">
            <padding><Insets bottom="30" left="30" right="30" top="30"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Gestion des Participations"><font><Font name="System Bold" size="28"/></font></Label>
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;" text="Suivez les inscriptions aux événements"><font><Font name="System" size="14"/></font></Label>
                </VBox>
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="addParticipationBtn" onAction="#handleAddParticipation"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"
                            text="➕ Nouvelle participation"><font><Font name="System" size="14"/></font></Button>
                    <Label fx:id="userNameLabel" style="-fx-font-size: 14px; -fx-text-fill: #2C3E50;" text="Admin"><font><Font name="System" size="14"/></font></Label>
                    <Label style="-fx-font-size: 24px; -fx-background-color: #ECF0F1; -fx-padding: 8; -fx-background-radius: 50%; -fx-cursor: hand;" text="👤"/>
                </HBox>
            </HBox>

            <!-- Filtres -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 20;">
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;" text="RECHERCHER"><font><Font name="System Bold" size="12"/></font></Label>
                        <TextField fx:id="searchField" prefWidth="400" promptText="🔍 Rechercher par nom d'événement..."
                                   style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14px;">
                            <font><Font name="System" size="14"/></font>
                        </TextField>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox spacing="8" alignment="BOTTOM_CENTER">
                        <Button onAction="#handleRefresh" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="🔄 Actualiser">
                            <font><Font name="System" size="14"/></font>
                        </Button>
                    </VBox>
                </HBox>
                <Separator/>
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;" text="FILTRES :"><font><Font name="System Bold" size="12"/></font></Label>
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Date d'inscription"/>
                        <DatePicker fx:id="filterDate" prefWidth="165" promptText="Sélectionner..." style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Statut"/>
                        <ComboBox fx:id="filterStatut" prefWidth="165" promptText="Tous les statuts" style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;"/>
                    </VBox>
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Présence"/>
                        <ComboBox fx:id="filterPresence" prefWidth="140" promptText="Toutes" style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;"/>
                    </VBox>
                    <!-- NOUVEAU : Filtre ID User -->
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="ID Utilisateur"/>
                        <TextField fx:id="filterIdUser" prefWidth="130" promptText="Ex: 42"
                                   style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-padding: 6 10; -fx-font-size: 12px;"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <VBox spacing="8" alignment="BOTTOM_CENTER">
                        <Button onAction="#handleResetFilters" style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15; -fx-background-radius: 6; -fx-cursor: hand;" text="✕ Réinitialiser">
                            <font><Font name="System" size="12"/></font>
                        </Button>
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="resultsCountLabel" style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D; -fx-font-style: italic;" text="0 participation(s) trouvée(s)">
                        <font><Font name="System Italic" size="13"/></font>
                    </Label>
                </HBox>
            </VBox>

            <!-- Tableau -->
            <!-- Largeur utile = 1800 - 230 - 60 = 1510px -->
            <!-- Colonnes : Événement(380) ID User(130) Date(190) Statut(170) Présence(150) Actions(290) = 1310 + marges -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
                <padding><Insets bottom="25" left="25" right="25" top="25"/></padding>
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Liste des Participations"><font><Font name="System Bold" size="20"/></font></Label>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>
                <TableView fx:id="participationsTable" minHeight="350.0" prefHeight="400.0"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;"
                           VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="evenementColumn"       prefWidth="380" minWidth="250" style="-fx-alignment: CENTER-LEFT;" text="Événement"/>
                        <TableColumn fx:id="idUserColumn"          prefWidth="130" minWidth="100" style="-fx-alignment: CENTER;"      text="ID Utilisateur"/>
                        <TableColumn fx:id="dateInscriptionColumn" prefWidth="190" minWidth="140" style="-fx-alignment: CENTER;"      text="Date Inscription"/>
                        <TableColumn fx:id="statutColumn"          prefWidth="170" minWidth="120" style="-fx-alignment: CENTER;"      text="Statut"/>
                        <TableColumn fx:id="presenceColumn"        prefWidth="150" minWidth="110" style="-fx-alignment: CENTER;"      text="Présence"/>
                        <TableColumn fx:id="actionsColumn"         prefWidth="290" minWidth="200" style="-fx-alignment: CENTER;"      text="Actions"/>
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </center>
</BorderPane>
