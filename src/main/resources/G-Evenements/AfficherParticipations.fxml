<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="900" prefWidth="1800" style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AfficherParticipationsController">

    <!-- Sidebar Navigation -->
    <left>
        <VBox prefWidth="230.0" spacing="10.0" style="-fx-background-color: #2C3E50; -fx-padding: 15;">
            <children>
                <Text fill="WHITE" text="AGROFLOW">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Text>

                <Separator opacity="0.2" />

                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="🐾 Gestion Animaux" />
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="⚙️ Gestion Matériels" />
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="📦 Gestion Stocks" />
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="🌱 Gestion Terrains" />
                <Button maxWidth="Infinity" style="-fx-background-color: #2D5A27; -fx-text-fill: white;" text="📅 Événements" onAction="#goToAccueil" />
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="👥 Utilisateurs" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator opacity="0.1" />
                <Button maxWidth="Infinity" style="-fx-background-color: #E74C3C; -fx-text-fill: white;" text="Déconnexion" />
            </children>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <!-- Top Bar -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Gestion des Participations">
                        <font>
                            <Font name="System Bold" size="28" />
                        </font>
                    </Label>
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;" text="Suivez les inscriptions aux événements">
                        <font>
                            <Font name="System" size="14" />
                        </font>
                    </Label>
                </VBox>

                <!-- User Profile & Add Button -->
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="addParticipationBtn" onAction="#handleAddParticipation"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"
                            text="➕ Nouvelle participation">
                        <font>
                            <Font name="System" size="14" />
                        </font>
                    </Button>
                    <Label fx:id="userNameLabel" style="-fx-font-size: 14px; -fx-text-fill: #2C3E50;" text="Admin">
                        <font>
                            <Font name="System" size="14" />
                        </font>
                    </Label>
                    <Label style="-fx-font-size: 24px; -fx-background-color: #ECF0F1; -fx-padding: 8; -fx-background-radius: 50%; -fx-cursor: hand;" text="👤" />
                </HBox>
            </HBox>

            <!-- Barre de recherche et filtres -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 20;">

                <!-- Recherche -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;" text="RECHERCHER">
                            <font>
                                <Font name="System Bold" size="12" />
                            </font>
                        </Label>
                        <TextField fx:id="searchField"
                                   promptText="🔍 Rechercher par nom d'événement..."
                                   prefWidth="400"
                                   style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14px;">
                            <font>
                                <Font name="System" size="14" />
                            </font>
                        </TextField>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <VBox spacing="8" alignment="BOTTOM_CENTER">
                        <Button onAction="#handleRefresh"
                                style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🔄 Actualiser">
                            <font>
                                <Font name="System" size="14" />
                            </font>
                        </Button>
                    </VBox>
                </HBox>

                <Separator />

                <!-- Filtres -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;" text="FILTRES :">
                        <font>
                            <Font name="System Bold" size="12" />
                        </font>
                    </Label>

                    <!-- Filtre Date -->
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Date d'inscription">
                            <font>
                                <Font name="System" size="11" />
                            </font>
                        </Label>
                        <DatePicker fx:id="filterDate"
                                    promptText="Sélectionner une date..."
                                    prefWidth="150"
                                    style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;" />
                    </VBox>

                    <!-- Filtre Statut -->
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Statut">
                            <font>
                                <Font name="System" size="11" />
                            </font>
                        </Label>
                        <ComboBox fx:id="filterStatut"
                                  promptText="Tous les statuts"
                                  prefWidth="150"
                                  style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;" />
                    </VBox>

                    <!-- Filtre Présence -->
                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Présence">
                            <font>
                                <Font name="System" size="11" />
                            </font>
                        </Label>
                        <ComboBox fx:id="filterPresence"
                                  promptText="Toutes"
                                  prefWidth="120"
                                  style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;" />
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Bouton Réinitialiser -->
                    <VBox spacing="8" alignment="BOTTOM_CENTER">
                        <Button onAction="#handleResetFilters"
                                style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15; -fx-background-radius: 6; -fx-cursor: hand;"
                                text="✕ Réinitialiser">
                            <font>
                                <Font name="System" size="12" />
                            </font>
                        </Button>
                    </VBox>
                </HBox>

                <!-- Compteur de résultats -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label fx:id="resultsCountLabel"
                           style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D; -fx-font-style: italic;"
                           text="0 participation(s) trouvée(s)">
                        <font>
                            <Font name="System Italic" size="13" />
                        </font>
                    </Label>
                </HBox>
            </VBox>

            <!-- Liste des Participations -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="25" left="25" right="25" top="25" />
                </padding>

                <!-- Card Header -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Liste des Participations">
                        <font>
                            <Font name="System Bold" size="20" />
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <!-- Table -->
                <TableView fx:id="participationsTable" minHeight="350.0" prefHeight="400.0"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="evenementColumn" prefWidth="300" style="-fx-alignment: CENTER-LEFT;" text="Événement" />
                        <TableColumn fx:id="dateInscriptionColumn" prefWidth="150" style="-fx-alignment: CENTER;" text="Date Inscription" />
                        <TableColumn fx:id="statutColumn" prefWidth="120" style="-fx-alignment: CENTER;" text="Statut" />
                        <TableColumn fx:id="presenceColumn" prefWidth="100" style="-fx-alignment: CENTER;" text="Présence" />
                        <TableColumn fx:id="actionsColumn" prefWidth="180" style="-fx-alignment: CENTER;" text="Actions" />
                    </columns>
                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>
