<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="800.0" prefWidth="1200.0"
            style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Events.ModifierEvenementController">

    <!-- Sidebar Navigation -->
    <left>
        <VBox prefWidth="230.0" spacing="10.0" style="-fx-background-color: #2C3E50; -fx-padding: 15;">
            <children>
                <Text fill="WHITE" text="AGROFLOW">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Text>

                <Separator opacity="0.2" />

                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="🐾 Gestion Animaux" />
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="⚙️ Gestion Matériels" />
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="📦 Gestion Stocks" />
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="🌱 Gestion Terrains" />
                <Button maxWidth="Infinity" style="-fx-background-color: #2D5A27; -fx-text-fill: white;" text="📅 Événements" onAction="#goToAccueil" />
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="👥 Utilisateurs" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator opacity="0.1" />
                <Button maxWidth="Infinity" style="-fx-background-color: #E74C3C; -fx-text-fill: white;" text="Déconnexion" />
            </children>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox spacing="30" style="-fx-background-color: #F5F7FA;" alignment="TOP_CENTER">
                    <padding>
                        <Insets bottom="40" left="40" right="40" top="40" />
                    </padding>

                    <!-- Header -->
                    <VBox spacing="8" alignment="CENTER">
                        <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                               text="Modifier l'Événement">
                            <font>
                                <Font name="System Bold" size="32" />
                            </font>
                        </Label>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;"
                               text="Mettez à jour les informations de l'événement">
                            <font>
                                <Font name="System" size="14" />
                            </font>
                        </Label>
                    </VBox>

                    <!-- Form Card -->
                    <VBox spacing="25"
                          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                          maxWidth="700" alignment="TOP_LEFT">

                        <!-- ID (caché) -->
                        <TextField fx:id="tfId" visible="false" managed="false" />

                        <!-- Info label -->
                        <HBox spacing="10" alignment="CENTER_LEFT"
                              style="-fx-background-color: #E8F4F8; -fx-padding: 12; -fx-background-radius: 6;">
                            <Label text="ℹ️" style="-fx-font-size: 16px;" />
                            <Label fx:id="infoLabel"
                                   text="Modifiez les champs ci-dessous et cliquez sur Enregistrer"
                                   style="-fx-text-fill: #2980B9; -fx-font-size: 13px;"
                                   wrapText="true"
                                   HBox.hgrow="ALWAYS">
                                <font>
                                    <Font name="System" size="13" />
                                </font>
                            </Label>
                        </HBox>

                        <!-- Titre -->
                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                                   text="Titre de l'événement *">
                                <font>
                                    <Font name="System Bold" size="14" />
                                </font>
                            </Label>
                            <TextField fx:id="tfTitre"
                                       promptText="Ex: Formation sur l'irrigation"
                                       prefHeight="40"
                                       style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14px;">
                                <font>
                                    <Font name="System" size="14" />
                                </font>
                            </TextField>
                        </VBox>

                        <!-- Description -->
                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                                   text="Description *">
                                <font>
                                    <Font name="System Bold" size="14" />
                                </font>
                            </Label>
                            <TextArea fx:id="taDescription"
                                      promptText="Décrivez l'événement en détail..."
                                      prefHeight="100"
                                      wrapText="true"
                                      style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14px;">
                                <font>
                                    <Font name="System" size="14" />
                                </font>
                            </TextArea>
                        </VBox>

                        <!-- Type d'événement -->
                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                                   text="Type d'événement *">
                                <font>
                                    <Font name="System Bold" size="14" />
                                </font>
                            </Label>
                            <ComboBox fx:id="cbTypeEvenement"
                                      promptText="Sélectionnez un type..."
                                      prefWidth="Infinity"
                                      prefHeight="40"
                                      style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />
                        </VBox>

                        <!-- Dates -->
                        <HBox spacing="20">
                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                                       text="Date de début *">
                                    <font>
                                        <Font name="System Bold" size="14" />
                                    </font>
                                </Label>
                                <DatePicker fx:id="dpDateDebut"
                                            promptText="JJ/MM/AAAA"
                                            prefHeight="40"
                                            style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />
                            </VBox>

                            <VBox spacing="8" HBox.hgrow="ALWAYS">
                                <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                                       text="Date de fin *">
                                    <font>
                                        <Font name="System Bold" size="14" />
                                    </font>
                                </Label>
                                <DatePicker fx:id="dpDateFin"
                                            promptText="JJ/MM/AAAA"
                                            prefHeight="40"
                                            style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />
                            </VBox>
                        </HBox>

                        <!-- Lieu -->
                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                                   text="Lieu *">
                                <font>
                                    <Font name="System Bold" size="14" />
                                </font>
                            </Label>
                            <TextField fx:id="tfLieu"
                                       promptText="Ex: Ferme principale, Salle de réunion..."
                                       prefHeight="40"
                                       style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14px;">
                                <font>
                                    <Font name="System" size="14" />
                                </font>
                            </TextField>
                        </VBox>

                        <!-- Statut -->
                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                                   text="Statut *">
                                <font>
                                    <Font name="System Bold" size="14" />
                                </font>
                            </Label>
                            <ComboBox fx:id="cbStatut"
                                      promptText="Sélectionnez un statut..."
                                      prefWidth="Infinity"
                                      prefHeight="40"
                                      style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />
                        </VBox>

                        <!-- Catégorie -->
                        <VBox spacing="8">
                            <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                                   text="Catégorie *">
                                <font>
                                    <Font name="System Bold" size="14" />
                                </font>
                            </Label>
                            <ComboBox fx:id="cbCategorie"
                                      promptText="Sélectionnez une catégorie..."
                                      prefWidth="Infinity"
                                      prefHeight="40"
                                      style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />
                        </VBox>

                        <!-- Message d'erreur -->
                        <Label fx:id="errorLabel"
                               style="-fx-text-fill: #E74C3C; -fx-font-size: 13px; -fx-background-color: #FADBD8; -fx-padding: 10; -fx-background-radius: 6;"
                               visible="false"
                               wrapText="true">
                            <font>
                                <Font name="System" size="13" />
                            </font>
                        </Label>

                        <!-- Buttons -->
                        <HBox spacing="15" alignment="CENTER">
                            <Button text="💾 Enregistrer"
                                    onAction="#modifierEvenement"
                                    prefWidth="180"
                                    prefHeight="40"
                                    style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;">
                                <font>
                                    <Font name="System Bold" size="14" />
                                </font>
                            </Button>

                            <Button text="✕ Annuler"
                                    onAction="#retourEvenements"
                                    prefWidth="180"
                                    prefHeight="40"
                                    style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;">
                                <font>
                                    <Font name="System" size="14" />
                                </font>
                            </Button>
                        </HBox>

                        <!-- Info text -->
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #95A5A6; -fx-alignment: center;"
                               text="* Champs obligatoires"
                               alignment="CENTER">
                            <font>
                                <Font name="System Italic" size="12" />
                            </font>
                        </Label>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
