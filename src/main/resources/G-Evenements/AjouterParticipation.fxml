<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane prefHeight="700.0" prefWidth="1200.0"
            style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Events.AjouterParticipationController">

    <!-- SIDEBAR MODERNISÉE -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color:  #617e9c;">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Logo/Header MODERNE -->
            <StackPane prefWidth="100" prefHeight="100"  >
                <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                    <image><Image url="/style/logo.png"/></image>
                </ImageView>

            </StackPane>
            <padding>
                <Insets bottom="20" top="20" />
            </padding>
            <!-- Navigation Menu MODERNISÉE -->
            <VBox spacing="10">
                <!-- Dashboard -->
                <Button fx:id="dashboardBtn" onMouseClicked="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- GESTION PRINCIPALE avec sous-menu -->
                <VBox fx:id="gestionContainer" prefWidth="230" spacing="5" style="-fx-background-radius: 12;">
                    <Button fx:id="gestionBtn"  prefHeight="50" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"
                            text="⚙️  Gestion Utilisateurs">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                    <!-- Sous-menu MODERNE -->
                    <VBox fx:id="gestionSubmenu" spacing="3" style="-fx-padding: 5 0 5 15; -fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 0 0 12 12;">
                        <Button fx:id="personnesBtn" onMouseClicked="#handlePersonnes" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"
                                text="👥  Personnes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="tachesBtn" onMouseClicked="#handleTaches" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="✓  Tâches">
                            <font><Font name="System" size="13" /></font>
                        </Button>

                        <Button fx:id="abonnementsBtn" onMouseClicked="#handleAbonnements" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="💳  Abonnements">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="offresBtn" onMouseClicked="#handleOffres" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🎁  Offres">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Autres boutons MODERNISÉS -->
                <Button fx:id="stocksBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleStocks"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="terrainsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleTerrains"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Terrains">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="animauxBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleAnimals"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Animaux">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="materielBtn" prefHeight="48" prefWidth="230 " onMouseClicked="#handleMateriels"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🔧  Matériel">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="evenementsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleEvents"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🎉  Événements">
                    <font><Font name="System" size="14" /></font>
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout Button MODERNISÉ -->
            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>
    <!-- Main Content Area -->
    <center>
        <VBox spacing="30" alignment="TOP_CENTER">
            <padding>
                <Insets bottom="40" left="40" right="40" top="40" />
            </padding>

            <!-- Header -->
            <VBox spacing="8" alignment="CENTER">
                <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                       text="Ajouter une Participation">
                    <font>
                        <Font name="System Bold" size="32" />
                    </font>
                </Label>
                <Label style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;"
                       text="Inscrivez un participant à un événement">
                    <font>
                        <Font name="System" size="14" />
                    </font>
                </Label>
            </VBox>

            <!-- Form Card -->
            <VBox spacing="25"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);"
                  maxWidth="600" alignment="TOP_LEFT">

                <!-- Événement -->
                <VBox spacing="8">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                           text="Événement *">
                        <font>
                            <Font name="System Bold" size="14" />
                        </font>
                    </Label>
                    <ComboBox fx:id="cbEvenement"
                              promptText="Sélectionnez un événement..."
                              prefWidth="Infinity"
                              prefHeight="40"
                              style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />
                </VBox>

                <!-- Date d'inscription -->
                <VBox spacing="8">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                           text="Date d'inscription *">
                        <font>
                            <Font name="System Bold" size="14" />
                        </font>
                    </Label>
                    <DatePicker fx:id="dpDateInscription"
                                promptText="JJ/MM/AAAA"
                                prefHeight="40"
                                style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />
                </VBox>

                <!-- Statut -->
                <VBox spacing="8">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                           text="Statut *">
                        <font>
                            <Font name="System Bold" size="14" />
                        </font>
                    </Label>
                    <ComboBox fx:id="cbStatut"
                              promptText="Sélectionnez un statut..."
                              prefWidth="Infinity"
                              prefHeight="40"
                              style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />
                </VBox>

                <!-- Présence -->
                <VBox spacing="8">
                    <Label style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                           text="Présence *">
                        <font>
                            <Font name="System Bold" size="14" />
                        </font>
                    </Label>
                    <ComboBox fx:id="cbPresence"
                              promptText="Le participant sera-t-il présent ?"
                              prefWidth="Infinity"
                              prefHeight="40"
                              style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />
                </VBox>

                <!-- Message d'erreur -->
                <Label fx:id="errorLabel"
                       style="-fx-text-fill: #E74C3C; -fx-font-size: 13px; -fx-background-color: #FADBD8; -fx-padding: 10; -fx-background-radius: 6;"
                       visible="false"
                       wrapText="true">
                    <font>
                        <Font name="System" size="13" />
                    </font>
                </Label>

                <!-- Buttons -->
                <HBox spacing="15" alignment="CENTER">
                    <Button text="✓ Enregistrer"
                            onAction="#ajouterParticipation"
                            prefWidth="180"
                            prefHeight="40"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand; -fx-font-weight: bold;">
                        <font>
                            <Font name="System Bold" size="14" />
                        </font>
                    </Button>

                    <Button text="✕ Annuler"
                            onAction="#retourParticipations"
                            prefWidth="180"
                            prefHeight="40"
                            style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-size: 14px; -fx-background-radius: 8; -fx-cursor: hand;">
                        <font>
                            <Font name="System" size="14" />
                        </font>
                    </Button>
                </HBox>

                <!-- Info text -->
                <Label style="-fx-font-size: 12px; -fx-text-fill: #95A5A6; -fx-alignment: center;"
                       text="* Champs obligatoires"
                       alignment="CENTER">
                    <font>
                        <Font name="System Italic" size="12" />
                    </font>
                </Label>
            </VBox>

        </VBox>
    </center>

</BorderPane>
