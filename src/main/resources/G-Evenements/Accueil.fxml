<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>

<BorderPane prefHeight="900" prefWidth="1800"
            style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AccueilEvenementController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="230.0" spacing="10.0"
              style="-fx-background-color: #2C3E50; -fx-padding: 15;">
            <Text fill="WHITE" text="AGROFLOW">
                <font><Font name="System Bold" size="24.0"/></font>
            </Text>
            <Separator opacity="0.2"/>
            <Button text="🐾 Gestion Animaux" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="⚙️ Gestion Matériels" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="📦 Gestion Stocks" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="🌱 Gestion Terrains" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Button text="📅 Événements" maxWidth="Infinity" style="-fx-background-color: #2D5A27; -fx-text-fill: white;"/>
            <Button text="👥 Utilisateurs" maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;"/>
            <Region VBox.vgrow="ALWAYS"/>
            <Separator opacity="0.1"/>
            <Button text="Déconnexion" maxWidth="Infinity" style="-fx-background-color: #E74C3C; -fx-text-fill: white;"/>
        </VBox>
    </left>

    <!-- CENTER -->
    <center>
        <VBox spacing="40" alignment="CENTER" style="-fx-padding: 60;">
            <Text text="Module Événements" fill="#2C3E50">
                <font><Font name="System Bold" size="36"/></font>
            </Text>
            <HBox spacing="60" alignment="CENTER">

                <VBox spacing="20" alignment="CENTER"
                      onMouseClicked="#ouvrirEvenements"
                      prefWidth="200" prefHeight="160"
                      style="-fx-background-color: white; -fx-padding: 30;
                             -fx-border-radius: 12; -fx-background-radius: 12;
                             -fx-cursor: hand;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Text text="📅" style="-fx-font-size: 56px;"/>
                    <Text text="Événements" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="20" alignment="CENTER"
                      onMouseClicked="#ouvrirCategories"
                      prefWidth="200" prefHeight="160"
                      style="-fx-background-color: white; -fx-padding: 30;
                             -fx-border-radius: 12; -fx-background-radius: 12;
                             -fx-cursor: hand;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Text text="🏷️" style="-fx-font-size: 56px;"/>
                    <Text text="Catégories" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                </VBox>

                <VBox spacing="20" alignment="CENTER"
                      onMouseClicked="#ouvrirParticipations"
                      prefWidth="200" prefHeight="160"
                      style="-fx-background-color: white; -fx-padding: 30;
                             -fx-border-radius: 12; -fx-background-radius: 12;
                             -fx-cursor: hand;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Text text="👥" style="-fx-font-size: 56px;"/>
                    <Text text="Participations" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                </VBox>

            </HBox>
        </VBox>
    </center>

</BorderPane>