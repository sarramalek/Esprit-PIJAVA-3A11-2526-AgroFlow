<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>
<BorderPane prefHeight="700.0" prefWidth="1200.0" style="-fx-background-color: #fcf8e6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Events.AfficherEvenementsController">

    <!-- SIDEBAR MODERNISÉE -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color:  #617e9c;">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Logo/Header MODERNE -->
            <StackPane prefWidth="100" prefHeight="100"  >
                <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                    <image><Image url="/style/logo.png"/></image>
                </ImageView>

            </StackPane>
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Navigation Menu MODERNISÉE -->
            <VBox spacing="10">
                <!-- Dashboard -->
                <Button fx:id="dashboardBtn" onMouseClicked="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- GESTION PRINCIPALE avec sous-menu -->
                <VBox fx:id="gestionContainer" prefWidth="230" spacing="5" style="-fx-background-radius: 12;">
                    <Button fx:id="gestionBtn"  prefHeight="50" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"
                            text="⚙️  Gestion Utilisateurs">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                    <!-- Sous-menu MODERNE -->
                    <VBox fx:id="gestionSubmenu" spacing="3" style="-fx-padding: 5 0 5 15; -fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 0 0 12 12;">
                        <Button fx:id="personnesBtn" onMouseClicked="#handlePersonnes" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"
                                text="👥  Personnes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="tachesBtn" onMouseClicked="#handleTaches" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="✓  Tâches">
                            <font><Font name="System" size="13" /></font>
                        </Button>

                        <Button fx:id="abonnementsBtn" onMouseClicked="#handleAbonnements" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="💳  Abonnements">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="offresBtn" onMouseClicked="#handleOffres" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🎁  Offres">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Autres boutons MODERNISÉS -->
                <Button fx:id="stocksBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleStocks"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="terrainsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleTerrains"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Terrains">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="animauxBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleAnimals"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Animaux">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="materielBtn" prefHeight="48" prefWidth="230 " onMouseClicked="#handleMateriels"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🔧  Matériel">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="evenementsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleEvents"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🎉  Événements">
                    <font><Font name="System" size="14" /></font>
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout Button MODERNISÉ -->
            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>
    <!-- Main Content Area -->
    <center>
        <ScrollPane>


        <VBox spacing="20">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <!-- Top Bar -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Gestion des Événements">
                        <font>
                            <Font name="System Bold" size="28" />
                        </font>
                    </Label>
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;" text="Organisez et suivez vos événements agricoles">
                        <font>
                            <Font name="System" size="14" />
                        </font>
                    </Label>
                </VBox>

                <!-- User Profile & Add Button -->
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="addEventBtn" onAction="#handleAddEvenement" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="➕ Nouvel événement">
                        <font>
                            <Font name="System" size="14" />
                        </font>
                    </Button>
                    <HBox alignment="CENTER" spacing="12" style="-fx-cursor: hand;" onMouseClicked="#handleMonProfil">
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label fx:id="userNameLabel" style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Admin">
                                <font><Font name="System Bold" size="15" /></font>
                            </Label>
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" text="Administrateur">
                                <font><Font name="System" size="11" /></font>
                            </Label>
                        </VBox>

                        <!-- Avatar circulaire : photo si disponible, sinon emoji 👤 -->
                        <StackPane>
                            <!-- Fond dégradé (visible si pas de photo) -->
                            <Circle fx:id="avatarBg" radius="24"
                                    fill="linear-gradient(to bottom right, #667eea, #764ba2)" />
                            <!-- Emoji par défaut -->
                            <Label fx:id="avatarDefaultLabel"
                                   style="-fx-font-size: 22px; -fx-text-fill: white;"
                                   text="👤" />
                            <!-- Photo chargée depuis Cloudinary (clip appliqué en Java) -->
                            <ImageView fx:id="avatarImageView"
                                       fitWidth="48" fitHeight="48"
                                       preserveRatio="false"
                                       visible="false" managed="false" />
                        </StackPane>
                    </HBox>
                </HBox>
            </HBox>

            <!-- Barre de recherche et filtres -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 20;">

                <!-- Recherche -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;" text="RECHERCHER">
                            <font>
                                <Font name="System Bold" size="12" />
                            </font>
                        </Label>
                        <TextField fx:id="searchField" prefWidth="400" promptText="🔍 Rechercher par titre d'événement..." style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14px;">
                            <font>
                                <Font name="System" size="14" />
                            </font>
                        </TextField>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <VBox alignment="BOTTOM_CENTER" spacing="8">
                        <Button onAction="#handleRefresh" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="🔄 Actualiser">
                            <font>
                                <Font name="System" size="14" />
                            </font>
                        </Button>
                    </VBox>
                </HBox>

                <Separator />

                <!-- Filtres -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;" text="FILTRES :">
                        <font>
                            <Font name="System Bold" size="12" />
                        </font>
                    </Label>

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Date début" />
                        <DatePicker fx:id="filterDateDebut" prefWidth="140" promptText="Sélectionner..." style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Date fin" />
                        <DatePicker fx:id="filterDateFin" prefWidth="140" promptText="Sélectionner..." style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Lieu" />
                        <TextField fx:id="filterLieu" prefWidth="150" promptText="Tous les lieux..." style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-padding: 8; -fx-font-size: 12px;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Statut" />
                        <ComboBox fx:id="filterStatut" prefWidth="140" promptText="Tous les statuts" style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Catégorie" />
                        <ComboBox fx:id="filterCategorie" prefWidth="140" promptText="Toutes" style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;" />
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Button onAction="#handleResetFilters" style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15; -fx-background-radius: 6; -fx-cursor: hand;" text="✕ Réinitialiser les filtres" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="resultsCountLabel" style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D; -fx-font-style: italic;" text="0 événement(s) trouvé(s)" />
                </HBox>
            </VBox>

            <!-- Liste des Événements -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="25" left="25" right="25" top="25" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Liste des Événements" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <TableView fx:id="eventsTable" minHeight="300.0" prefHeight="350.0" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="titreColumn" minWidth="180" prefWidth="250" style="-fx-alignment: CENTER-LEFT;" text="Titre" />
                        <TableColumn fx:id="typeColumn" minWidth="100" prefWidth="160" style="-fx-alignment: CENTER;" text="Type" />
                        <TableColumn fx:id="dateDebutColumn" minWidth="100" prefWidth="130" style="-fx-alignment: CENTER;" text="Début" />
                        <TableColumn fx:id="dateFinColumn" minWidth="100" prefWidth="130" style="-fx-alignment: CENTER;" text="Fin" />
                        <TableColumn fx:id="lieuColumn" minWidth="150" prefWidth="220" style="-fx-alignment: CENTER-LEFT;" text="Lieu" />
                        <TableColumn fx:id="categorieColumn" minWidth="130" prefWidth="220" style="-fx-alignment: CENTER;" text="Catégorie" />
                        <TableColumn fx:id="statutColumn" minWidth="100" prefWidth="130" style="-fx-alignment: CENTER;" text="Statut" />
                        <TableColumn fx:id="actionsColumn" minWidth="180" prefWidth="230" style="-fx-alignment: CENTER;" text="Actions" />
                    </columns>
                </TableView>
            </VBox>

            <!-- ✅ Barre d'outils inférieure avec les 3 boutons -->
            <HBox alignment="CENTER" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12;                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);                          -fx-padding: 15 25;">

                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;" text="🛠 Outils rapides :">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>

                <!-- Bouton 1 : Calendrier -->
                <Button onAction="#handleOpenGoogleCalendar" style="-fx-background-color: #DB4437; -fx-text-fill: white; -fx-font-size: 14px;                                -fx-padding: 12 28; -fx-background-radius: 10; -fx-cursor: hand;                                -fx-effect: dropshadow(gaussian, rgba(219,68,55,0.3), 6, 0, 0, 3);" text="📅 Ouvrir le Calendrier">
                    <font><Font name="System" size="14" /></font>
                </Button>

                <!-- Bouton 2 : Carte Tunisie ✅ NOUVEAU -->
                <Button fx:id="carteBtn" onAction="#handleOpenCarte" style="-fx-background-color: #1565C0; -fx-text-fill: white; -fx-font-size: 14px;                                -fx-padding: 12 28; -fx-background-radius: 10; -fx-cursor: hand;                                -fx-effect: dropshadow(gaussian, rgba(21,101,192,0.3), 6, 0, 0, 3);" text="🗺 Carte des événements">
                    <font><Font name="System" size="14" /></font>
                </Button>

                <!-- Bouton 3 : Générateur d'idées IA -->
                <Button fx:id="generateIdeasBtn" onAction="#handleGenerateIdeas" style="-fx-background-color: #8E44AD; -fx-text-fill: white; -fx-font-size: 14px;                                -fx-padding: 12 28; -fx-background-radius: 10; -fx-cursor: hand;                                -fx-effect: dropshadow(gaussian, rgba(142,68,173,0.3), 6, 0, 0, 3);" text="💡 Générer des idées d'événements">
                    <font><Font name="System" size="14" /></font>
                </Button>

            </HBox>

        </VBox>
        </ScrollPane>
    </center>

</BorderPane>
