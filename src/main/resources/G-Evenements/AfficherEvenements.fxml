<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AfficherEvenementsController">

    <!-- Sidebar Navigation -->
    <left>
        <VBox prefWidth="230.0" spacing="10.0" style="-fx-background-color: #2C3E50; -fx-padding: 15;">
            <children>
                <Text fill="WHITE" text="AGROFLOW">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Text>

                <Separator opacity="0.2" />

                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="🐾 Gestion Animaux" />
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="⚙️ Gestion Matériels" />
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="📦 Gestion Stocks" />
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="🌱 Gestion Terrains" />
                <Button maxWidth="Infinity" onAction="#goToAccueil" style="-fx-background-color: #2D5A27; -fx-text-fill: white;" text="📅 Événements" />
                <Button maxWidth="Infinity" style="-fx-background-color: transparent; -fx-text-fill: white;" text="👥 Utilisateurs" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator opacity="0.1" />
                <Button maxWidth="Infinity" style="-fx-background-color: #E74C3C; -fx-text-fill: white;" text="Déconnexion" />
            </children>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <!-- Top Bar -->
            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Gestion des Événements">
                        <font>
                            <Font name="System Bold" size="28" />
                        </font>
                    </Label>
                    <Label style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;" text="Organisez et suivez vos événements agricoles">
                        <font>
                            <Font name="System" size="14" />
                        </font>
                    </Label>
                </VBox>

                <!-- User Profile & Add Button -->
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="addEventBtn" onAction="#handleAddEvenement"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"
                            text="➕ Nouvel événement">
                        <font>
                            <Font name="System" size="14" />
                        </font>
                    </Button>
                    <Label fx:id="userNameLabel" style="-fx-font-size: 14px; -fx-text-fill: #2C3E50;" text="Admin">
                        <font>
                            <Font name="System" size="14" />
                        </font>
                    </Label>
                    <Label style="-fx-font-size: 24px; -fx-background-color: #ECF0F1; -fx-padding: 8; -fx-background-radius: 50%; -fx-cursor: hand;" text="👤" />
                </HBox>
            </HBox>

            <!-- Barre de recherche et filtres -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2); -fx-padding: 20;">

                <!-- Recherche -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;" text="RECHERCHER">
                            <font>
                                <Font name="System Bold" size="12" />
                            </font>
                        </Label>
                        <TextField fx:id="searchField"
                                   promptText="🔍 Rechercher par titre d'événement..."
                                   prefWidth="400"
                                   style="-fx-background-color: #F8F9FA; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-padding: 10; -fx-font-size: 14px;">
                            <font>
                                <Font name="System" size="14" />
                            </font>
                        </TextField>
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <VBox spacing="8" alignment="BOTTOM_CENTER">
                        <Button onAction="#handleRefresh"
                                style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🔄 Actualiser">
                            <font>
                                <Font name="System" size="14" />
                            </font>
                        </Button>
                    </VBox>
                </HBox>

                <Separator />

                <!-- Filtres -->
                <HBox spacing="15" alignment="CENTER_LEFT">
                    <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;" text="FILTRES :">
                        <font>
                            <Font name="System Bold" size="12" />
                        </font>
                    </Label>

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Date début" />
                        <DatePicker fx:id="filterDateDebut" promptText="Sélectionner..." prefWidth="140"
                                    style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Date fin" />
                        <DatePicker fx:id="filterDateFin" promptText="Sélectionner..." prefWidth="140"
                                    style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Lieu" />
                        <TextField fx:id="filterLieu" promptText="Tous les lieux..." prefWidth="150"
                                   style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-padding: 8; -fx-font-size: 12px;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Statut" />
                        <ComboBox fx:id="filterStatut" promptText="Tous les statuts" prefWidth="140"
                                  style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;" />
                    </VBox>

                    <VBox spacing="5">
                        <Label style="-fx-font-size: 11px; -fx-text-fill: #7F8C8D;" text="Catégorie" />
                        <ComboBox fx:id="filterCategorie" promptText="Toutes" prefWidth="140"
                                  style="-fx-background-color: #F8F9FA; -fx-background-radius: 6; -fx-border-color: #E0E0E0; -fx-border-radius: 6; -fx-font-size: 12px;" />
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15">
                    <Button onAction="#handleResetFilters"
                            style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-size: 12px; -fx-padding: 8 15; -fx-background-radius: 6; -fx-cursor: hand;"
                            text="✕ Réinitialiser les filtres" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="resultsCountLabel"
                           style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D; -fx-font-style: italic;"
                           text="0 événement(s) trouvé(s)" />
                </HBox>
            </VBox>

            <!-- Liste des Événements -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="25" left="25" right="25" top="25" />
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Liste des Événements" />
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>

                <TableView fx:id="eventsTable" minHeight="300.0" prefHeight="350.0"
                           style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="titreColumn" prefWidth="180" style="-fx-alignment: CENTER-LEFT;" text="Titre" />
                        <TableColumn fx:id="typeColumn" prefWidth="120" style="-fx-alignment: CENTER;" text="Type" />
                        <TableColumn fx:id="dateDebutColumn" prefWidth="95" style="-fx-alignment: CENTER;" text="Début" />
                        <TableColumn fx:id="dateFinColumn" prefWidth="95" style="-fx-alignment: CENTER;" text="Fin" />
                        <TableColumn fx:id="lieuColumn" prefWidth="110" style="-fx-alignment: CENTER-LEFT;" text="Lieu" />
                        <TableColumn fx:id="categorieColumn" prefWidth="110" style="-fx-alignment: CENTER;" text="Catégorie" />
                        <TableColumn fx:id="statutColumn" prefWidth="95" style="-fx-alignment: CENTER;" text="Statut" />
                        <TableColumn fx:id="actionsColumn" prefWidth="180" style="-fx-alignment: CENTER;" text="Actions" />
                    </columns>
                </TableView>
            </VBox>

            <!-- Barre d'outils inférieure -->
            <HBox alignment="CENTER" spacing="20"
                  style="-fx-background-color: white; -fx-background-radius: 12;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                         -fx-padding: 15 25;">
                <Label text="🛠️ Outils rapides :"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>

                <Button onAction="#handleOpenGoogleCalendar"
                        style="-fx-background-color: #DB4437; -fx-text-fill: white; -fx-font-size: 14px;
                               -fx-padding: 12 28; -fx-background-radius: 10; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(219,68,55,0.3), 6, 0, 0, 3);"
                        text="📅 Ouvrir le Calendrier">
                    <font><Font name="System" size="14" /></font>
                </Button>

                <Button fx:id="generateIdeasBtn" onAction="#handleGenerateIdeas"
                        style="-fx-background-color: #8E44AD; -fx-text-fill: white; -fx-font-size: 14px;
                               -fx-padding: 12 28; -fx-background-radius: 10; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(142,68,173,0.3), 6, 0, 0, 3);"
                        text="💡 Générer des idées d'événements">
                    <font><Font name="System" size="14" /></font>
                </Button>
            </HBox>

        </VBox>
    </center>

</BorderPane>