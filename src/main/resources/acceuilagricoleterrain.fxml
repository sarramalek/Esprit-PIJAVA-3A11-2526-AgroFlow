<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane prefHeight="805.0" prefWidth="1520.0"
            style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.AccueilTerrainagricole">

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- SIDEBAR AGRICOLE VERTE                              -->
    <!-- ═══════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: linear-gradient(to bottom, #2E7D32, #388E3C, #43A047);">
            <padding><Insets bottom="20" top="20" /></padding>

            <!-- Logo -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 0 0 20 0;">
                <Label style="-fx-font-size: 32px;" text="🌱" />
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;" text="AgroFlow">
                        <font><Font name="System Bold" size="26" /></font>
                    </Label>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);" text="Mon Exploitation">
                        <font><Font name="System" size="11" /></font>
                    </Label>
                </VBox>
            </HBox>

            <!-- Info Utilisateur -->
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15;
                         -fx-padding: 20; -fx-margin: 10;">
                <Label style="-fx-font-size: 30px;" text="👨‍🌾" />
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"
                       text="Gestionnaire">
                    <font><Font name="System Bold" size="16" /></font>
                </Label>
                <Label style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);
                              -fx-background-color: rgba(76,175,80,0.3); -fx-padding: 4 12;
                              -fx-background-radius: 15;"
                       text="🌾 ADMIN">
                    <font><Font name="System Bold" size="12" /></font>
                </Label>
            </VBox>

            <!-- Navigation Menu -->
            <VBox spacing="8" style="-fx-padding: 20 0 0 0;">

                <Button prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐾   Gestion Animaux">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <Button prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="⚙️   Gestion Matériels">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <Button prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦   Gestion Stocks">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- Item actif -->
                <Button prefHeight="48" prefWidth="230"
                        style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049);
                               -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 6, 0, 0, 2);"
                        text="🌱   Gestion Terrains">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <Button prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📅   Événements">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <Button prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="👥   Utilisateurs">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Déconnexion -->
            <VBox style="-fx-padding: 0 10 0 10;">
                <Separator style="-fx-background-color: rgba(255,255,255,0.2);" prefHeight="1"/>
                <Button maxWidth="Infinity" prefHeight="48"
                        style="-fx-background-color: #E74C3C; -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🚪   Déconnexion">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
            </VBox>
        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════ -->
    <!-- CONTENU PRINCIPAL (inchangé)                        -->
    <!-- ═══════════════════════════════════════════════════ -->
    <center>
        <VBox spacing="40" alignment="CENTER" style="-fx-padding: 40;">
            <children>

                <Text text="Sélectionner Terrains ou Plantes ou Rotations"
                      fill="#2C3E50">
                    <font>
                        <Font name="System Bold" size="28"/>
                    </font>
                </Text>

                <HBox spacing="40" alignment="CENTER">

                    <!-- Card Terrains -->
                    <VBox spacing="15" alignment="CENTER"
                          onMouseClicked="#ouvrirTerrains"
                          style="-fx-background-color: white; -fx-padding: 35;
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-cursor: hand;
                                 -fx-effect: dropshadow(gaussian, rgba(45,90,39,0.15), 12, 0, 0, 4);">
                        <children>
                            <Text text="🚜" style="-fx-font-size: 52px;"/>
                            <Text text="Terrains" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2D5A27;"/>
                            <Label text="Gérer vos parcelles"
                                   style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;"/>
                        </children>
                    </VBox>

                    <!-- Card Plantes -->
                    <VBox spacing="15" alignment="CENTER"
                          onMouseClicked="#ouvrirPlantes"
                          style="-fx-background-color: white; -fx-padding: 35;
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-cursor: hand;
                                 -fx-effect: dropshadow(gaussian, rgba(45,90,39,0.15), 12, 0, 0, 4);">
                        <children>
                            <Text text="🌱" style="-fx-font-size: 52px;"/>
                            <Text text="Plantes" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2D5A27;"/>
                            <Label text="Gérer vos cultures"
                                   style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;"/>
                        </children>
                    </VBox>

                    <!-- Card Rotations -->
                    <VBox spacing="15" alignment="CENTER"
                          onMouseClicked="#ouvrirRotations"
                          style="-fx-background-color: white; -fx-padding: 35;
                                 -fx-border-radius: 14; -fx-background-radius: 14;
                                 -fx-cursor: hand;
                                 -fx-effect: dropshadow(gaussian, rgba(45,90,39,0.15), 12, 0, 0, 4);">
                        <children>
                            <Text text="📋" style="-fx-font-size: 52px;"/>
                            <Text text="Rotations" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-fill: #2D5A27;"/>
                            <Label text="Gérer vos rotations"
                                   style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;"/>
                        </children>
                    </VBox>

                </HBox>
            </children>
        </VBox>
    </center>

</BorderPane>
