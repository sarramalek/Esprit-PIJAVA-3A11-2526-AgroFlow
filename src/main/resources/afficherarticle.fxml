<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox prefHeight="650.0" prefWidth="1150.0" style="-fx-background-color: #fdfae7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.afficherarticleController">
    <children>
        <VBox prefWidth="250.0" spacing="5.0" style="-fx-background-color: #34495e;">
            <children>
                <Label text="AGROFLOW" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0" /></font>
                    <VBox.margin><Insets bottom="20.0" left="20.0" top="30.0" /></VBox.margin>
                </Label>
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;" text="🐾  Gestion Animaux" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;" text="🚜  Gestion Matériels" />
                <VBox spacing="0.0" style="-fx-background-color: #2c3e50;">
                    <children>
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;" text="📦  Gestion Stocks" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="35.0" style="-fx-background-color: #2d5a27; -fx-text-fill: white;" text="      • Gestion Articles" />
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#allerVersCategories" prefHeight="35.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;" text="      • Gestion Catégories" />
                    </children>
                </VBox>
                <Pane VBox.vgrow="ALWAYS" />
                <Button alignment="CENTER" maxWidth="Infinity" onAction="#deconnexion" prefHeight="45.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Déconnexion" />
            </children>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" spacing="15.0" style="-fx-padding: 30;">
            <children>
                <Label text="Liste des Stocks" textFill="#2d5a27">
                    <font><Font name="System Bold" size="28.0" /></font>
                </Label>

                <HBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="15.0" style="-fx-background-color: rgba(52, 73, 94, 0.08); -fx-background-radius: 12;">
                    <padding><Insets left="15.0" right="15.0" /></padding>
                    <children>
                        <Button onAction="#ouvrirFormulaireAjout" prefHeight="35.0" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-font-weight: bold;" text="+ AJOUTER" />
                        <Button onAction="#exporterAlertesPDF" prefHeight="35.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="📄 RAPPORT ALERTES" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="Catégorie :" style="-fx-font-weight: bold;" />
                        <ComboBox fx:id="cbFiltreCategorie" prefHeight="35.0" prefWidth="150.0" promptText="Toutes" />
                        <Label text="Rechercher :" style="-fx-font-weight: bold;" />
                        <TextField fx:id="tfRecherche" prefHeight="35.0" prefWidth="200.0" promptText="Nom..." style="-fx-background-radius: 15;" />
                    </children>
                </HBox>

                <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tableArticles" HBox.hgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colNom" text="Nom" prefWidth="150" />
                                <TableColumn fx:id="colCategorie" text="Catégorie" prefWidth="120" />
                                <TableColumn fx:id="colQuantite" text="Quantité" prefWidth="80" />
                                <TableColumn fx:id="colUnite" text="Unité" prefWidth="70" />
                                <TableColumn fx:id="colSeuil" text="Seuil" prefWidth="80" />
                                <TableColumn fx:id="colActions" text="Actions" prefWidth="160" />
                            </columns>
                        </TableView>

                        <VBox alignment="TOP_CENTER" minWidth="220.0" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
                            <children>
                                <Label text="QR CODE" style="-fx-font-weight: bold;" />
                                <ImageView fx:id="ivQRCode" fitHeight="150.0" fitWidth="150.0" />
                                <Label fx:id="lblNomSelection" text="Aucune sélection" textAlignment="CENTER" wrapText="true" />
                                <Button onAction="#enregistrerQRCode" maxWidth="Infinity" text="💾 Enregistrer" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="20.0" alignment="CENTER_LEFT">
                    <children>
                        <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #2d5a27; -fx-border-width: 0 0 0 5;">
                            <children>
                                <Label text="TOTAL ARTICLES" style="-fx-font-size: 10;" />
                                <Label fx:id="lblTotalArticles" text="0" style="-fx-font-size: 20; -fx-font-weight: bold;" />
                            </children>
                        </VBox>
                        <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #e74c3c; -fx-border-width: 0 0 0 5;">
                            <children>
                                <Label text="EN RUPTURE" style="-fx-font-size: 10;" />
                                <Label fx:id="lblNbAlertes" text="0" style="-fx-font-size: 20; -fx-font-weight: bold;" textFill="#e74c3c" />
                            </children>
                        </VBox>
                        <Label fx:id="lblWarning" text="⚠️ RÉAPPROVISIONNEMENT NÉCESSAIRE !" textFill="#e74c3c" visible="false" style="-fx-font-weight: bold;" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>