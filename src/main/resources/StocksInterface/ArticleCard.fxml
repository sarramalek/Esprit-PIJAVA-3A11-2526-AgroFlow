<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="250.0" spacing="10.0" 
      style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 5); -fx-padding: 20;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.Stocks.ArticleCardController">
    <children>
        <HBox alignment="TOP_RIGHT">
            <children>
                <Label fx:id="lblCategorie" style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 4 10; -fx-background-radius: 10;" text="CATEGORIE" />
            </children>
        </HBox>
        
        <Label fx:id="lblNom" wrapText="true" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Nom de l'article" />
        
        <Separator />
        
        <GridPane hgap="10" vgap="5">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
            </columnConstraints>
            <children>
                <Label text="En Stock:" style="-fx-text-fill: #7F8C8D; -fx-font-size: 12px;" />
                <Label fx:id="lblQuantite" GridPane.columnIndex="1" style="-fx-font-weight: bold; -fx-font-size: 14px;" text="0.0" />
                
                <Label text="Unité:" GridPane.rowIndex="1" style="-fx-text-fill: #7F8C8D; -fx-font-size: 12px;" />
                <Label fx:id="lblUnite" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-weight: bold;" text="Kg" />
            </children>
        </GridPane>
        
        <Region VBox.vgrow="ALWAYS" minHeight="10" />
        
        <HBox spacing="10">
            <children>
                <Button fx:id="btnSortie" onAction="#handleSortie" HBox.hgrow="ALWAYS" maxWidth="Infinity" 
                        style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" 
                        text="📉 SORTIE" prefHeight="35" />
                <Button onAction="#handleVoirMouvements" HBox.hgrow="ALWAYS" maxWidth="Infinity" 
                        style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;" 
                        text="📜 MVT" prefHeight="35" />
            </children>
        </HBox>
    </children>
</VBox>
