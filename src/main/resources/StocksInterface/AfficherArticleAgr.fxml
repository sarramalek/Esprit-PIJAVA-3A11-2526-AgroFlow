<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.shape.Circle?>
<BorderPane prefHeight="650.0" prefWidth="1050.0" style="-fx-background-color: #fdfae7;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Stocks.afficherarticleController">
    <left>
        <VBox prefWidth="260"
              style="-fx-background-color: #FAFAF5; -fx-border-color: #E8EDE0; -fx-border-width: 0 1 0 0;">
            <padding><Insets top="0" bottom="20" /></padding>

            <!-- Logo Header -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #FFFFFF; -fx-padding: 16 20; -fx-border-color: #E8EDE0; -fx-border-width: 0 0 1 0;">
                <StackPane prefWidth="36" prefHeight="36">
                    <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                        <image><Image url="/style/logo.png"/></image>
                    </ImageView>
                </StackPane>
                <Label text="AgroFlow"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1B5E20;">
                    <font><Font name="System Bold" size="20" /></font>
                </Label>
            </HBox>

            <!-- User Info Card -->
            <VBox alignment="CENTER" spacing="6"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #E8EDE0;
                     -fx-border-width: 0 0 1 0; -fx-padding: 18 20;">

                <StackPane prefWidth="64" prefHeight="64">
                    <Circle fx:id="sidebarAvatarBg" radius="32" fill="#E8F5E9" />
                    <Label fx:id="sidebarAvatarDefault"
                           style="-fx-font-size: 28px;"
                           text="👨‍🌾" />
                    <ImageView fx:id="sidebarAvatarImageView"
                               fitWidth="64" fitHeight="64"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>

                <Label fx:id="userNameLabel"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A2E1A;"
                       text="Nom Agriculteur">
                    <font><Font name="System Bold" size="15" /></font>
                </Label>

                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;
                          -fx-background-color: #E8F5E9; -fx-padding: 3 10;
                          -fx-background-radius: 20;"
                       text="🌾 AGRICULTEUR">
                    <font><Font name="System Bold" size="11" /></font>
                </Label>

                <Hyperlink fx:id="aproposLink" text="👤 À propos de moi"
                           onMouseClicked="#handleMonProfil"
                           style="-fx-text-fill: #388E3C; -fx-font-size: 12px;
                              -fx-border-color: #C8E6C9; -fx-padding: 4 14;
                              -fx-background-radius: 20; -fx-border-radius: 20;
                              -fx-cursor: hand; -fx-underline: false;">
                    <font><Font name="System" size="12" /></font>
                </Hyperlink>
            </VBox>

            <!-- Navigation Label -->
            <Label text="NAVIGATION"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9E9E9E;
                      -fx-padding: 16 20 6 20;">
                <font><Font name="System Bold" size="10" /></font>
            </Label>

            <!-- Navigation Menu -->
            <VBox spacing="2" style="-fx-padding: 0 12;">

                <!-- Accueil -->
                <Button onMouseClicked="#handleDashboardAgricole" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: #E8F5E9; -fx-text-fill: #1B5E20;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #A5D6A7; -fx-border-radius: 10; -fx-border-width: 1;"
                        text="📊  Accueil">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Terrains avec sous-menu -->
                <VBox spacing="0">
                    <Button onMouseClicked="#handleMesTerrains" prefHeight="44" prefWidth="236"
                            style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                               -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                            text="🌾  Mes Terrains  ▾">
                        <font><Font name="System Bold" size="13" /></font>
                    </Button>
                    <VBox fx:id="terrainsSubMenu" spacing="1"
                          style="-fx-padding: 2 0 2 12;" visible="false" managed="false">
                        <Button onMouseClicked="#ouvrirTerrains" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: #F1F8E9; -fx-text-fill: #33691E;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-border-color: #DCEDC8; -fx-border-radius: 8; -fx-border-width: 1;"
                                text="🚜  Terrains">
                            <font><Font name="System Bold" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirPlantes" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🌱  Plantes">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirRotations" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="📋  Rotations">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Mes Animaux -->
                <Button onMouseClicked="#handleMesAnimaux" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="🐄  Mes Animaux">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Stocks avec sous-menu -->
                <VBox spacing="0">
                    <Button onAction="#handleMesStocks" prefHeight="44" prefWidth="236"
                            style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                               -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                            text="📦  Mes Stocks  ▾">
                        <font><Font name="System Bold" size="13" /></font>
                    </Button>
                    <VBox fx:id="StocksSubMenu" spacing="1"
                          style="-fx-padding: 2 0 2 12;" visible="true" managed="true">
                        <Button onMouseClicked="#handleMesArticles" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: #F1F8E9; -fx-text-fill: #33691E;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-border-color: #DCEDC8; -fx-border-radius: 8; -fx-border-width: 1;"
                                text="📄  Articles">
                            <font><Font name="System Bold" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#handleMesCatégories" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🗂️  Catégories">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                        <Button onAction="#voirHistoriqueGlobal" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="📜  Historique">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Mon Matériel -->
                <Button onMouseClicked="#handleMonMateriel" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="🚜  Mon Matériel">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Abonnements -->
                <Button onMouseClicked="#handleMonAbonnement" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="💳  Mes Abonnements">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Événements et Participation -->
                <Button onMouseClicked="#handleMesEvenements" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="📅  Événements et Participation">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Separator -->
            <Separator style="-fx-background-color: #E0E8D8;" />

            <!-- Déconnexion -->
            <VBox style="-fx-padding: 12 12 0 12;">
                <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: #FFF3F3; -fx-text-fill: #C62828;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #FFCDD2; -fx-border-radius: 10; -fx-border-width: 1;"
                        text="🚪  Déconnexion">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>
            </VBox>

        </VBox>
    </left>

    <center>
        <VBox spacing="20.0" style="-fx-padding: 25;">
            <children>
                <Label text="Liste des Stocks" textFill="#2d5a27">
                    <font><Font name="System Bold" size="28.0" /></font>
                </Label>

                <HBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="15.0" style="-fx-background-color: rgba(52, 73, 94, 0.08); -fx-background-radius: 12;">
                    <padding><Insets left="15.0" right="15.0" /></padding>
                    <children>
                        <Button onAction="#ouvrirFormulaireAjout" prefHeight="35.0" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-font-weight: bold;" text="+ AJOUTER" />
                        <Button onAction="#exporterPDF" prefHeight="35.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="📄 PDF" />
                        <Button onAction="#exporterExcel" prefHeight="35.0" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="📊 EXCEL" />
                        <Button onAction="#exporterAlertesPDF" prefHeight="35.0" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;" text="🔔 ALERTES" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-weight: bold;" text="Catégorie :" />
                        <ComboBox fx:id="cbFiltreCategorie" prefHeight="35.0" prefWidth="150.0" promptText="Toutes" />
                        <Label style="-fx-font-weight: bold;" text="Rechercher :" />
                        <TextField fx:id="tfRecherche" prefHeight="35.0" prefWidth="200.0" promptText="Nom..." style="-fx-background-radius: 15;" />
                    </children>
                </HBox>

                <HBox spacing="15.0" VBox.vgrow="ALWAYS">
                    <children>
                        <TableView fx:id="tableArticles" HBox.hgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colNom" prefWidth="150" text="Nom" />
                                <TableColumn fx:id="colCategorie" prefWidth="120" text="Catégorie" />
                                <TableColumn fx:id="colQuantite" prefWidth="80" text="Quantité" />
                                <TableColumn fx:id="colUnite" prefWidth="70" text="Unité" />
                                <TableColumn fx:id="colPrix" prefWidth="80" text="Prix" />
                                <TableColumn fx:id="colDevise" prefWidth="100" text="Devise" />
                                <TableColumn fx:id="colSeuil" prefWidth="80" text="Seuil" />
                                <TableColumn fx:id="colActions" prefWidth="350.0" text="Actions" />
                            </columns>
                        </TableView>

                        <VBox fx:id="qrCodeContainer" alignment="TOP_CENTER" minWidth="220.0" spacing="10.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="QR CODE" />
                                <ImageView fx:id="ivQRCode" fitHeight="150.0" fitWidth="150.0" />
                                <Label fx:id="lblNomSelection" text="Aucune sélection" textAlignment="CENTER" wrapText="true" />
                                <Button maxWidth="Infinity" onAction="#enregistrerQRCode" text="💾 Enregistrer" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #2d5a27; -fx-border-width: 0 0 0 5;">
                            <children>
                                <Label style="-fx-font-size: 10;" text="TOTAL ARTICLES" />
                                <Label fx:id="lblTotalArticles" style="-fx-font-size: 20; -fx-font-weight: bold;" text="0" />
                            </children>
                        </VBox>
                        <VBox style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #e74c3c; -fx-border-width: 0 0 0 5;">
                            <children>
                                <Label style="-fx-font-size: 10;" text="EN RUPTURE" />
                                <Label fx:id="lblNbAlertes" style="-fx-font-size: 20; -fx-font-weight: bold;" text="0" textFill="#e74c3c" />
                            </children>
                        </VBox>
                        <Label fx:id="lblWarning" style="-fx-font-weight: bold;" text="⚠️ RÉAPPROVISIONNEMENT NÉCESSAIRE !" textFill="#e74c3c" visible="false" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>