<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox prefWidth="150.0" alignment="CENTER" spacing="10.0" 
      style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.05), 5, 0, 0, 2); -fx-padding: 15; -fx-cursor: hand;"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.Stocks.CategorieCardController"
      onMouseClicked="#handleCategoryClick">
    <children>
        <Label fx:id="lblIcon" style="-fx-font-size: 24px;" text="📁" />
        <Label fx:id="lblNom" wrapText="true" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" text="Nom Catégorie" />
    </children>
</VBox>
