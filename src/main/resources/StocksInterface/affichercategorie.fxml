<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>
<BorderPane prefHeight="650.0" prefWidth="1050.0" style="-fx-background-color: #fdfae7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Stocks.affichercategorieController">
    <!-- SIDEBAR EMPLOYÉ (bleue) -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: linear-gradient(to bottom, #1a237e, #283593, #3949ab);">
            <padding><Insets bottom="20" top="20" /></padding>
            <StackPane prefWidth="100" prefHeight="100">
                <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                    <image><Image url="/style/logo.png"/></image>
                </ImageView>
            </StackPane>

            <VBox alignment="CENTER" spacing="8" style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15; -fx-padding: 20; -fx-margin: 10;">
                <StackPane prefWidth="64" prefHeight="64">
                    <Circle radius="32" fill="rgba(255,255,255,0.25)" />
                    <Label text="👤" style="-fx-font-size: 30px;" />
                </StackPane>
                <Label fx:id="userNameLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;" text="Nom Ouvrier" />
                <Label fx:id="userRoleLabel" style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8); -fx-background-color: rgba(76,175,80,0.3); -fx-padding: 4 12; -fx-background-radius: 15;" text="👷 EMPLOYÉ" />
            </VBox>

            <VBox spacing="10" style="-fx-padding: 20 0 0 0;">
                <Button onMouseClicked="#handleDashboard" prefHeight="50" prefWidth="230" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;" text="📊  Acceuil" />
                <Button onMouseClicked="#handleMesTaches" prefHeight="50" prefWidth="230" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;" text="📋  Mes Tâches" />
                
                <VBox spacing="5">
                    <Button onMouseClicked="#handleStocks" prefHeight="50" prefWidth="230" style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;" text="📦  Stocks" />
                    <VBox spacing="3" style="-fx-padding: 0 0 0 30;">
                        <Button onMouseClicked="#handleStocks" prefHeight="35" prefWidth="200" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="• Articles" />
                        <Button onMouseClicked="#handleCategories" prefHeight="35" prefWidth="200" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-cursor: hand;" text="• Catégories" />
                    </VBox>
                </VBox>

                <Button onMouseClicked="#handleMonProfil" prefHeight="50" prefWidth="230" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;" text="👤  Mon Profil" />
                <Button onMouseClicked="#ouvrirRotations" prefHeight="48" prefWidth="230" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;" text="🌾  Mes Rotations" />
                <Button onMouseClicked="#handleMateriels" prefHeight="48" prefWidth="230" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;" text="🔧  Maintenances" />
                <Button onMouseClicked="#handleEvents" prefHeight="48" prefWidth="230" style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;" text="🎉  Evenements" />
            </VBox>

            <Region VBox.vgrow="ALWAYS" />
            <Button fx:id="logoutBtn" onMouseClicked="#handleLogout" prefHeight="50" prefWidth="230" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;" text="🚪  Déconnexion" />
        </VBox>
    </left>
    <!-- ================= CENTER ================= -->
    <center>
        <VBox HBox.hgrow="ALWAYS" spacing="15.0" style="-fx-padding: 30;">
            <HBox alignment="CENTER" spacing="12" style="-fx-cursor: hand;" onMouseClicked="#handleMonProfil">
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Admin">
                        <font><Font name="System Bold" size="15" /></font>
                    </Label>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" text="Administrateur">
                        <font><Font name="System" size="11" /></font>
                    </Label>
                </VBox>

                <!-- Avatar circulaire : photo si disponible, sinon emoji 👤 -->
                <StackPane>
                    <!-- Fond dégradé (visible si pas de photo) -->
                    <Circle fx:id="avatarBg" radius="24"
                            fill="linear-gradient(to bottom right, #667eea, #764ba2)" />
                    <!-- Emoji par défaut -->
                    <Label fx:id="avatarDefaultLabel"
                           style="-fx-font-size: 22px; -fx-text-fill: white;"
                           text="👤" />
                    <!-- Photo chargée depuis Cloudinary (clip appliqué en Java) -->
                    <ImageView fx:id="avatarImageView"
                               fitWidth="48" fitHeight="48"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>
            </HBox>
            <children>
                <Label text="Gestion des Catégories" textFill="#2d5a27">
                    <font><Font name="System Bold" size="28.0" /></font>
                </Label>

                <HBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="15.0" style="-fx-background-color: rgba(52, 73, 94, 0.08); -fx-background-radius: 12; -fx-border-color: rgba(52, 73, 94, 0.15); -fx-border-radius: 12;">
                    <padding><Insets left="15.0" right="15.0" /></padding>
                    <children>
                        <Button onAction="#ouvrirFormulaireAjout" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="+ AJOUTER" />
                        <Button onAction="#modifierCategorie" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="✏ MODIFIER" />
                        <Button onAction="#supprimerCategorie" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="🗑 SUPPRIMER" />
                        
                        <Region HBox.hgrow="ALWAYS" />
                        
                        <!-- RECHERCHE ET FILTRE -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <TextField fx:id="searchField" prefWidth="200.0" promptText="🔍 Rechercher..." style="-fx-background-radius: 20; -fx-padding: 8 15;" />
                                <ComboBox fx:id="cbFiltreAgriculteur" prefWidth="180.0" promptText="🌾 Filtre Agriculteur" style="-fx-background-radius: 20;" />
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <TableView fx:id="tableCategories" prefHeight="450.0" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-background-insets: 0;">
                    <columns>
                        <TableColumn fx:id="colNom" text="Nom" />
                        <TableColumn fx:id="colDescription" text="Description Détaillé" />
                        <TableColumn fx:id="colAgriculteur" text="Agriculteur" visible="false" />
                        <TableColumn fx:id="colNbArticles" text="Nb Articles" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>