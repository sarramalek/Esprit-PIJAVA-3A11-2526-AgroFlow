<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox prefHeight="650.0" prefWidth="1050.0" style="-fx-background-color: #fdfae7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Stocks.ajouterarticleController">
    <children>
        <VBox prefWidth="250" style="-fx-background-color:  #2C3E50;">
        <padding>
            <Insets bottom="20" top="20" />
        </padding>

        <!-- Logo/Header MODERNE -->
        <HBox alignment="CENTER" spacing="12" style="-fx-padding: 0 0 35 0;">
            <Label style="-fx-font-size: 32px;" text="🌱" />
            <VBox alignment="CENTER_LEFT" spacing="2">
                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);" text="AgroFlow">
                    <font><Font name="System Bold" size="26" /></font>
                </Label>
                <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);" text="Gestion Agricole">
                    <font><Font name="System" size="11" /></font>
                </Label>
            </VBox>
        </HBox>

        <!-- Navigation Menu MODERNISÉE -->
        <VBox spacing="10">
            <!-- Dashboard -->
            <Button fx:id="dashboardBtn" onAction="#handleDashboard" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;"
                    text="📊  Dashboard">
                <font><Font name="System Bold" size="14" /></font>
            </Button>

            <!-- GESTION PRINCIPALE avec sous-menu -->
            <VBox fx:id="gestionContainer" prefWidth="230" spacing="5" style="-fx-background-radius: 12;">
                <Button fx:id="gestionBtn"  prefHeight="50" prefWidth="230"
                        style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"
                        text="⚙️  Gestion Utilisateurs">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- Sous-menu MODERNE -->
                <VBox fx:id="gestionSubmenu" spacing="3" style="-fx-padding: 5 0 5 15; -fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 0 0 12 12;">
                    <Button fx:id="personnesBtn" onMouseClicked="#handlePersonnes" prefHeight="42" prefWidth="215"
                            style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"
                            text="👥  Personnes">
                        <font><Font name="System" size="13" /></font>
                    </Button>
                    <Button fx:id="tachesBtn" onMouseClicked="#handleTaches" prefHeight="42" prefWidth="215"
                            style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                            text="✓  Tâches">
                        <font><Font name="System" size="13" /></font>
                    </Button>

                    <Button fx:id="abonnementsBtn" onMouseClicked="#handleAbonnements" prefHeight="42" prefWidth="215"
                            style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                            text="💳  Abonnements">
                        <font><Font name="System" size="13" /></font>
                    </Button>
                    <Button fx:id="offresBtn" onMouseClicked="#handleOffres" prefHeight="42" prefWidth="215"
                            style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                            text="🎁  Offres">
                        <font><Font name="System" size="13" /></font>
                    </Button>
                </VBox>
            </VBox>

            <!-- Autres boutons MODERNISÉS -->
            <VBox>
                <Button alignment="BASELINE_LEFT" fx:id="stocksBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleStocks"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="35.0" style="-fx-background-color: #2d5a27; -fx-text-fill: white;" text="      • Gestion Articles">
                    <padding><Insets left="20.0" /></padding>
                </Button>
                <Button alignment="BASELINE_LEFT" onAction="#allerVersCategories" maxWidth="Infinity" prefHeight="35.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;" text="      • Gestion Catégories">
                    <padding><Insets left="20.0" /></padding>
                </Button>
            </VBox>
            <Button fx:id="terrainsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleTerrains"
                    style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                    text="🌾  Terrains">
                <font><Font name="System" size="14" /></font>
            </Button>
            <Button fx:id="animauxBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleAnimals"
                    style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                    text="🐄  Animaux">
                <font><Font name="System" size="14" /></font>
            </Button>
            <Button fx:id="materielBtn" prefHeight="48" prefWidth="230 " onMouseClicked="#handleMateriels"
                    style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                    text="🔧  Matériel">
                <font><Font name="System" size="14" /></font>
            </Button>
            <Button fx:id="evenementsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleEvents"
                    style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                    text="🎉  Événements">
                <font><Font name="System" size="14" /></font>
            </Button>
        </VBox>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" spacing="25.0" style="-fx-padding: 40;">
            <children>
                <Label fx:id="lblTitre" text="Nouvel Article de Stock" textFill="#2c3e50">
                    <font><Font name="System Bold" size="30.0" /></font>
                </Label>

                <GridPane vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="200.0" />
                        <ColumnConstraints prefWidth="450.0" />
                    </columnConstraints>
                    <children>
                        <Label text="Désignation :" GridPane.rowIndex="0"/>
                        <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label fx:id="msgNom" text="" style="-fx-font-size: 11px;" />
                            <TextField fx:id="tfNom" prefHeight="35.0" promptText="Ex: Engrais NPK" />
                        </VBox>

                        <Label text="Quantité en Stock :" GridPane.rowIndex="1" />
                        <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label fx:id="msgQuantite" text="" style="-fx-font-size: 11px;" />
                            <TextField fx:id="tfQuantite" prefHeight="35.0" />
                        </VBox>

                        <Label text="Seuil d'Alerte :" GridPane.rowIndex="2" />
                        <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <Label fx:id="msgSeuil" text="" style="-fx-font-size: 11px;" />
                            <TextField fx:id="tfSeuil" prefHeight="35.0" />
                        </VBox>

                        <Label text="Unité de mesure :" GridPane.rowIndex="3" />
                        <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="3">
                            <Label fx:id="msgUnite" text="" style="-fx-font-size: 11px;" />
                            <TextField fx:id="tfUnite" prefHeight="35.0" />
                        </VBox>

                        <Label text="Catégorie :" GridPane.rowIndex="4" />
                        <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="4">
                            <Label fx:id="msgCategorie" text="" style="-fx-font-size: 11px;" />
                            <HBox spacing="10.0" alignment="CENTER_LEFT">
                                <children>
                                    <ComboBox fx:id="cbCategories" prefHeight="35.0" prefWidth="350.0" promptText="Choisir une catégorie" />
                                    <Button onAction="#allerAjouterCategorie" prefHeight="35.0" prefWidth="40.0" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" text="+" />
                                </children>
                            </HBox>
                        </VBox>
                    </children>
                </GridPane>

                <HBox spacing="20.0">
                    <children>
                        <Button onAction="#validerAjout" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-font-weight: bold;" text="CONFIRMER" />
                        <Button onAction="#allerVersArticles" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #34495e;" text="ANNULER" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</HBox>