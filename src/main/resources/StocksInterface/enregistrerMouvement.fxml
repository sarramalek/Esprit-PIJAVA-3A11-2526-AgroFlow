<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20.0" style="-fx-background-color: white; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Stocks.enregistrerMouvementController">
    <children>
        <Label text="📦 Nouveau Mouvement de Stock" textFill="#2d5a27">
            <font><Font name="System Bold" size="20.0" /></font>
        </Label>
        
        <GridPane hgap="15.0" vgap="15.0">
            <columnConstraints>
                <ColumnConstraints halignment="RIGHT" minWidth="100.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" />
            </columnConstraints>
            <children>
                <Label text="Article :" style="-fx-font-weight: bold;" GridPane.rowIndex="0" />
                <Label fx:id="lblArticleNom" text="Nom de l'article" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                
                <Label text="Type :" style="-fx-font-weight: bold;" GridPane.rowIndex="1" />
                <ComboBox fx:id="cbType" prefHeight="35.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                
                <Label text="Quantité :" style="-fx-font-weight: bold;" GridPane.rowIndex="2" />
                <TextField fx:id="tfQuantite" prefHeight="35.0" promptText="0.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                
                <Label text="Motif :" style="-fx-font-weight: bold;" GridPane.rowIndex="3" />
                <TextArea fx:id="taMotif" prefHeight="80.0" promptText="Ex: Achat de fournitures, Consommation..." GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </children>
        </GridPane>
        
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <children>
                <Button onAction="#handleAnnuler" prefHeight="35.0" prefWidth="100.0" style="-fx-background-color: #bdc3c7; -fx-text-fill: white; -fx-cursor: hand;" text="Annuler" />
                <Button onAction="#handleValider" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Enregistrer" />
            </children>
        </HBox>
    </children>
</VBox>
