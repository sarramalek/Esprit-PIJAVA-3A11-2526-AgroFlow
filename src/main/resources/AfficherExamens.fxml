<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<AnchorPane prefHeight="700.0" prefWidth="1050.0" style="-fx-background-color: #FDFBF0;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AfficherExamensController">
    <children>
        <VBox prefWidth="250.0" spacing="5.0" style="-fx-background-color: #2C3E50;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>
                <Text fill="WHITE" text="AGROFLOW" textAlignment="CENTER" wrappingWidth="250.0">
                    <font><Font name="System Bold" size="30.0" /></font>
                    <VBox.margin><Insets bottom="30.0" top="30.0" /></VBox.margin>
                </Text>
                <Separator opacity="0.1" />
                <Button alignment="BASELINE_LEFT" onAction="#naviguerVersAnimaux" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #D5D8DC; -fx-font-size: 16; -fx-padding: 0 0 0 20;" text="🐾  Gestion Animaux" />
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #D5D8DC; -fx-font-size: 16; -fx-padding: 0 0 0 20;" text="⚙️  Gestion Matériels" />
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #D5D8DC; -fx-font-size: 16; -fx-padding: 0 0 0 20;" text="📦  Gestion Stocks" />
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #D5D8DC; -fx-font-size: 16; -fx-padding: 0 0 0 20;" text="🌱  Gestion Terrains" />
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #D5D8DC; -fx-font-size: 16; -fx-padding: 0 0 0 20;" text="📅  Événements" />
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #D5D8DC; -fx-font-size: 16; -fx-padding: 0 0 0 20;" text="👥  Utilisateurs" />
                <Region VBox.vgrow="ALWAYS" />
                <Separator opacity="0.1" />
                <Button onAction="#handleDeconnexion" prefHeight="40.0" prefWidth="220.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="Déconnexion">
                    <VBox.margin><Insets bottom="20.0" left="15.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>

        <VBox spacing="20.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="280.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Text fill="#2C3E50" text="Gestion des Examens">
                            <font><Font name="System Bold" size="26.0" /></font>
                        </Text>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onAction="#naviguerVersAnimaux" style="-fx-background-color: #A3C1AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" text="Table Animaux" />
                        <Button style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" text="Table Examens" />

                        <MenuButton mnemonicParsing="false" style="-fx-background-color: #34495E; -fx-text-fill: white; -fx-font-weight: bold;" text="🔔 Suivi Médical" textFill="WHITE">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#ouvrirDetailsAlertes" text="⚠️ Voir les Alertes" />
                                <MenuItem mnemonicParsing="false" onAction="#ouvrirStats" text="📊 Stats Mensuelles" />
                                <SeparatorMenuItem />
                                <MenuItem mnemonicParsing="false" onAction="#traduireDiagnostics" text="🌍 Traduire Diagnostics (API)" />
                                <MenuItem mnemonicParsing="false" onAction="#afficherConseilsSante" text="💡 Conseils de Santé" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="🔍 Type d'Examen :" />
                                <TextField fx:id="filterType" prefWidth="180.0" promptText="Ex: Vaccin..." style="-fx-background-radius: 10; -fx-border-color: #A3C1AD;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="📅 Date précise :" />
                                <DatePicker fx:id="filterDate" prefWidth="160.0" style="-fx-border-color: #A3C1AD;" />
                            </children>
                        </VBox>
                        <Button onAction="#reinitialiserFiltres" style="-fx-background-color: #BDC3C7; -fx-text-fill: white; -fx-background-radius: 10;" text="Réinitialiser">
                            <HBox.margin><Insets top="20.0" /></HBox.margin>
                        </Button>
                    </children>
                </HBox>

                <TableView fx:id="tvExamens" style="-fx-background-radius: 10; -fx-border-color: #D5D8DC;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colAnimal" prefWidth="100.0" text="Animal" />
                        <TableColumn fx:id="colType" prefWidth="110.0" text="Type" />
                        <TableColumn fx:id="colDate" prefWidth="95.0" text="Date" />
                        <TableColumn fx:id="colDiagnostic" prefWidth="120.0" text="Diagnostic" />
                        <TableColumn fx:id="colTraitement" prefWidth="120.0" text="Traitement" />
                        <TableColumn fx:id="colTraduction" prefWidth="140.0" text="Traduction (EN)" />
                        <TableColumn fx:id="colConseils" prefWidth="180.0" text="Conseils Médicaux" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER" spacing="25.0">
                    <children>
                        <Button onAction="#naviguerAjout" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="+ AJOUTER" />
                        <Button onAction="#handleModifier" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #A3C1AD; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-background-radius: 10;" text="MODIFIER" />
                        <Button onAction="#handleSupprimer" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="SUPPRIMER" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>