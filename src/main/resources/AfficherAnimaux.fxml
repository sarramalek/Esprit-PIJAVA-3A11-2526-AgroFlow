<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="700.0" prefWidth="1050.0" style="-fx-background-color: #FDFBF0;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.AfficherAnimauxController">
    <left>
        <VBox prefWidth="250.0" spacing="5.0" style="-fx-background-color: #2C3E50;"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.topAnchor="0.0">
            <children>
                <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="AGROFLOW" textAlignment="CENTER" wrappingWidth="250.0">
                    <font><Font name="System Bold" size="30.0" /></font>
                    <VBox.margin><Insets bottom="30.0" top="30.0" /></VBox.margin>
                </Text>
                <Separator opacity="0.2" prefHeight="20.0" />
                <Button alignment="BASELINE_LEFT" onAction="#naviguerAnimaux" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: #2D5A27; -fx-text-fill: white;-fx-font-weight: bold; -fx-font-size: 16; -fx-padding: 0 0 0 20;" text="🐾  Gestion Animaux" />
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #D5D8DC; -fx-font-size: 16; -fx-padding: 0 0 0 20;" text="⚙️  Gestion Matériels" />
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #D5D8DC; -fx-font-size: 16; -fx-padding: 0 0 0 20;" text="📦  Gestion Stocks" />
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #D5D8DC; -fx-font-size: 16; -fx-padding: 0 0 0 20;" text="🌱  Gestion Terrains" />
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #D5D8DC; -fx-font-size: 16; -fx-padding: 0 0 0 20;" text="📅  Événements" />
                <Button alignment="BASELINE_LEFT" prefHeight="50.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #D5D8DC; -fx-font-size: 16; -fx-padding: 0 0 0 20;" text="👥  Utilisateurs" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator opacity="0.1" />
                <Button  prefHeight="40.0" prefWidth="220.0"
                        style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                        text="Déconnexion">
                    <VBox.margin><Insets bottom="20.0" left="15.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>
    </left>
    <center>
        <VBox alignment="TOP_CENTER" spacing="20.0" style="-fx-padding: 30;">
            <children>
                <Text fill="#2C3E50" text="Gestion des Animaux"><font><Font name="System Bold" size="24.0" /></font></Text>
                <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 10;">
                    <children>
                        <Button onAction="#naviguerAnimaux" prefWidth="150.0" text="Table Animaux"
                                style="-fx-background-color: #A3C1AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" />
                        <Button onAction="#naviguerVersExamens" prefWidth="150.0" text="Table Examens"
                                style="-fx-background-color: #A3C1AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" />
                    </children>
                </HBox>
                <TableView fx:id="tableAnimaux" prefHeight="380.0" prefWidth="650.0">
                    <columns>
                        <TableColumn fx:id="colNom" prefWidth="120.0" text="Nom" />
                        <TableColumn fx:id="colEspece" prefWidth="120.0" text="Espèce" />
                        <TableColumn fx:id="colPoids" prefWidth="100.0" text="Poids (kg)" />
                        <TableColumn fx:id="colDate" prefWidth="150.0" text="Date Naissance" />
                        <TableColumn fx:id="colSexe" prefWidth="120.0" text="Sexe" />
                    </columns>
                </TableView>
                <HBox spacing="10.0" alignment="CENTER_LEFT" style="-fx-padding: 10;">
                    <Label text="🔍 Rechercher :" style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" />
                    <TextField fx:id="filterField" prefWidth="300.0" promptText="Tapez un nom ou une espèce..."
                               style="-fx-border-color: #A8C69F; -fx-background-radius: 15; -fx-border-radius: 15;" />
                </HBox>
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button onAction="#versAjout" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="+ AJOUTER" />
                        <Button onAction="#versModifier" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #A8C69F; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-cursor: hand;" text="MODIFIER" />
                        <Button onAction="#handleSupprimer" prefHeight="40.0" prefWidth="140.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="SUPPRIMER" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>