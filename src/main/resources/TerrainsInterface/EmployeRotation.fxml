<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="805.0" prefWidth="1520.0" style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Terrains.EmployeRotationController">

    <!-- ══════════════════════════════════════════════ -->
    <!-- SIDEBAR EMPLOYÉ (bleue)                        -->
    <!-- ══════════════════════════════════════════════ -->
    <!-- SIDEBAR EMPLOYÉ -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: linear-gradient(to bottom, #1a237e, #283593, #3949ab);">
            <padding><Insets bottom="20" top="20" /></padding>

            <!-- Logo -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 0 0 35 0;">
                <Label style="-fx-font-size: 32px;" text="🌱" />
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);"
                           text="AgroFlow">
                        <font><Font name="System Bold" size="26" /></font>
                    </Label>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);"
                           text="Espace Employé">
                        <font><Font name="System" size="11" /></font>
                    </Label>
                </VBox>
            </HBox>

            <!-- Info Utilisateur -->
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15;
                         -fx-padding: 20; -fx-margin: 10;">
                <Label style="-fx-font-size: 30px;" text="👤" />
                <Label fx:id="userNameLabel"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"
                       text="Nom Employé">
                    <font><Font name="System Bold" size="16" /></font>
                </Label>
                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);
                              -fx-background-color: rgba(76,175,80,0.3); -fx-padding: 4 12;
                              -fx-background-radius: 15;"
                       text="👷 EMPLOYÉ">
                    <font><Font name="System Bold" size="12" /></font>
                </Label>
            </VBox>

            <!-- Navigation Menu -->
            <VBox spacing="10" style="-fx-padding: 20 0 0 0;">

                <!-- Dashboard (actif) -->
                <Button fx:id="dashboardBtn" onMouseClicked="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1;
                               -fx-border-radius: 12;"
                        text="📊  Acceuil">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- Mes Tâches -->
                <Button  prefHeight="50" prefWidth="230"
                         style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1;
                               -fx-border-radius: 12;"
                         text="📋  Mes Tâches">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- Mon Profil -->
                <Button onMouseClicked= "#handleMonProfil" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1;
                               -fx-border-radius: 12;"
                        text="👤  Mon Profil">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <VBox spacing="0">
                    <Button onMouseClicked="#ouvrirRotations" prefHeight="48" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049);
                                   -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                            text="🌾  Mes Rotations  ">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                </VBox>
                <VBox spacing="0">
                    <Button onMouseClicked="#handleMateriel" prefHeight="48" prefWidth="230"
                            style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;
                               -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1;
                               -fx-border-radius: 12;"
                            text="  Maintenances   ">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                </VBox>

            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout -->
            <Button fx:id="logoutBtn" onMouseClicked="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12;
                           -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>
    <!-- ══════════════════════════════════════════════ -->
    <!-- CONTENU PRINCIPAL — identique à l'original    -->
    <!-- ══════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #F8F9FA; -fx-border-color: transparent;">
            <VBox spacing="25" style="-fx-background-color: #F8F9FA;">
                <padding><Insets bottom="35" left="35" right="35" top="35" /></padding>

                <!-- ── TOP BAR ── -->
                <HBox alignment="CENTER_LEFT" spacing="15"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">

                    <Button onMouseClicked="#versAccueil"
                            style="-fx-background-color: #E8EAF6; -fx-text-fill: #3949ab;
                                   -fx-cursor: hand; -fx-background-radius: 20; -fx-font-size: 12px;
                                   -fx-font-weight: bold; -fx-padding: 9 20;
                                   -fx-border-color: #9FA8DA; -fx-border-radius: 20;"
                            text="⬅  Retour Accueil">
                        <font><Font name="System Bold" size="12" /></font>
                    </Button>

                    <Region HBox.hgrow="ALWAYS" />

                    <VBox spacing="4" alignment="CENTER">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"
                               text="🔄  Mes Rotations Agricoles">
                            <font><Font name="System Bold" size="24" /></font>
                        </Label>
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D;"
                               text="Suivez l'état de vos rotations de cultures" />
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <Button onAction="#afficherStatistiquesGlobales"
                            style="-fx-background-color: linear-gradient(to right, #4A235A, #7D3C98);
                                   -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 20;
                                   -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 9 20;
                                   -fx-effect: dropshadow(gaussian, rgba(74,35,90,0.4), 6, 0, 0, 2);"
                            text="📊  Stats Globales">
                        <font><Font name="System Bold" size="12" /></font>
                    </Button>

                    <Label style="-fx-font-size: 26px;
                                  -fx-background-color: linear-gradient(to bottom right, #3949ab, #1a237e);
                                  -fx-text-fill: white; -fx-padding: 14; -fx-background-radius: 50%;
                                  -fx-min-width: 54; -fx-min-height: 54; -fx-alignment: center;" text="🔄" />
                </HBox>

                <!-- ── 4 CARDS STATS ── -->
                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                    </columnConstraints>

                    <!-- Total -->
                    <VBox spacing="10" GridPane.columnIndex="0" GridPane.rowIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
                        <Label style="-fx-font-size: 28px;
                                      -fx-background-color: linear-gradient(to bottom right, #607D8B, #455A64);
                                      -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 10;" text="🔄" />
                        <Label fx:id="nbRotationsLabel"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="...">
                            <font><Font name="System Bold" size="24" /></font>
                        </Label>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Total rotations" />
                    </VBox>

                    <!-- En cours -->
                    <VBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
                        <Label style="-fx-font-size: 28px;
                                      -fx-background-color: linear-gradient(to bottom right, #27AE60, #1E8449);
                                      -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 10;" text="✅" />
                        <Label fx:id="nbEnCoursLabel"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #27AE60;" text="...">
                            <font><Font name="System Bold" size="16" /></font>
                        </Label>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="En cours" />
                    </VBox>

                    <!-- Terminées -->
                    <VBox spacing="10" GridPane.columnIndex="2" GridPane.rowIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
                        <Label style="-fx-font-size: 28px;
                                      -fx-background-color: linear-gradient(to bottom right, #95A5A6, #7F8C8D);
                                      -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 10;" text="🏆" />
                        <Label fx:id="nbTermineesLabel"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #7F8C8D;" text="...">
                            <font><Font name="System Bold" size="16" /></font>
                        </Label>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Terminées" />
                    </VBox>

                    <!-- Planifiées -->
                    <VBox spacing="10" GridPane.columnIndex="3" GridPane.rowIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
                        <Label style="-fx-font-size: 28px;
                                      -fx-background-color: linear-gradient(to bottom right, #F39C12, #D68910);
                                      -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 10;" text="📅" />
                        <Label fx:id="nbPlanifieesLabel"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #F39C12;" text="...">
                            <font><Font name="System Bold" size="16" /></font>
                        </Label>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Planifiées" />
                    </VBox>
                </GridPane>

                <!-- ── LISTE ROTATIONS ── -->
                <VBox spacing="15"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                               text="🔄  Mes Rotations">
                            <font><Font name="System Bold" size="20" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                    </HBox>

                    <!-- ── BARRE DE RECHERCHE ── -->
                    <HBox spacing="12" alignment="CENTER_LEFT"
                          style="-fx-background-color: #F0F4FF; -fx-padding: 14;
                                 -fx-background-radius: 12; -fx-border-color: #9FA8DA;
                                 -fx-border-radius: 12; -fx-border-width: 1;">

                        <TextField fx:id="txtRecherche" prefHeight="38.0" prefWidth="320.0"
                                   promptText="🔍  Rechercher plante, terrain, statut..."
                                   style="-fx-background-color: white; -fx-border-color: #9FA8DA;
                                          -fx-border-radius: 20; -fx-background-radius: 20;
                                          -fx-font-size: 13px; -fx-padding: 0 15;" />

                        <ComboBox fx:id="comboFiltre" prefHeight="38.0" prefWidth="160.0"
                                  style="-fx-background-color: white; -fx-border-color: #9FA8DA;
                                         -fx-border-radius: 10; -fx-background-radius: 10;
                                         -fx-font-size: 13px;" />

                        <Button onAction="#reinitialiserRecherche" prefHeight="38.0"
                                style="-fx-background-color: white; -fx-text-fill: #3949ab;
                                       -fx-cursor: hand; -fx-background-radius: 20;
                                       -fx-border-color: #9FA8DA; -fx-border-radius: 20;
                                       -fx-font-size: 12px; -fx-padding: 0 16;"
                                text="↺  Reset">
                            <font><Font name="System" size="12" /></font>
                        </Button>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Légende statuts -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label style="-fx-background-color: #27AE60; -fx-text-fill: white;
                                          -fx-font-size: 10px; -fx-font-weight: bold;
                                          -fx-padding: 3 10; -fx-background-radius: 15;" text="🔄 En cours" />
                            <Label style="-fx-background-color: #95A5A6; -fx-text-fill: white;
                                          -fx-font-size: 10px; -fx-font-weight: bold;
                                          -fx-padding: 3 10; -fx-background-radius: 15;" text="✅ Terminée" />
                            <Label style="-fx-background-color: #F39C12; -fx-text-fill: white;
                                          -fx-font-size: 10px; -fx-font-weight: bold;
                                          -fx-padding: 3 10; -fx-background-radius: 15;" text="📅 Planifiée" />
                        </HBox>
                    </HBox>

                    <!-- Rempli dynamiquement -->
                    <VBox fx:id="rotationsContainer" spacing="12" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>