<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<BorderPane prefHeight="805.0" prefWidth="1520.0" style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Terrains.agricoleplanteController">

    <!-- ══════════════════════════════════════════════ -->
    <!-- SIDEBAR                                        -->
    <!-- ══════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: linear-gradient(to bottom, #2E7D32, #388E3C, #43A047);">
            <padding><Insets bottom="20" top="20" /></padding>

            <!-- Logo -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 0 0 20 0;">
                <Label style="-fx-font-size: 32px;" text="🌱" />
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;" text="AgroFlow">
                        <font><Font name="System Bold" size="26" /></font>
                    </Label>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);" text="Mon Exploitation">
                        <font><Font name="System" size="11" /></font>
                    </Label>
                </VBox>
            </HBox>

            <!-- Info Utilisateur avec Hyperlink À Propos -->
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15; -fx-padding: 20; -fx-margin: 10;">

                <!-- Avatar circulaire -->
                <StackPane>
                    <!-- Fond dégradé (visible par défaut) -->
                    <Circle fx:id="sidebarAvatarBg" radius="35"
                            fill="rgba(255,255,255,0.2)" />
                    <!-- Emoji par défaut -->
                    <Label fx:id="sidebarAvatarDefault"
                           style="-fx-font-size: 30px;"
                           text="👨‍🌾" />
                    <!-- Photo Cloudinary (cachée par défaut, clip appliqué en Java) -->
                    <ImageView fx:id="sidebarAvatarImageView"
                               fitWidth="70" fitHeight="70"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>

                <Label fx:id="userNameLabel"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"
                       text="Nom Agriculteur">
                    <font><Font name="System Bold" size="16" /></font>
                </Label>
                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);
                  -fx-background-color: rgba(76,175,80,0.3); -fx-padding: 4 12;
                  -fx-background-radius: 15;"
                       text="🌾 AGRICULTEUR">
                    <font><Font name="System Bold" size="12" /></font>
                </Label>
                <!-- Hyperlink À Propos -->
                <Hyperlink fx:id="aproposLink" text="👤 À propos de moi"
                           onMouseClicked="#handleAPropos"
                           style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13px;
                      -fx-border-color: rgba(255,255,255,0.4); -fx-padding: 5 15;
                      -fx-background-radius: 20; -fx-border-radius: 20;
                      -fx-cursor: hand;">
                    <font><Font name="System" size="13" /></font>
                </Hyperlink>
            </VBox>

            <!-- Navigation Menu -->
            <VBox spacing="8" style="-fx-padding: 20 0 0 0;">
                <Button onMouseClicked="#handleDashboard" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- Mes Terrains avec sous-menu (ouvert par défaut ici) -->
                <VBox spacing="0">
                    <Button onAction="#handleMesTerrains" prefHeight="48" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049);
                                   -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                            text="🌾  Mes Terrains  ▾">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>
                    <!-- Sous-menu Terrains -->
                    <VBox fx:id="terrainsSubMenu" spacing="2" style="-fx-padding: 4 0 0 0;" visible="true" managed="true">
                        <Button onMouseClicked="#ouvrirTerrains" prefHeight="40" prefWidth="230"
                                style="-fx-background-color: rgba(0,0,0,0.20); -fx-text-fill: white;
                                       -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 40;
                                       -fx-background-radius: 10; -fx-cursor: hand;"
                                text="🚜  Terrains">
                            <font><Font name="System Bold" size="13" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirPlantes" prefHeight="40" prefWidth="230"
                                style="-fx-background-color: rgba(0,0,0,0.15); -fx-text-fill: rgba(255,255,255,0.9);
                                       -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 40;
                                       -fx-background-radius: 10; -fx-cursor: hand;"
                                text="🌱  Plantes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirRotations" prefHeight="40" prefWidth="230"
                                style="-fx-background-color: rgba(0,0,0,0.15); -fx-text-fill: rgba(255,255,255,0.9);
                                       -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 40;
                                       -fx-background-radius: 10; -fx-cursor: hand;"
                                text="📋  Rotations">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <Button onAction="#handleMesAnimaux" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Mes Animaux">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
                <Button onAction="#handleMesStocks" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Mes Stocks">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
                <Button onAction="#handleMonMateriel" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🚜  Mon Matériel">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
                <Button onMouseClicked="#handleMonAbonnement" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="💳  Mes Abonnements">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12;
                           -fx-cursor: hand;"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>
    <!-- ══════════════════════════════════════════════ -->
    <!-- CONTENU PRINCIPAL                              -->
    <!-- ══════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #F8F9FA; -fx-border-color: transparent;">
            <VBox spacing="25" style="-fx-background-color: #F8F9FA;">
                <padding><Insets bottom="35" left="35" right="35" top="35" /></padding>

                <!-- ── TOP BAR ── -->
                <HBox alignment="CENTER_LEFT" spacing="15"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">

                    <!-- BOUTON RETOUR -->
                    <Button onAction="#versAccueilAgricole"
                            style="-fx-background-color: #EAF5EA; -fx-text-fill: #2D5A27;
                                   -fx-cursor: hand; -fx-background-radius: 20; -fx-font-size: 12px;
                                   -fx-font-weight: bold; -fx-padding: 9 20;
                                   -fx-border-color: #A8C69F; -fx-border-radius: 20;
                                   -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 4, 0, 0, 1);"
                            text="⬅  Retour Accueil">
                        <font><Font name="System Bold" size="12" /></font>
                    </Button>

                    <Region HBox.hgrow="ALWAYS" />

                    <VBox spacing="4" alignment="CENTER">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"
                               text="🌱  Mes Plantes Agricoles">
                            <font><Font name="System Bold" size="24" /></font>
                        </Label>
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D;"
                               text="Consultez vos cultures et recommandations d'arrosage" />
                    </VBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <!-- BOUTON STATS GLOBALES -->
                    <Button onAction="#afficherStatistiquesGlobales"
                            style="-fx-background-color: linear-gradient(to right, #4A235A, #7D3C98);
                                   -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 20;
                                   -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 9 20;
                                   -fx-effect: dropshadow(gaussian, rgba(74,35,90,0.4), 6, 0, 0, 2);"
                            text="📊  Stats Globales">
                        <font><Font name="System Bold" size="12" /></font>
                    </Button>

                    <Label style="-fx-font-size: 26px; -fx-background-color: linear-gradient(to bottom right, #4CAF50, #388E3C);
                                  -fx-text-fill: white; -fx-padding: 14; -fx-background-radius: 50%;
                                  -fx-min-width: 54; -fx-min-height: 54; -fx-alignment: center;" text="🌱" />
                </HBox>

                <!-- ── 4 CARDS STATS ── -->
                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25" />
                    </columnConstraints>

                    <!-- Total Plantes -->
                    <VBox spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
                        <Label style="-fx-font-size: 30px;
                                      -fx-background-color: linear-gradient(to bottom right, #8BC34A, #689F38);
                                      -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 10;" text="🌱" />
                        <Label fx:id="nbPlantesLabel"
                               style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="...">
                            <font><Font name="System Bold" size="24" /></font>
                        </Label>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Total plantes" />
                    </VBox>

                    <!-- Besoin faible -->
                    <VBox spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
                        <Label style="-fx-font-size: 30px;
                                      -fx-background-color: linear-gradient(to bottom right, #F39C12, #E67E22);
                                      -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 10;" text="🌵" />
                        <Label fx:id="nbFaibleEauLabel"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="...">
                            <font><Font name="System Bold" size="16" /></font>
                        </Label>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Faible besoin eau" />
                    </VBox>

                    <!-- Besoin moyen -->
                    <VBox spacing="12" GridPane.columnIndex="2" GridPane.rowIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
                        <Label style="-fx-font-size: 30px;
                                      -fx-background-color: linear-gradient(to bottom right, #27AE60, #1E8449);
                                      -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 10;" text="💧" />
                        <Label fx:id="nbMoyenEauLabel"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="...">
                            <font><Font name="System Bold" size="16" /></font>
                        </Label>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Besoin moyen" />
                    </VBox>

                    <!-- Besoin élevé -->
                    <VBox spacing="12" GridPane.columnIndex="3" GridPane.rowIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 14; -fx-padding: 20;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 12, 0, 0, 3);">
                        <Label style="-fx-font-size: 30px;
                                      -fx-background-color: linear-gradient(to bottom right, #2E86C1, #1A5276);
                                      -fx-text-fill: white; -fx-padding: 10; -fx-background-radius: 10;" text="💧💧" />
                        <Label fx:id="nbEleveEauLabel"
                               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="...">
                            <font><Font name="System Bold" size="16" /></font>
                        </Label>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Besoin élevé" />
                    </VBox>
                </GridPane>

                <!-- ── LISTE PLANTES ── -->
                <VBox spacing="15"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                               text="🌱  Mes Plantes">
                            <font><Font name="System Bold" size="20" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />

                    </HBox>

                    <!-- Rempli dynamiquement -->
                    <VBox fx:id="plantesContainer" spacing="12" />
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
