<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="700" prefWidth="1200" style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Terrains.ModifierRotationAgriculteurController">
    <center>
        <VBox alignment="TOP_CENTER" spacing="25" style="-fx-padding: 35;">
            <Label text="✏️ Modifier une Rotation (Agriculteur)"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;" />
            <GridPane hgap="15" vgap="18" maxWidth="760"
                      style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 14;">
                <columnConstraints>
                    <ColumnConstraints minWidth="220"/>
                    <ColumnConstraints minWidth="460"/>
                </columnConstraints>
                <Label text="Terrain" GridPane.rowIndex="0"/>
                <ComboBox fx:id="comboTerrain" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Plante" GridPane.rowIndex="1"/>
                <ComboBox fx:id="comboPlante" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Date début" GridPane.rowIndex="2"/>
                <DatePicker fx:id="dateDebut" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Date fin" GridPane.rowIndex="3"/>
                <DatePicker fx:id="dateFin" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="Statut" GridPane.rowIndex="4"/>
                <ComboBox fx:id="comboStatus" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            </GridPane>
            <HBox alignment="CENTER" spacing="14">
                <Button text="✓ ENREGISTRER" onAction="#handleModifier"
                        style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 28;"/>
                <Button text="↩ RETOUR" onAction="#retourListe"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 10 28;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
