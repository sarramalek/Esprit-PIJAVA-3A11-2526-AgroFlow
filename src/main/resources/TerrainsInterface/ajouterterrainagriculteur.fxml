<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<BorderPane prefHeight="700" prefWidth="1200" style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Terrains.AjoutTerrainAgriculteurController">
    <center>
        <VBox alignment="TOP_CENTER" spacing="25" style="-fx-padding: 35;">
            <Label text="🌾 Ajouter un Terrain (Agriculteur)"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;" />
            <GridPane hgap="15" vgap="18" maxWidth="700"
                      style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 14;">
                <padding><Insets top="10" /></padding>
                <columnConstraints>
                    <ColumnConstraints minWidth="220"/>
                    <ColumnConstraints minWidth="420"/>
                </columnConstraints>
                <Label text="Nom terrain" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNom" promptText="Ex: Parcelle Nord" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Surface (m²)" GridPane.rowIndex="1"/>
                <TextField fx:id="txtSurface" promptText="Ex: 150.5" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Type de sol" GridPane.rowIndex="2"/>
                <ComboBox fx:id="comboTypeSol" promptText="Choisir" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Localisation" GridPane.rowIndex="3"/>
                <TextField fx:id="txtLocalisation" promptText="Ex: Ariana - Raoued" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Label text="pH" GridPane.rowIndex="4"/>
                <TextField fx:id="txtPH" promptText="Entre 0 et 14" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            </GridPane>
            <HBox alignment="CENTER" spacing="14">
                <Button text="✓ AJOUTER" onAction="#ajouterTerrain"
                        style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 28;"/>
                <Button text="↩ RETOUR" onAction="#retourListe"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 10 28;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
