<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<BorderPane prefHeight="700" prefWidth="1200" style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Terrains.AjoutPlanteAgriculteurController">
    <center>
        <VBox alignment="TOP_CENTER" spacing="25" style="-fx-padding: 35;">
            <Label text="🌱 Ajouter une Plante (Agriculteur)"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;" />
            <GridPane hgap="15" vgap="18" maxWidth="700"
                      style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 14;">
                <columnConstraints>
                    <ColumnConstraints minWidth="220"/>
                    <ColumnConstraints minWidth="420"/>
                </columnConstraints>
                <Label text="Nom plante" GridPane.rowIndex="0"/>
                <TextField fx:id="txtNom" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Variété" GridPane.rowIndex="1"/>
                <TextField fx:id="txtVariete" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Label text="Besoin eau (L/j)" GridPane.rowIndex="2"/>
                <TextField fx:id="txtBesoinEau" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Label text="Cycle (jours)" GridPane.rowIndex="3"/>
                <TextField fx:id="txtCycle" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            </GridPane>
            <HBox alignment="CENTER" spacing="14">
                <Button text="✓ AJOUTER" onAction="#ajouterPlante"
                        style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10 28;"/>
                <Button text="↩ RETOUR" onAction="#retourListe"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-padding: 10 28;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
