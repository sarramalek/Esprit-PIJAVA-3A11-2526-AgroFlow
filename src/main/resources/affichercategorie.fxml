<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox prefHeight="650.0" prefWidth="1050.0" style="-fx-background-color: #fdfae7;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.affichercategorieController">
    <children>
        <VBox prefWidth="250.0" spacing="5.0" style="-fx-background-color: #34495e;">
            <children>
                <Label text="AGROFLOW" textFill="WHITE">
                    <font><Font name="System Bold" size="24.0" /></font>
                    <VBox.margin><Insets bottom="20.0" left="20.0" top="30.0" /></VBox.margin>
                </Label>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;" text="🐾  Gestion Animaux">
                    <padding><Insets left="20.0" /></padding>
                </Button>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;" text="🚜  Gestion Matériels">
                    <padding><Insets left="20.0" /></padding>
                </Button>

                <VBox spacing="0.0" style="-fx-background-color: #2c3e50;">
                    <children>
                        <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-weight: bold;" text="📦  Gestion Stocks">
                            <padding><Insets left="20.0" /></padding>
                        </Button>
                        <Button alignment="BASELINE_LEFT" onAction="#allerVersArticles" maxWidth="Infinity" prefHeight="35.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;" text="      • Gestion Articles">
                            <padding><Insets left="20.0" /></padding>
                        </Button>
                        <Button alignment="BASELINE_LEFT" onAction="#allerVersCategories" maxWidth="Infinity" prefHeight="35.0" style="-fx-background-color: #2d5a27; -fx-text-fill: white;" text="      • Gestion Catégories">
                            <padding><Insets left="20.0" /></padding>
                        </Button>
                    </children>
                </VBox>

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;" text="🌱  Gestion Terrains">
                    <padding><Insets left="20.0" /></padding>
                </Button>

                <Pane VBox.vgrow="ALWAYS" />

                <Button alignment="CENTER" onAction="#deconnexion" maxWidth="Infinity" prefHeight="45.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Déconnexion">
                    <VBox.margin><Insets bottom="10.0" /></VBox.margin>
                </Button>
            </children>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" spacing="15.0" style="-fx-padding: 30;">
            <children>
                <Label text="Gestion des Catégories" textFill="#2d5a27">
                    <font><Font name="System Bold" size="28.0" /></font>
                </Label>

                <HBox alignment="CENTER_LEFT" prefHeight="75.0" spacing="15.0" style="-fx-background-color: rgba(52, 73, 94, 0.08); -fx-background-radius: 12; -fx-border-color: rgba(52, 73, 94, 0.15); -fx-border-radius: 12;">
                    <padding><Insets left="15.0" right="15.0" /></padding>
                    <children>
                        <Button onAction="#ouvrirFormulaireAjout" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #2d5a27; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="+ AJOUTER" />
                        <Button onAction="#modifierCategorie" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="✏ MODIFIER" />
                        <Button onAction="#supprimerCategorie" prefHeight="35.0" prefWidth="120.0" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="🗑 SUPPRIMER" />
                    </children>
                </HBox>

                <TableView fx:id="tableCategories" prefHeight="450.0" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-background-insets: 0;">
                    <columns>
                        <TableColumn fx:id="colImage" prefWidth="80.0" text="Aperçu" />

                        <TableColumn fx:id="colNom" prefWidth="150.0" text="Nom (FR)" />
                        <TableColumn fx:id="colNomEn" prefWidth="150.0" text="Nom (EN) 🇬🇧" />
                        <TableColumn fx:id="colNomAr" prefWidth="150.0" text="Nom (AR) 🇹🇳" />
                        <TableColumn fx:id="colDescription" prefWidth="300.0" text="Description détaillée" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </children>
</HBox>