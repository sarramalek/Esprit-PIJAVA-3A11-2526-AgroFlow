<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.text.Font?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>
<BorderPane prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #ecf0f1;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Materiels.AfficherAchatsController">

    <!-- SIDEBAR MODERNISÉE -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color:  #617e9c;">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Logo/Header MODERNE -->
            <StackPane prefWidth="100" prefHeight="100"  >
                <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                    <image><Image url="/style/logo.png"/></image>
                </ImageView>

            </StackPane>
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Navigation Menu MODERNISÉE -->
            <VBox spacing="10">
                <!-- Dashboard -->
                <Button fx:id="dashboardBtn" onMouseClicked="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- GESTION PRINCIPALE avec sous-menu -->
                <VBox fx:id="gestionContainer" prefWidth="230" spacing="5" style="-fx-background-radius: 12;">
                    <Button fx:id="gestionBtn"  prefHeight="50" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"
                            text="⚙️  Gestion Utilisateurs">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                    <!-- Sous-menu MODERNE -->
                    <VBox fx:id="gestionSubmenu" spacing="3" style="-fx-padding: 5 0 5 15; -fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 0 0 12 12;">
                        <Button fx:id="personnesBtn" onMouseClicked="#handlePersonnes" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"
                                text="👥  Personnes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="tachesBtn" onMouseClicked="#handleTaches" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="✓  Tâches">
                            <font><Font name="System" size="13" /></font>
                        </Button>

                        <Button fx:id="abonnementsBtn" onMouseClicked="#handleAbonnements" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="💳  Abonnements">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="offresBtn" onMouseClicked="#handleOffres" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🎁  Offres">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Autres boutons MODERNISÉS -->
                <Button fx:id="stocksBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleStocks"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="terrainsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleTerrains"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Terrains">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="animauxBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleAnimals"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Animaux">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="materielBtn" prefHeight="48" prefWidth="230 " onMouseClicked="#handleMateriels"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🔧  Matériel">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="evenementsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleEvents"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🎉  Événements">
                    <font><Font name="System" size="14" /></font>
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout Button MODERNISÉ -->
            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>
    <!-- ================= CENTER ================= -->
    <center>
        <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #fcf8e6;">
            <HBox alignment="CENTER" spacing="12" style="-fx-cursor: hand;" onMouseClicked="#handleMonProfil">
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="userNameLabel" style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Admin">
                        <font><Font name="System Bold" size="15" /></font>
                    </Label>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" text="Administrateur">
                        <font><Font name="System" size="11" /></font>
                    </Label>
                </VBox>

                <!-- Avatar circulaire : photo si disponible, sinon emoji 👤 -->
                <StackPane>
                    <!-- Fond dégradé (visible si pas de photo) -->
                    <Circle fx:id="avatarBg" radius="24"
                            fill="linear-gradient(to bottom right, #667eea, #764ba2)" />
                    <!-- Emoji par défaut -->
                    <Label fx:id="avatarDefaultLabel"
                           style="-fx-font-size: 22px; -fx-text-fill: white;"
                           text="👤" />
                    <!-- Photo chargée depuis Cloudinary (clip appliqué en Java) -->
                    <ImageView fx:id="avatarImageView"
                               fitWidth="48" fitHeight="48"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>
            </HBox>
            <!-- En-tête -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="← Retour" onAction="#retourAccueil"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-padding: 10 20;
                               -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Label text="Gestion des Achats"
                       style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </HBox>

            <Separator/>

            <!-- ══ ZONE RECHERCHE/FILTRES ══ -->
            <VBox spacing="8"
                  style="-fx-background-color: #fcf8e6; -fx-padding: 12 16;
                         -fx-background-radius: 10; -fx-border-color: #e0d9c0;
                         -fx-border-width: 1; -fx-border-radius: 10;">

                <!-- Ligne 1 : Recherche | Export -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🔍 Recherche :"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;"/>
                    <TextField fx:id="champRecherche"
                               promptText="Machine, client, CIN, date, quantité..."
                               prefWidth="360" prefHeight="36"
                               style="-fx-background-color: white; -fx-border-color: #c8b99a;
                                      -fx-border-width: 1.5; -fx-border-radius: 6;
                                      -fx-background-radius: 6; -fx-padding: 6 10; -fx-font-size: 13px;"/>
                    <Button text="✕  Effacer" onAction="#effacerRecherche" prefHeight="36"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 16;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="📄  Export PDF" onAction="#exporterPDF" prefHeight="36"
                            style="-fx-background-color: #c0392b; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 18;"/>
                    <Button text="📊  Export Excel" onAction="#exporterExcel" prefHeight="36"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 18;"/>
                </HBox>

                <!-- Ligne 2 : Filtres machine + tri date -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="⚡ Filtrer par Machine :"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;"/>
                    <ComboBox fx:id="comboMachine" prefWidth="200" prefHeight="34"
                              onAction="#filtrer"
                              style="-fx-background-radius: 6; -fx-font-size: 12px;"/>
                    <Label text="📅 Trier par dat. :"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1e3a5f;"/>
                    <Button text="▲  Plus récent" onAction="#trierPlusRecent" prefHeight="34"
                            style="-fx-background-color: #8e44ad; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 14;"/>
                    <Button text="▼  Plus ancien" onAction="#trierPlusAncien" prefHeight="34"
                            style="-fx-background-color: #7f8c8d; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 14;"/>
                    <Button text="↑  Actualiser" onAction="#actualiser" prefHeight="34"
                            style="-fx-background-color: #2980b9; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 14;"/>
                    <Button text="📊 Statistiques" onAction="#afficherStatistiques" prefHeight="34"
                            style="-fx-background-color: #9b59b6; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-background-radius: 6; -fx-cursor: hand; -fx-padding: 0 12;"/>
                </HBox>

            </VBox>

            <!-- ====== TABLEAU ====== -->
            <TableView fx:id="tableAchats" VBox.vgrow="ALWAYS" prefHeight="380"
                       style="-fx-background-color: white; -fx-border-color: #e2e8f0;
                              -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="colDateAchat" text="Date Achat" prefWidth="130" minWidth="110"/>
                    <TableColumn fx:id="colQuantite"  text="Quantite"   prefWidth="100" minWidth="80"/>
                    <TableColumn fx:id="colMachine"   text="Machine"    prefWidth="230" minWidth="160"/>
                    <TableColumn fx:id="colClient"    text="Client"     prefWidth="210" minWidth="150"/>
                    <TableColumn fx:id="colCin"       text="CIN"        prefWidth="110" minWidth="90"/>
                </columns>
                <placeholder>
                    <Label text="Aucun achat enregistre"
                           style="-fx-text-fill: #95a5a6; -fx-font-style: italic;
                                  -fx-font-size: 14px; -fx-padding: 40;"/>
                </placeholder>
            </TableView>

            <!-- ====== STATS ====== -->
            <HBox spacing="20" alignment="CENTER">
                <HBox alignment="CENTER_LEFT" spacing="15"
                      style="-fx-background-color: #fcf8e6; -fx-padding: 12 28;
                             -fx-border-color: #3498db; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <VBox spacing="2">
                        <Label text="Total Achats"
                               style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                        <Label fx:id="lblTotal" text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                    </VBox>
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="15"
                      style="-fx-background-color: #fcf8e6; -fx-padding: 12 28;
                             -fx-border-color: #27ae60; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <VBox spacing="2">
                        <Label text="Quantite Totale"
                               style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                        <Label fx:id="lblQuantiteTotal" text="0"
                               style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    </VBox>
                </HBox>
            </HBox>

            <!-- ====== BOUTONS CRUD EN BAS ====== -->
            <HBox spacing="15" alignment="CENTER"
                  style="-fx-background-color: #fcf8e6; -fx-padding: 14 20;
                         -fx-background-radius: 8; -fx-border-color: #e0d9c0;
                         -fx-border-width: 1; -fx-border-radius: 8;">
                <Button text="➕  Ajouter" onAction="#ouvrirAjout"
                        prefWidth="180" prefHeight="42"
                        style="-fx-background-color: #27ae60; -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button text="✏️  Modifier" onAction="#modifierSelectionne"
                        prefWidth="180" prefHeight="42"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-cursor: hand;"/>
                <Button text="🗑️  Supprimer" onAction="#supprimerSelectionne"
                        prefWidth="180" prefHeight="42"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-font-weight: bold;
                               -fx-background-radius: 8; -fx-cursor: hand;"/>
            </HBox>

        </VBox>
    </center>
</BorderPane>
