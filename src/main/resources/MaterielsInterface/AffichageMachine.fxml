<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #fcf8e6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Materiels.AfficherMachinesController">

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox prefWidth="230.0" spacing="5.0" style="-fx-background-color: #2C3E50; -fx-padding: 15;">
            <children>
                <Text fill="WHITE" text="AGROFLOW">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Text>
                <Separator opacity="0.2" prefHeight="20.0" />

                <Button onAction="#naviguerAnimaux" maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="🐾 Gestion Animaux" />

                <Button onAction="#naviguerMateriels" maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                        style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-cursor: hand;" text="⚙️ Gestion Matériels" />

                <Button onAction="#naviguerStocks" maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="📦 Gestion Stocks" />

                <Button onAction="#naviguerTerrains" maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="🌱 Gestion Terrains" />

                <Button onAction="#naviguerEvenements" maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="📅 Événements" />

                <Button onAction="#naviguerUsers" maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="👥 Utilisateurs" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator opacity="0.1" />
                <Button maxWidth="Infinity" style="-fx-background-color: #E74C3C; -fx-text-fill: white;" text="Déconnexion" />
            </children>
        </VBox>
    </left>

    <!-- ================= CENTER ================= -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 30;">
            <children>

                <!-- En-tête avec bouton retour et titre -->
                <HBox alignment="CENTER_LEFT" spacing="15">
                    <children>
                        <Button text="← Retour"
                                onAction="#retourAccueil"
                                style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 8 15; -fx-cursor: hand;"/>

                        <Region HBox.hgrow="ALWAYS" />

                        <Text fill="#2C3E50" text="Gestion des Machines">
                            <font><Font name="System Bold" size="24.0" /></font>
                        </Text>

                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>

                <!-- Table des machines -->
                <TableView fx:id="tableMachines" prefHeight="380.0" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 1;">
                    <columns>
                        <TableColumn fx:id="colMarque" prefWidth="110.0" text="Marque" />
                        <TableColumn fx:id="colModele" prefWidth="110.0" text="Modèle" />
                        <TableColumn fx:id="colEtat" prefWidth="100.0" text="État" />
                        <TableColumn fx:id="colNumeroSerie" prefWidth="120.0" text="N° Série" />
                        <TableColumn fx:id="colDateAchat" prefWidth="100.0" text="Date Achat" />
                        <TableColumn fx:id="colNom" prefWidth="110.0" text="Nom" />
                    </columns>
                </TableView>

                <!-- Boutons d'action -->
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button onAction="#versAjout" prefHeight="40.0" prefWidth="140.0"
                                style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;"
                                text="+ AJOUTER" />

                        <Button onAction="#versModifier" prefHeight="40.0" prefWidth="140.0"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;"
                                text="✏️ MODIFIER" />

                        <Button onAction="#handleSupprimer" prefHeight="40.0" prefWidth="140.0"
                                style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 14px;"
                                text="🗑️ SUPPRIMER" />
                    </children>
                </HBox>

            </children>
        </VBox>
    </center>

</BorderPane>