<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Materiels.MaintenanceFrontController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: linear-gradient(to bottom, #1a237e, #283593, #3949ab);">
            <padding><Insets bottom="20" top="20" /></padding>

            <StackPane prefWidth="100" prefHeight="100">
                <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                    <Image url="/style/logo.png"/>
                </ImageView>
            </StackPane>

            <VBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15;
                         -fx-padding: 20;">

                <StackPane prefWidth="64" prefHeight="64">
                    <Circle fx:id="avatarBg" radius="32" fill="rgba(255,255,255,0.25)" />
                    <Label fx:id="avatarDefaultLabel" text="👤" style="-fx-font-size: 30px;" />
                    <ImageView fx:id="avatarImageView" fitWidth="64" fitHeight="64"
                               preserveRatio="false" visible="false" managed="false" />
                </StackPane>

                <Label fx:id="userNameLabel"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"
                       text="Nom Employé">
                    <font><Font name="System Bold" size="16" /></font>
                </Label>
                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);
                              -fx-background-color: rgba(76,175,80,0.3); -fx-padding: 4 12;
                              -fx-background-radius: 15;"
                       text="👷 EMPLOYÉ">
                    <font><Font name="System Bold" size="12" /></font>
                </Label>
            </VBox>

            <VBox spacing="10" style="-fx-padding: 20 0 0 0;">
                <Button onMouseClicked="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📊  Accueil"/>

                <Button onMouseClicked="#handleMesTaches" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📋  Mes Tâches"/>

                <Button onMouseClicked="#handleMonProfil" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="👤  Mon Profil"/>

                <Button onMouseClicked="#ouvrirRotations" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Mes Rotations"/>

                <Button onMouseClicked="#handleMateriel" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049);
                               -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🔧  Maintenances"/>

                <Button onMouseClicked="#handleEvenements" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🎉  Événements"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button onMouseClicked="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12;
                           -fx-cursor: hand;"
                    text="🚪  Déconnexion"/>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="14" style="-fx-padding: 30; -fx-background-color: #fcf8e6;">

            <!-- En-tête -->
            <HBox alignment="CENTER_LEFT" spacing="14"
                  style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">
                <Label text="🔧  Historique des Maintenances"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
                <Region HBox.hgrow="ALWAYS" />

                <Button text="🔄 Actualiser" onAction="#actualiser"
                        style="-fx-background-color: #3949ab; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 9 20;"/>

                <Button text="📄 Export PDF" onAction="#exporterPDF"
                        style="-fx-background-color: #c0392b; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 9 20;"/>

                <Button text="📈 Statistiques" onAction="#ouvrirStatistiquesDetaillees"
                        style="-fx-background-color: #8e44ad; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-font-weight: bold;
                               -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 9 20;"/>
            </HBox>

            <!-- Panneau Recherche / Filtres -->
            <VBox spacing="10"
                  style="-fx-background-color: #F0F4FF; -fx-padding: 14 16;
                         -fx-background-radius: 12; -fx-border-color: #9FA8DA;
                         -fx-border-width: 1; -fx-border-radius: 12;">

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="🔍 Recherche :"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
                    <TextField fx:id="champRecherche"
                               promptText="Machine, type panne, description, statut, priorité..."
                               prefWidth="380" prefHeight="38"
                               onKeyReleased="#appliquerFiltres"
                               style="-fx-padding: 0 15; -fx-background-radius: 20;
                                      -fx-border-color: #9FA8DA; -fx-border-radius: 20;
                                      -fx-border-width: 1.5; -fx-font-size: 13px;
                                      -fx-background-color: white;"/>
                    <Button text="✕ Effacer" onAction="#effacerRecherche"
                            prefHeight="38"
                            style="-fx-background-color: #E74C3C; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 0 16;"/>
                </HBox>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="⚡ Machine :" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
                    <ComboBox fx:id="comboMachine" promptText="Toutes les machines"
                              prefWidth="170" prefHeight="36"
                              onAction="#appliquerFiltres"
                              style="-fx-background-radius: 10; -fx-font-size: 12px;
                                     -fx-background-color: white; -fx-border-color: #9FA8DA;
                                     -fx-border-radius: 10;"/>

                    <Label text="🔧 Type Panne :" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
                    <ComboBox fx:id="comboTypePanne" promptText="Tous les types"
                              prefWidth="160" prefHeight="36"
                              onAction="#appliquerFiltres"
                              style="-fx-background-radius: 10; -fx-font-size: 12px;
                                     -fx-background-color: white; -fx-border-color: #9FA8DA;
                                     -fx-border-radius: 10;"/>

                    <Label text="📊 Statut :" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
                    <ComboBox fx:id="comboStatut" promptText="Tous les statuts"
                              prefWidth="140" prefHeight="36"
                              onAction="#appliquerFiltres"
                              style="-fx-background-radius: 10; -fx-font-size: 12px;
                                     -fx-background-color: white; -fx-border-color: #9FA8DA;
                                     -fx-border-radius: 10;"/>

                    <Label text="⚠️ Priorité :" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"/>
                    <ComboBox fx:id="comboPriorite" promptText="Toutes priorités"
                              prefWidth="130" prefHeight="36"
                              onAction="#appliquerFiltres"
                              style="-fx-background-radius: 10; -fx-font-size: 12px;
                                     -fx-background-color: white; -fx-border-color: #9FA8DA;
                                     -fx-border-radius: 10;"/>

                    <Button text="↺ Réinit." onAction="#reinitialiserFiltres" prefHeight="36"
                            style="-fx-background-color: #1a237e; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 0 14;"/>
                </HBox>
            </VBox>

            <!-- Zone des cartes avec ScrollPane -->
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                        style="-fx-background: transparent; -fx-background-color: transparent;
                               -fx-border-color: transparent;">
                <VBox spacing="15" style="-fx-padding: 5;">
                    <TilePane fx:id="cardsContainer"
                              prefColumns="2" maxWidth="Infinity"
                              hgap="15" vgap="15"
                              alignment="CENTER"
                              style="-fx-background-color: transparent;"/>
                </VBox>
            </ScrollPane>

            <!-- Cartes statistiques -->
            <HBox spacing="12" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                <VBox alignment="CENTER" spacing="6" prefHeight="85"
                      style="-fx-background-color: white; -fx-padding: 12 10;
                             -fx-border-color: #3498db; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 12;"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="📋 Total Maintenances" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Label fx:id="lblTotal" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="6" prefHeight="85"
                      style="-fx-background-color: white; -fx-padding: 12 10;
                             -fx-border-color: #e74c3c; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 12;"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="💰 Coût Total" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Label fx:id="lblCoutTotal" text="0,00 DT" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="6" prefHeight="85"
                      style="-fx-background-color: white; -fx-padding: 12 10;
                             -fx-border-color: #f39c12; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 12;"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="📊 Coût Moyen" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Label fx:id="lblCoutMoyen" text="0,00 DT" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="6" prefHeight="85"
                      style="-fx-background-color: white; -fx-padding: 12 10;
                             -fx-border-color: #27ae60; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 12;"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="🏆 Machine + Coûteuse" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Label fx:id="lblMachineCouteuse" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="6" prefHeight="85"
                      style="-fx-background-color: white; -fx-padding: 12 10;
                             -fx-border-color: #9b59b6; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 12;"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="🔧 Type Dominant" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Label fx:id="lblTypeDominant" text="-" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="6" prefHeight="85"
                      style="-fx-background-color: white; -fx-padding: 12 10;
                             -fx-border-color: #1abc9c; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 12;"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="🔎 Résultats affichés" style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Label fx:id="lblFiltres" text="0" style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #1abc9c;"/>
                </VBox>
            </HBox>

        </VBox>
    </center>

</BorderPane>