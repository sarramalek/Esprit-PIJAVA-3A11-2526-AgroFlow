<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="700.0" prefWidth="1000.0"
            style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Materiels.AjoutMachineController">

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <VBox spacing="20.0" style="-fx-padding: 30;" alignment="TOP_CENTER">

                <!-- Titre -->
                <Text fill="#2C3E50" text="➕ Ajouter une Machine">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Text>

                <!-- Formulaire dans un conteneur blanc -->
                <VBox spacing="0" alignment="CENTER" maxWidth="800.0">
                    <children>
                        <GridPane hgap="20.0" vgap="15.0"
                                  style="-fx-background-color: white;
                                        -fx-padding: 40;
                                        -fx-background-radius: 15;
                                        -fx-border-color: #e0d9c0;
                                        -fx-border-width: 1;
                                        -fx-border-radius: 15;
                                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                            <columnConstraints>
                                <ColumnConstraints minWidth="160.0" prefWidth="160.0" />
                                <ColumnConstraints minWidth="280.0" prefWidth="320.0" />
                                <ColumnConstraints minWidth="160.0" prefWidth="160.0" />
                                <ColumnConstraints minWidth="280.0" prefWidth="320.0" />
                            </columnConstraints>

                            <!-- LIGNE 1 : Marque -->
                            <Label text="🔧 Marque :" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfMarque" promptText="Ex: John Deere, New Holland..."
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #bdc3c7;"/>

                            <!-- LIGNE 1 : Modèle -->
                            <Label text="📐 Modèle :" GridPane.columnIndex="2" GridPane.rowIndex="0"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfModele" promptText="Ex: 5075E, T7.210..."
                                       GridPane.columnIndex="3" GridPane.rowIndex="0"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #bdc3c7;"/>

                            <!-- LIGNE 2 : État -->
                            <Label text="📊 État :" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <ComboBox fx:id="cbEtat" promptText="Sélectionnez un état"
                                      GridPane.columnIndex="1" GridPane.rowIndex="1"
                                      style="-fx-font-size: 14px; -fx-padding: 5;"/>

                            <!-- LIGNE 2 : Numéro de série -->
                            <Label text="🔢 N° Série :" GridPane.columnIndex="2" GridPane.rowIndex="1"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfNumeroSerie" promptText="Ex: JD5075E-2024-001"
                                       GridPane.columnIndex="3" GridPane.rowIndex="1"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #bdc3c7;"/>

                            <!-- LIGNE 3 : Nom de la machine -->
                            <Label text="🏷️ Nom :" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfNom" promptText="Ex: Tracteur Principal, Moissonneuse..."
                                       GridPane.columnIndex="1" GridPane.rowIndex="2"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #bdc3c7;"/>

                            <!-- LIGNE 3 : Date d'achat -->
                            <Label text="📅 Date d'Achat :" GridPane.columnIndex="2" GridPane.rowIndex="2"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <DatePicker fx:id="dpDateAchat" promptText="Sélectionnez la date"
                                        GridPane.columnIndex="3" GridPane.rowIndex="2"
                                        style="-fx-font-size: 14px; -fx-padding: 5;"/>

                            <!-- LIGNE 4 : Kilométrage / Heures -->
                            <Label text="⏱️ Kilométrage/Heures :" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfKilometrage" promptText="Ex: 1500"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #bdc3c7;"/>

                            <!-- LIGNE 4 : CIN Responsable (COMBOBOX) -->
                            <Label text="👤 CIN Responsable :" GridPane.columnIndex="2" GridPane.rowIndex="3"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <HBox spacing="5" GridPane.columnIndex="3" GridPane.rowIndex="3">
                                <ComboBox fx:id="cbCin" promptText="Sélectionnez un responsable"
                                          style="-fx-font-size: 14px; -fx-padding: 5;"
                                          HBox.hgrow="ALWAYS" prefWidth="280"/>
                                <Button text="🔄" onAction="#rafraichirCin"
                                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-cursor: hand; -fx-background-radius: 5;"
                                        prefWidth="40">
                                    <tooltip><Tooltip text="Rafraîchir la liste des responsables"/></tooltip>
                                </Button>
                            </HBox>

                            <!-- LIGNE 5 : Date Dernière Visite -->
                            <Label text="🔧 Dernière Visite :" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <DatePicker fx:id="dpDateLastVisite" promptText="Date de la dernière maintenance"
                                        GridPane.columnIndex="1" GridPane.rowIndex="4"
                                        style="-fx-font-size: 14px; -fx-padding: 5;"/>

                            <!-- LIGNE 5 : KM Dernière Visite -->
                            <Label text="📊 KM Dernière Visite :" GridPane.columnIndex="2" GridPane.rowIndex="4"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfKmLastVisite" promptText="Ex: 1200"
                                       GridPane.columnIndex="3" GridPane.rowIndex="4"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #bdc3c7;"/>

                            <!-- LIGNE 6 : Prochaine Maintenance -->
                            <Label text="⚠️ Prochaine Maintenance :" GridPane.columnIndex="0" GridPane.rowIndex="5"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <DatePicker fx:id="dpProchaineMaintenance" promptText="Date de la prochaine maintenance"
                                        GridPane.columnIndex="1" GridPane.rowIndex="5"
                                        style="-fx-font-size: 14px; -fx-padding: 5;"/>

                        </GridPane>
                    </children>
                </VBox>

                <!-- Boutons d'action -->
                <HBox spacing="20.0" alignment="CENTER" style="-fx-padding: 20 0 0 0;">
                    <children>
                        <Button text="✓ AJOUTER" onAction="#handleAjouter"
                                prefWidth="180.0" prefHeight="50.0"
                                style="-fx-background-color: #2D5A27;
                                      -fx-text-fill: white;
                                      -fx-font-weight: bold;
                                      -fx-font-size: 15px;
                                      -fx-cursor: hand;
                                      -fx-background-radius: 10;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>

                        <Button text="✗ ANNULER" onAction="#handleAnnuler"
                                prefWidth="180.0" prefHeight="50.0"
                                style="-fx-background-color: #95a5a6;
                                      -fx-text-fill: white;
                                      -fx-font-weight: bold;
                                      -fx-font-size: 15px;
                                      -fx-cursor: hand;
                                      -fx-background-radius: 10;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
                    </children>
                </HBox>

                <!-- Message d'aide -->
                <Text text="Remplissez tous les champs obligatoires (*) et cliquez sur AJOUTER pour enregistrer la nouvelle machine"
                      fill="#7f8c8d"
                      textAlignment="CENTER"
                      wrappingWidth="700"
                      style="-fx-font-size: 12px; -fx-font-style: italic;">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Text>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>