                                       -fx-font-size: 14px; -fx-background-radius: 50%;
                                       -fx-cursor: hand;" />
                        <Button fx:id="btnPrecedente" onAction="#pagePrecedente"
                                prefHeight="34" prefWidth="34" text="◀"
