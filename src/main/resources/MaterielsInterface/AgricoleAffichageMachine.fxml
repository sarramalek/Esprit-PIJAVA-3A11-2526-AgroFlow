                                         -fx-border-color: #A8C69F; -fx-border-radius: 8;" />

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- Navigation pages -->
                        <Button fx:id="btnPremiere" onAction="#pagePremiere"
                                prefHeight="34" prefWidth="34" text="⏮"
