                                     -fx-background-radius: 12;
                                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);">
                            <Label style="-fx-font-size: 10px; -fx-text-fill: #7F8C8D; -fx-font-weight: bold;"
                                   text="✅ En bon état" />
