                                      -fx-background-radius: 20; -fx-border-color: #A8C69F;
                                      -fx-border-radius: 20;"
                               text="Page 1 / 1  |  0 résultat(s)">
                            <font><Font name="System Bold" size="13" /></font>
                        </Label>

                        <Button fx:id="btnSuivante" onAction="#pageSuivante"
                                prefHeight="34" prefWidth="34" text="▶"
                                style="-fx-background-color: #388E3C; -fx-text-fill: white;
                                       -fx-font-size: 13px; -fx-background-radius: 50%;
                                       -fx-cursor: hand;" />
                        <Button fx:id="btnDerniere" onAction="#pageDerniere"
                                prefHeight="34" prefWidth="34" text="⏭"
                                style="-fx-background-color: #2E7D32; -fx-text-fill: white;
                                       -fx-font-size: 14px; -fx-background-radius: 50%;
                                       -fx-cursor: hand;" />

                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <!-- ── CARTES STATISTIQUES ── -->
                    <HBox spacing="12" alignment="CENTER">
                        <VBox alignment="CENTER" spacing="4" prefHeight="85"
