<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>

<?import javafx.scene.image.Image?>
<BorderPane style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Materiels.AgricoleAffichageMachineController">

    <!-- ═══════════════════════════════════════════════════
         SIDEBAR AGRICOLE
         ═══════════════════════════════════════════════════ -->
    <left>
        <VBox prefWidth="260"
              style="-fx-background-color: #FAFAF5; -fx-border-color: #E8EDE0; -fx-border-width: 0 1 0 0;">
            <padding><Insets top="0" bottom="20" /></padding>

            <!-- Logo Header -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #FFFFFF; -fx-padding: 16 20; -fx-border-color: #E8EDE0; -fx-border-width: 0 0 1 0;">
                <StackPane prefWidth="36" prefHeight="36">
                    <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                        <image><Image url="/style/logo.png"/></image>
                    </ImageView>
                </StackPane>
                <Label text="AgroFlow"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1B5E20;">
                    <font><Font name="System Bold" size="20" /></font>
                </Label>
            </HBox>

            <!-- User Info Card -->
            <VBox alignment="CENTER" spacing="6"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #E8EDE0;
                     -fx-border-width: 0 0 1 0; -fx-padding: 18 20;">

                <StackPane prefWidth="64" prefHeight="64">
                    <!-- Avatar background circle -->
                    <Circle fx:id="sidebarAvatarBg" radius="32"
                            fill="#E8F5E9" />
                    <!-- Default emoji -->
                    <Label fx:id="sidebarAvatarDefault"
                           style="-fx-font-size: 28px;"
                           text="👨‍🌾" />
                    <!-- Cloudinary photo -->
                    <ImageView fx:id="sidebarAvatarImageView"
                               fitWidth="64" fitHeight="64"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>

                <Label fx:id="userNameLabel"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A2E1A;"
                       text="Nom Agriculteur">
                    <font><Font name="System Bold" size="15" /></font>
                </Label>

                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;
                          -fx-background-color: #E8F5E9; -fx-padding: 3 10;
                          -fx-background-radius: 20;"
                       text="🌾 AGRICULTEUR">
                    <font><Font name="System Bold" size="11" /></font>
                </Label>

                <Hyperlink fx:id="aproposLink" text="👤 À propos de moi"
                           onMouseClicked="#handleMonProfil"
                           style="-fx-text-fill: #388E3C; -fx-font-size: 12px;
                              -fx-border-color: #C8E6C9; -fx-padding: 4 14;
                              -fx-background-radius: 20; -fx-border-radius: 20;
                              -fx-cursor: hand; -fx-underline: false;">
                    <font><Font name="System" size="12" /></font>
                </Hyperlink>
            </VBox>

            <!-- Navigation Label -->
            <Label text="NAVIGATION"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9E9E9E;
                      -fx-padding: 16 20 6 20; -fx-letter-spacing: 1px;">
                <font><Font name="System Bold" size="10" /></font>
            </Label>

            <!-- Navigation Menu -->
            <VBox spacing="2" style="-fx-padding: 0 12;">

                <!-- Accueil - Active State -->
                <Button onMouseClicked="#handleDashboardAgricole" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: #E8F5E9; -fx-text-fill: #1B5E20;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #A5D6A7; -fx-border-radius: 10; -fx-border-width: 1;"
                        text="📊  Accueil">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Ouvriers -->
                <Button onMouseClicked="#handlemesouvriers" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="👷  Mes Ouvriers">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Terrains avec sous-menu -->
                <VBox spacing="2">
                    <Button onMouseClicked="#handleMesTerrains" prefHeight="44" prefWidth="236"
                            style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                               -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                            text="🌾  Mes Terrains  ▾">
                        <font><Font name="System Bold" size="13" /></font>
                    </Button>
                    <!-- Sous-menu -->
                    <VBox fx:id="terrainsSubMenu" spacing="1"
                          style="-fx-padding: 2 0 2 12;" visible="false" managed="false">
                        <Button onMouseClicked="#ouvrirTerrains" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: #F1F8E9; -fx-text-fill: #33691E;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-border-color: #DCEDC8; -fx-border-radius: 8; -fx-border-width: 1;"
                                text="🚜  Terrains">
                            <font><Font name="System Bold" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirPlantes" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🌱  Plantes">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirRotations" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="📋  Rotations">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Mes Animaux -->
                <Button onMouseClicked="#handleMesAnimaux" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="🐄  Mes Animaux">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Stocks -->
                <Button onMouseClicked="#handleMesArticles" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="📦  Mes Stocks">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mon Matériel -->
                <!-- Mon Matériel avec sous-menu -->
                <VBox spacing="0">
                    <Button onMouseClicked="#handleMonMateriel"
                            prefHeight="44" maxWidth="Infinity" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                   -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                   -fx-padding: 0 12 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                            text="🚜  Mon Matériel  ▾">
                        <font><Font name="System Bold" size="13" /></font>
                    </Button>

                        <Button onMouseClicked="#ouvrirMachine"
                                prefHeight="38" maxWidth="Infinity" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: #F1F8E9; -fx-text-fill: #33691E;
                       -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                       -fx-padding: 0 8 0 20; -fx-background-radius: 8; -fx-cursor: hand;
                       -fx-border-color: #DCEDC8; -fx-border-radius: 8; -fx-border-width: 1;"
                                text="⚙️Machines">
                            <font><Font name="System Bold" size="12" /></font>
                        </Button>

                    <Button onMouseClicked="#ouvrirMaintenance"
                            prefHeight="38" maxWidth="Infinity" VBox.vgrow="ALWAYS"
                            style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                       -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                       -fx-padding: 0 8 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                            text="🔧Maintenances">
                        <font><Font name="System" size="12" /></font>
                    </Button>


            </VBox>


                <!-- Mes Abonnements -->
                <Button onMouseClicked="#handleMonAbonnement" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="💳  Mes Abonnements">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Événements -->
                <Button onMouseClicked="#handleMesEvenements" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="📅  Événements">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Separator -->
            <Separator style="-fx-background-color: #E0E8D8;" />

            <!-- Déconnexion -->
            <VBox style="-fx-padding: 12 12 0 12;">
                <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: #FFF3F3; -fx-text-fill: #C62828;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #FFCDD2; -fx-border-radius: 10; -fx-border-width: 1;"
                        text="🚪  Déconnexion">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>
            </VBox>

        </VBox>
    </left>



    <!-- ═══════════════════════════════════════════════════
         MAIN CONTENT
         ═══════════════════════════════════════════════════ -->
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: #F8F9FA; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-background-color: #F8F9FA;">
                <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>

                <!-- ── TOP BAR ── -->
                <HBox alignment="CENTER_LEFT" spacing="15"
                      style="-fx-background-color: white; -fx-background-radius: 15;
                             -fx-padding: 20;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">
                    <Button onMouseClicked="#handleDashboardAgricole"
                            style="-fx-background-color: #EAF5EA; -fx-text-fill: #2D5A27;
                                   -fx-cursor: hand; -fx-background-radius: 20; -fx-font-size: 12px;
                                   -fx-font-weight: bold; -fx-padding: 9 20;
                                   -fx-border-color: #A8C69F; -fx-border-radius: 20;"
                            text="⬅  Retour Accueil">
                        <font><Font name="System Bold" size="12" /></font>
                    </Button>
                    <Region HBox.hgrow="ALWAYS" />
                    <VBox spacing="4" alignment="CENTER">
                        <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"
                               text="🚜  Mon Matériel Agricole">
                            <font><Font name="System Bold" size="24" /></font>
                        </Label>
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D;"
                               text="Gestion complète de vos machines agricoles" />
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Button onAction="#afficherStatistiquesAvancees"
                            style="-fx-background-color: linear-gradient(to right, #1565C0, #1976D2);
                                   -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 20;
                                   -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 9 20;
                                   -fx-effect: dropshadow(gaussian, rgba(21,101,192,0.4), 6, 0, 0, 2);"
                            text="🏭  Analyse Avancée">
                        <font><Font name="System Bold" size="12" /></font>
                    </Button>
                    <Button onAction="#afficherStatistiquesGraphiques"
                            style="-fx-background-color: linear-gradient(to right, #4A235A, #7D3C98);
                                   -fx-text-fill: white; -fx-cursor: hand; -fx-background-radius: 20;
                                   -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 9 20;
                                   -fx-effect: dropshadow(gaussian, rgba(74,35,90,0.4), 6, 0, 0, 2);"
                            text="📊  Stats Graphiques">
                        <font><Font name="System Bold" size="12" /></font>
                    </Button>
                </HBox>

                <!-- ── LISTE MACHINES ── -->
                <VBox spacing="14"
                      style="-fx-background-color: white; -fx-background-radius: 15;
                             -fx-padding: 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">

                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                               text="🚜  Mes Machines">
                            <font><Font name="System Bold" size="20" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblSelectionInfo"
                               style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D; -fx-font-style: italic;"
                               text="Cliquez sur une ligne pour voir les détails" />
                    </HBox>

                    <!-- ── BARRE RECHERCHE + FILTRES ── -->
                    <VBox spacing="10"
                          style="-fx-background-color: #EAF5EA; -fx-padding: 14;
                                 -fx-background-radius: 12; -fx-border-color: #A8C69F;
                                 -fx-border-radius: 12; -fx-border-width: 1;">

                        <!-- Ligne 1 : Recherche -->
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2D5A27;"
                                   text="🔍 Recherche :">
                                <font><Font name="System Bold" size="13" /></font>
                            </Label>
                            <TextField fx:id="champRecherche"
                                       promptText="Nom, marque, modèle, état, N° série, kilométrage, CIN..."
                                       prefHeight="38" prefWidth="380"
                                       onKeyReleased="#rechercher"
                                       style="-fx-background-color: white; -fx-border-color: #A8C69F;
                                              -fx-border-radius: 20; -fx-background-radius: 20;
                                              -fx-font-size: 13px; -fx-padding: 0 15;" />
                            <Button onAction="#effacerRecherche" prefHeight="38"
                                    style="-fx-background-color: white; -fx-text-fill: #2D5A27;
                                           -fx-cursor: hand; -fx-background-radius: 20;
                                           -fx-border-color: #A8C69F; -fx-border-radius: 20;
                                           -fx-font-size: 12px; -fx-padding: 0 16;"
                                    text="↺  Reset">
                                <font><Font name="System" size="12" /></font>
                            </Button>
                            <Button onAction="#actualiser" prefHeight="38"
                                    style="-fx-background-color: #27AE60; -fx-text-fill: white;
                                           -fx-cursor: hand; -fx-background-radius: 20;
                                           -fx-font-size: 12px; -fx-font-weight: bold; -fx-padding: 0 16;"
                                    text="🔄 Actualiser">
                                <font><Font name="System Bold" size="12" /></font>
                            </Button>
                        </HBox>

                        <!-- Ligne 2 : Filtres + Tri -->
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2D5A27;"
                                   text="⚙ État :">
                                <font><Font name="System Bold" size="12" /></font>
                            </Label>
                            <ComboBox fx:id="comboEtat" promptText="Tous les états"
                                      prefWidth="165" prefHeight="36" onAction="#filtrer"
                                      style="-fx-background-radius: 10; -fx-font-size: 12px;
                                             -fx-background-color: white;
                                             -fx-border-color: #A8C69F; -fx-border-radius: 10;" />
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2D5A27;"
                                   text="🏷 Marque :">
                                <font><Font name="System Bold" size="12" /></font>
                            </Label>
                            <ComboBox fx:id="comboMarque" promptText="Toutes les marques"
                                      prefWidth="170" prefHeight="36" onAction="#filtrer"
                                      style="-fx-background-radius: 10; -fx-font-size: 12px;
                                             -fx-background-color: white;
                                             -fx-border-color: #A8C69F; -fx-border-radius: 10;" />
                            <Button onAction="#reinitialiserFiltres" prefHeight="36"
                                    style="-fx-background-color: #7F8C8D; -fx-text-fill: white;
                                           -fx-font-size: 12px; -fx-font-weight: bold;
                                           -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 0 14;"
                                    text="↺ Réinit.">
                                <font><Font name="System Bold" size="12" /></font>
                            </Button>
                            <Region HBox.hgrow="ALWAYS" />
                            <Label style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #2D5A27;"
                                   text="📅 Trier :">
                                <font><Font name="System Bold" size="12" /></font>
                            </Label>
                            <Button onAction="#trierNomAZ" prefHeight="36"
                                    style="-fx-background-color: #2980b9; -fx-text-fill: white;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 0 12;"
                                    text="🔠 A→Z">
                                <font><Font name="System Bold" size="11" /></font>
                            </Button>
                            <Button onAction="#trierNomZA" prefHeight="36"
                                    style="-fx-background-color: #7F8C8D; -fx-text-fill: white;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 0 12;"
                                    text="🔠 Z→A">
                                <font><Font name="System Bold" size="11" /></font>
                            </Button>
                            <Button onAction="#trierDateRecent" prefHeight="36"
                                    style="-fx-background-color: #27AE60; -fx-text-fill: white;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 0 12;"
                                    text="📅 Récent">
                                <font><Font name="System Bold" size="11" /></font>
                            </Button>
                            <Button onAction="#trierDateAncien" prefHeight="36"
                                    style="-fx-background-color: #E74C3C; -fx-text-fill: white;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 0 12;"
                                    text="📅 Ancien">
                                <font><Font name="System Bold" size="11" /></font>
                            </Button>
                            <Button onAction="#trierMarqueAZ" prefHeight="36"
                                    style="-fx-background-color: #8E44AD; -fx-text-fill: white;
                                           -fx-font-size: 11px; -fx-font-weight: bold;
                                           -fx-background-radius: 20; -fx-cursor: hand; -fx-padding: 0 12;"
                                    text="🏷 Marque">
                                <font><Font name="System Bold" size="11" /></font>
                            </Button>
                        </HBox>
                    </VBox>

                    <!-- ── TABLEAU — tous les attributs ── -->
                    <TableView fx:id="tableMachines" VBox.vgrow="ALWAYS" prefHeight="340"
                               style="-fx-background-color: white; -fx-border-color: #A8C69F;
                                      -fx-border-width: 1; -fx-border-radius: 12;
                                      -fx-background-radius: 12;">
                        <columns>
                            <!-- Attributs principaux -->
                            <TableColumn fx:id="colNom"                  text="Nom"                  prefWidth="140" minWidth="110"/>
                            <TableColumn fx:id="colMarque"               text="Marque"               prefWidth="110" minWidth="90"/>
                            <TableColumn fx:id="colModele"               text="Modèle"               prefWidth="110" minWidth="90"/>
                            <TableColumn fx:id="colEtat"                 text="État"                 prefWidth="120" minWidth="90"/>
                            <TableColumn fx:id="colNumeroSerie"          text="N° Série"             prefWidth="130" minWidth="100"/>
                            <TableColumn fx:id="colDateAchat"            text="Date Achat"           prefWidth="110" minWidth="90"/>
                            <!-- Attributs secondaires -->
                            <TableColumn fx:id="colKilometrage"          text="Kilométrage"          prefWidth="110" minWidth="90"/>
                            <TableColumn fx:id="colDateLastVisite"       text="Dern. Visite"         prefWidth="110" minWidth="90"/>
                            <TableColumn fx:id="colKmLastVisite"         text="Km Visite"            prefWidth="100" minWidth="80"/>
                            <TableColumn fx:id="colProchaineMaintenance" text="Proch. Maintenance"   prefWidth="140" minWidth="120"/>
                            <TableColumn fx:id="colCin"                  text="Propriétaire (CIN)"   prefWidth="200" minWidth="160"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucune machine trouvée pour ces critères."
                                   style="-fx-text-fill: #A8C69F; -fx-font-style: italic;
                                          -fx-font-size: 14px; -fx-padding: 40;" />
                        </placeholder>
                    </TableView>

                    <!-- ══════════════════════════════════════════════
                         ── BARRE CRUD ──
                         ══════════════════════════════════════════════ -->
                    <HBox spacing="12" alignment="CENTER_LEFT"
                          style="-fx-background-color: #EAF5EA; -fx-padding: 14;
                                 -fx-background-radius: 12; -fx-border-color: #A8C69F;
                                 -fx-border-radius: 12; -fx-border-width: 1;">
                        <Button onAction="#handleAjouter" prefHeight="42"
                                style="-fx-background-color: linear-gradient(to right,#27AE60,#2ecc71);
                                       -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;
                                       -fx-background-radius: 22; -fx-cursor: hand; -fx-padding: 0 22;
                                       -fx-effect: dropshadow(gaussian,rgba(39,174,96,0.4),6,0,0,2);"
                                text="➕  Ajouter">
                            <font><Font name="System Bold" size="13"/></font>
                        </Button>
                        <Button fx:id="btnModifier" onAction="#handleModifier" prefHeight="42"
                                disable="true"
                                style="-fx-background-color: linear-gradient(to right,#2980B9,#3498db);
                                       -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;
                                       -fx-background-radius: 22; -fx-cursor: hand; -fx-padding: 0 22;
                                       -fx-effect: dropshadow(gaussian,rgba(41,128,185,0.4),6,0,0,2);"
                                text="✏  Modifier">
                            <font><Font name="System Bold" size="13"/></font>
                        </Button>
                        <Button fx:id="btnSupprimer" onAction="#handleSupprimer" prefHeight="42"
                                disable="true"
                                style="-fx-background-color: linear-gradient(to right,#C0392B,#E74C3C);
                                       -fx-text-fill: white; -fx-font-size: 13px; -fx-font-weight: bold;
                                       -fx-background-radius: 22; -fx-cursor: hand; -fx-padding: 0 22;
                                       -fx-effect: dropshadow(gaussian,rgba(192,57,43,0.4),6,0,0,2);"
                                text="🗑  Supprimer">
                            <font><Font name="System Bold" size="13"/></font>
                        </Button>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="lblCrudInfo"
