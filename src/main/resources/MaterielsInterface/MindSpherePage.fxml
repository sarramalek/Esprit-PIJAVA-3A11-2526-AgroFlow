<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="820.0" prefWidth="1300.0"
            style="-fx-background-color: #F5F0E8;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Materiels.MindSpherePageController">

    <!-- ══════════  HEADER  ══════════ -->
    <top>
        <VBox style="-fx-background-color: #FDFAF4; -fx-padding: 0;
                     -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),8,0,0,2);">

            <HBox alignment="CENTER_LEFT" spacing="16"
                  style="-fx-padding: 14 22 14 22;
                         -fx-border-color: #D4A855; -fx-border-width: 0 0 2 0;">

                <Button fx:id="btnRetour" text="← Retour" onAction="#retourListe"
                        prefHeight="36"
                        style="-fx-background-color: #EDE8DF; -fx-text-fill: #5C4A1E;
                               -fx-font-size: 12px; -fx-font-weight: bold;
                               -fx-background-radius: 7; -fx-cursor: hand;
                               -fx-border-color: #C4A862; -fx-border-width: 1;
                               -fx-border-radius: 7; -fx-padding: 0 14;"/>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label text="⚡" style="-fx-font-size: 28px; -fx-text-fill: #D4A030;"/>
                    <VBox spacing="1">
                        <Label text="MindSphere IoT — API Avancée | AGROFLOW"
                               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C1F0E;"/>
                        <Label text="Siemens MindSphere · Asset Management v3 · IoT TimeSeries · OAuth2"
                               style="-fx-font-size: 10px; -fx-text-fill: #8B7355;"/>
                    </VBox>
                </HBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="🗺 Carte GPS" onAction="#ouvrirCarteGPS"
                        prefHeight="36"
                        style="-fx-background-color: #2D7A4F; -fx-text-fill: white;
                               -fx-font-size: 12px; -fx-font-weight: bold;
                               -fx-background-radius: 7; -fx-cursor: hand;
                               -fx-border-color: #1E5C3A; -fx-border-width: 1;
                               -fx-border-radius: 7; -fx-padding: 0 16;"/>

                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="lblStatutConnexion" text="🔴  Non connecté"
                           style="-fx-text-fill: #C0392B; -fx-font-weight: bold; -fx-font-size: 13px;"/>
                    <Label fx:id="lblTenant" text="—"
                           style="-fx-text-fill: #8B7355; -fx-font-size: 10px;"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-padding: 7 22 7 22; -fx-background-color: #F7F2E8;
                         -fx-border-color: #E8DFC8; -fx-border-width: 0 0 1 0;">
                <Label text="Progression :" style="-fx-text-fill: #8B7355; -fx-font-size: 11px;"/>
                <ProgressBar fx:id="progressBar" prefWidth="500" prefHeight="9"
                             style="-fx-accent: #2D7A4F;"/>
                <Label fx:id="lblProgress" text="En attente..."
                       style="-fx-text-fill: #5C7A5C; -fx-font-size: 11px;"/>
            </HBox>
        </VBox>
    </top>

    <!-- ══════════  CENTER  ══════════ -->
    <center>
        <HBox spacing="0" style="-fx-background-color: #F5F0E8;">

            <!-- ─── PANNEAU GAUCHE ─── -->
            <VBox prefWidth="420" spacing="12"
                  style="-fx-padding: 16 14 16 16;
                         -fx-background-color: #FDFAF4;
                         -fx-border-color: #E0D5BE; -fx-border-width: 0 1 0 0;">

                <!-- BLOC CONNEXION -->
                <VBox spacing="10"
                      style="-fx-background-color: #FFF8EC; -fx-padding: 14 16;
                             -fx-background-radius: 10; -fx-border-color: #D4A030;
                             -fx-border-width: 1.5; -fx-border-radius: 10;">

                    <Label text="🔐  Authentification OAuth2"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #8B6914;"/>

                    <GridPane hgap="10" vgap="6">
                        <Label text="Client ID :" GridPane.columnIndex="0" GridPane.rowIndex="0"
                               style="-fx-text-fill: #8B7355; -fx-font-size: 11px;"/>
                        <Label text="agroflow_app_client" GridPane.columnIndex="1" GridPane.rowIndex="0"
                               style="-fx-text-fill: #4A3728; -fx-font-size: 11px;"/>
                        <Label text="Tenant :" GridPane.columnIndex="0" GridPane.rowIndex="1"
                               style="-fx-text-fill: #8B7355; -fx-font-size: 11px;"/>
                        <Label text="agroflow-demo.eu1.mindsphere.io" GridPane.columnIndex="1" GridPane.rowIndex="1"
                               style="-fx-text-fill: #4A3728; -fx-font-size: 11px;"/>
                        <Label text="Token :" GridPane.columnIndex="0" GridPane.rowIndex="2"
                               style="-fx-text-fill: #8B7355; -fx-font-size: 11px;"/>
                        <Label fx:id="lblToken" text="—" GridPane.columnIndex="1" GridPane.rowIndex="2"
                               style="-fx-text-fill: #8B7355; -fx-font-size: 10px;"/>
                    </GridPane>

                    <Button fx:id="btnTesterConnexion"
                            text="🔌  Tester Connexion OAuth2"
                            onAction="#testerConnexion"
                            prefWidth="388" prefHeight="44"
                            style="-fx-background-color: #1A6B9A; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 9; -fx-cursor: hand;"/>
                </VBox>

                <!-- BLOC ACTIONS CLOUD -->
                <VBox spacing="9"
                      style="-fx-background-color: #F0FAF4; -fx-padding: 14 16;
                             -fx-background-radius: 10; -fx-border-color: #2D7A4F;
                             -fx-border-width: 1.5; -fx-border-radius: 10;">

                    <Label text="☁  Actions MindSphere Cloud"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1E5C3A;"/>

                    <Button fx:id="btnSyncVersCloud"
                            text="🔄  Sync BDD → MindSphere (Assets + TimeSeries)"
                            onAction="#syncVersCloud"
                            prefWidth="388" prefHeight="42"
                            style="-fx-background-color: #2D7A4F; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-background-radius: 9; -fx-cursor: hand;"/>

                    <Button fx:id="btnImportDepuisCloud"
                            text="📥  Import ← MindSphere (Récupérer Assets Cloud)"
                            onAction="#importDepuisCloud"
                            prefWidth="388" prefHeight="42"
                            style="-fx-background-color: #5C3D8F; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-background-radius: 9; -fx-cursor: hand;"/>

                    <Button fx:id="btnEnvoyerTimeSeries"
                            text="📡  Envoyer IoT TimeSeries (Machine #1)"
                            onAction="#envoyerTimeSeries"
                            prefWidth="388" prefHeight="42"
                            style="-fx-background-color: #C05A10; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-background-radius: 9; -fx-cursor: hand;"/>

                    <Button text="🗺  Carte GPS — Localisation Mondiale des Machines"
                            onAction="#ouvrirCarteGPS"
                            prefWidth="388" prefHeight="42"
                            style="-fx-background-color: #1A6B9A; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-background-radius: 9; -fx-cursor: hand;
                                   -fx-border-color: #15547A; -fx-border-width: 1;
                                   -fx-border-radius: 9;"/>
                </VBox>

                <!-- BLOC STATS CLOUD -->
                <VBox spacing="8"
                      style="-fx-background-color: #F7F2E8; -fx-padding: 12 16;
                             -fx-background-radius: 10; -fx-border-color: #D4C8A8;
                             -fx-border-width: 1; -fx-border-radius: 10;">

                    <Label text="📊  Statistiques Synchronisation"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #5C4A2A;"/>

                    <HBox spacing="10">
                        <VBox alignment="CENTER" spacing="3" prefHeight="65"
                              style="-fx-background-color: white; -fx-border-color: #1A6B9A;
                                     -fx-border-width: 0 0 0 3; -fx-background-radius: 8; -fx-padding: 8;"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label text="☁ Assets Cloud"
                                   style="-fx-text-fill: #8B7355; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            <Label fx:id="lblAssetsCloud" text="0"
                                   style="-fx-text-fill: #1A6B9A; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="3" prefHeight="65"
                              style="-fx-background-color: white; -fx-border-color: #C05A10;
                                     -fx-border-width: 0 0 0 3; -fx-background-radius: 8; -fx-padding: 8;"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity">
                            <Label text="📡 TimeSeries"
                                   style="-fx-text-fill: #8B7355; -fx-font-size: 10px; -fx-font-weight: bold;"/>
                            <Label fx:id="lblTimeSeriesEnvoyes" text="0"
                                   style="-fx-text-fill: #C05A10; -fx-font-size: 24px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Label text="Dernière sync :" style="-fx-text-fill: #B0A080; -fx-font-size: 10px;"/>
                        <Label fx:id="lblDerniereSync" text="—"
                               style="-fx-text-fill: #8B7355; -fx-font-size: 10px;"/>
                    </HBox>
                </VBox>

                <!-- BLOC STATS LOCALES -->
                <VBox spacing="7"
                      style="-fx-background-color: #F7F2E8; -fx-padding: 11 16;
                             -fx-background-radius: 10; -fx-border-color: #D4C8A8;
                             -fx-border-width: 1; -fx-border-radius: 10;">

                    <Label text="🗄  BDD Locale — Répartition par État"
                           style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #5C4A2A;"/>

                    <HBox spacing="6">
                        <VBox alignment="CENTER" spacing="2"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"
                              style="-fx-background-color: #F0FAF4; -fx-border-color: #2D7A4F;
                                     -fx-border-width: 0 0 0 3; -fx-padding: 6; -fx-background-radius: 6;">
                            <Label text="Neuf" style="-fx-text-fill: #5C7A5C; -fx-font-size: 9px;"/>
                            <Label fx:id="lblStatNeuf" text="0"
                                   style="-fx-text-fill: #2D7A4F; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"
                              style="-fx-background-color: #EEF5FB; -fx-border-color: #1A6B9A;
                                     -fx-border-width: 0 0 0 3; -fx-padding: 6; -fx-background-radius: 6;">
                            <Label text="Dispo" style="-fx-text-fill: #5C7A8A; -fx-font-size: 9px;"/>
                            <Label fx:id="lblStatDisponible" text="0"
                                   style="-fx-text-fill: #1A6B9A; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"
                              style="-fx-background-color: #FEF9EC; -fx-border-color: #C89020;
                                     -fx-border-width: 0 0 0 3; -fx-padding: 6; -fx-background-radius: 6;">
                            <Label text="Occasion" style="-fx-text-fill: #8A7040; -fx-font-size: 9px;"/>
                            <Label fx:id="lblStatOccasion" text="0"
                                   style="-fx-text-fill: #C89020; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"
                              style="-fx-background-color: #FEF0EE; -fx-border-color: #C0392B;
                                     -fx-border-width: 0 0 0 3; -fx-padding: 6; -fx-background-radius: 6;">
                            <Label text="Panne" style="-fx-text-fill: #8A4040; -fx-font-size: 9px;"/>
                            <Label fx:id="lblStatEnPanne" text="0"
                                   style="-fx-text-fill: #C0392B; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                        </VBox>
                        <VBox alignment="CENTER" spacing="2"
                              HBox.hgrow="ALWAYS" maxWidth="Infinity"
                              style="-fx-background-color: #F5F0FA; -fx-border-color: #7B5EA7;
                                     -fx-border-width: 0 0 0 3; -fx-padding: 6; -fx-background-radius: 6;">
                            <Label text="Total" style="-fx-text-fill: #6A5080; -fx-font-size: 9px;"/>
                            <Label fx:id="lblStatTotal" text="0"
                                   style="-fx-text-fill: #7B5EA7; -fx-font-size: 17px; -fx-font-weight: bold;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>

            <!-- ─── PANNEAU DROIT : Console ─── -->
            <VBox VBox.vgrow="ALWAYS" HBox.hgrow="ALWAYS" spacing="0"
                  style="-fx-background-color: #F5F0E8; -fx-padding: 16;">

                <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 0 0 10 0;">
                    <Label text="📋  Console MindSphere — Logs en Temps Réel"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #3A2C1A;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblNombreLogs" text="0 lignes"
                           style="-fx-text-fill: #A09070; -fx-font-size: 10px;"/>
                    <Button text="🗑 Vider" onAction="#viderConsole"
                            prefHeight="28"
                            style="-fx-background-color: #EDE8DF; -fx-text-fill: #5C4A2A;
                                   -fx-font-size: 11px; -fx-background-radius: 6;
                                   -fx-cursor: hand; -fx-padding: 0 10;
                                   -fx-border-color: #C4B898; -fx-border-width: 1;
                                   -fx-border-radius: 6;"/>
                </HBox>

                <TextArea fx:id="consoleLog"
                          VBox.vgrow="ALWAYS"
                          editable="false"
                          wrapText="true"
                          style="-fx-control-inner-background: #FDFAF5;
                                 -fx-text-fill: #2C3E50;
                                 -fx-font-family: 'Courier New', monospace;
                                 -fx-font-size: 12px;
                                 -fx-border-color: #D4C8A8;
                                 -fx-border-width: 1.5;
                                 -fx-border-radius: 8;
                                 -fx-background-radius: 8;
                                 -fx-padding: 10;"/>

                <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 8 0 0 0;">
                    <Label text="ℹ" style="-fx-text-fill: #1A6B9A; -fx-font-size: 13px;"/>
                    <Label text="Mode SIMULATION activé — Les appels API sont simulés localement."
                           style="-fx-text-fill: #A09070; -fx-font-size: 10px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="MindSphere EU1 · agroflow.Machine · Aspect: etatMachine"
                           style="-fx-text-fill: #C4B898; -fx-font-size: 10px;"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>