<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Materiels.ModifierMachineController">

    <!-- ================= SIDEBAR ================= -->
    <!-- SIDEBAR MODERNISÉE -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color:  #617e9c;">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Logo/Header MODERNE -->
            <StackPane prefWidth="100" prefHeight="100"  >
                <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                    <image><Image url="/style/logo.png"/></image>
                </ImageView>

            </StackPane>
            <padding>
                <Insets bottom="20" top="20" />
            </padding>
            <!-- Navigation Menu MODERNISÉE -->
            <VBox spacing="10">
                <!-- Dashboard -->
                <Button fx:id="dashboardBtn" onMouseClicked="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- GESTION PRINCIPALE avec sous-menu -->
                <VBox fx:id="gestionContainer" prefWidth="230" spacing="5" style="-fx-background-radius: 12;">
                    <Button fx:id="gestionBtn"  prefHeight="50" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"
                            text="⚙️  Gestion Utilisateurs">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                    <!-- Sous-menu MODERNE -->
                    <VBox fx:id="gestionSubmenu" spacing="3" style="-fx-padding: 5 0 5 15; -fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 0 0 12 12;">
                        <Button fx:id="personnesBtn" onMouseClicked="#handlePersonnes" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"
                                text="👥  Personnes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="tachesBtn" onMouseClicked="#handleTaches" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="✓  Tâches">
                            <font><Font name="System" size="13" /></font>
                        </Button>

                        <Button fx:id="abonnementsBtn" onMouseClicked="#handleAbonnements" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="💳  Abonnements">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="offresBtn" onMouseClicked="#handleOffres" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🎁  Offres">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Autres boutons MODERNISÉS -->
                <Button fx:id="stocksBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleStocks"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="terrainsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleTerrains"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Terrains">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="animauxBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleAnimals"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Animaux">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="materielBtn" prefHeight="48" prefWidth="230 " onMouseClicked="#handleMateriels"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🔧  Matériel">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="evenementsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleEvents"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🎉  Événements">
                    <font><Font name="System" size="14" /></font>
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout Button MODERNISÉ -->
            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>
    <!-- ================= CENTER ================= -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 30;" alignment="TOP_CENTER">
            <children>

                <!-- Titre -->
                <Text fill="#2C3E50" text="Modifier une Machine">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Text>

                <!-- Formulaire dans un conteneur blanc -->
                <VBox spacing="0" alignment="CENTER" maxWidth="650.0">
                    <children>
                        <GridPane hgap="15.0" vgap="18.0"
                                  style="-fx-background-color: white;
                                        -fx-padding: 40;
                                        -fx-background-radius: 10;
                                        -fx-border-color: #ddd;
                                        -fx-border-width: 1;
                                        -fx-border-radius: 10;
                                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                            <columnConstraints>
                                <ColumnConstraints minWidth="130.0" prefWidth="130.0" />
                                <ColumnConstraints minWidth="350.0" prefWidth="350.0" />
                            </columnConstraints>

                            <!-- 1. Marque (ordre Machine: marque) -->
                            <Label text="Marque :" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfMarque" promptText="Entrez la marque"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

                            <!-- 2. Modèle (ordre Machine: modele) -->
                            <Label text="Modèle :" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfModele" promptText="Entrez le modèle"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

                            <!-- 3. État (ordre Machine: etatM) -->
                            <Label text="État :" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfEtatM" promptText="Ex: Neuf, Bon, Occasion, Disponible"
                                       GridPane.columnIndex="1" GridPane.rowIndex="2"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

                            <!-- 4. N° Série (ordre Machine: numeroSerie) -->
                            <Label text="N° Série :" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfNumeroSerie" promptText="Entrez le numéro de série"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

                            <!-- 5. Date d'Achat (ordre Machine: dateAchat) -->
                            <Label text="Date d'Achat :" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <DatePicker fx:id="dpDateAchat" promptText="Sélectionnez la date d'achat"
                                        GridPane.columnIndex="1" GridPane.rowIndex="4"
                                        maxWidth="Infinity"
                                        style="-fx-font-size: 14px; -fx-padding: 5;"/>

                            <!-- 6. Nom (ordre Machine: nom) -->
                            <Label text="Nom :" GridPane.columnIndex="0" GridPane.rowIndex="5"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfNom" promptText="Entrez le nom de la machine"
                                       GridPane.columnIndex="1" GridPane.rowIndex="5"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

                        </GridPane>
                    </children>
                </VBox>

                <!-- Boutons d'action -->
                <HBox spacing="20.0" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <Button text="✓ MODIFIER" onAction="#handleModifier"
                                prefWidth="160.0" prefHeight="45.0"
                                style="-fx-background-color: #3498db;
                                      -fx-text-fill: white;
                                      -fx-font-weight: bold;
                                      -fx-font-size: 15px;
                                      -fx-cursor: hand;
                                      -fx-background-radius: 5;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>

                        <Button text="✗ ANNULER" onAction="#handleAnnuler"
                                prefWidth="160.0" prefHeight="45.0"
                                style="-fx-background-color: #95a5a6;
                                      -fx-text-fill: white;
                                      -fx-font-weight: bold;
                                      -fx-font-size: 15px;
                                      -fx-cursor: hand;
                                      -fx-background-radius: 5;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
                    </children>
                </HBox>

                <!-- Message d'aide -->
                <Text text="Modifiez les informations de la machine et cliquez sur MODIFIER pour enregistrer les changements"
                      fill="#7f8c8d"
                      textAlignment="CENTER"
                      wrappingWidth="600"
                      style="-fx-font-size: 12px; -fx-font-style: italic;">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Text>

            </children>
        </VBox>
    </center>

</BorderPane>