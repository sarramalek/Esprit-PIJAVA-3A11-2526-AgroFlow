<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Materiels.ModifierMachineController">

    <!-- ================= SIDEBAR ================= -->
    <left>
        <VBox prefWidth="230.0" spacing="5.0" style="-fx-background-color: #2C3E50; -fx-padding: 15;">
            <children>
                <Text fill="WHITE" text="AGROFLOW">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Text>
                <Separator opacity="0.2" prefHeight="20.0" />

                <Button onAction="#naviguerAnimaux" maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;"
                        text="🐾 Gestion Animaux" />

                <Button onAction="#naviguerMateriels" maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                        style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-cursor: hand;"
                        text="⚙️ Gestion Matériels" />

                <Button onAction="#naviguerStocks" maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;"
                        text="📦 Gestion Stocks" />

                <Button onAction="#naviguerTerrains" maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;"
                        text="🌱 Gestion Terrains" />

                <Button onAction="#naviguerEvenements" maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;"
                        text="📅 Événements" />

                <Button onAction="#naviguerUsers" maxWidth="Infinity" alignment="BASELINE_LEFT" prefHeight="45.0"
                        style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;"
                        text="👥 Utilisateurs" />

                <Region VBox.vgrow="ALWAYS" />

                <Separator opacity="0.1" />
                <Button maxWidth="Infinity" prefHeight="40.0"
                        style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"
                        text="Déconnexion" />
            </children>
        </VBox>
    </left>

    <!-- ================= CENTER ================= -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 30;" alignment="TOP_CENTER">
            <children>

                <!-- Titre -->
                <Text fill="#2C3E50" text="Modifier une Machine">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Text>

                <!-- Formulaire dans un conteneur blanc -->
                <VBox spacing="0" alignment="CENTER" maxWidth="650.0">
                    <children>
                        <GridPane hgap="15.0" vgap="18.0"
                                  style="-fx-background-color: white;
                                        -fx-padding: 40;
                                        -fx-background-radius: 10;
                                        -fx-border-color: #ddd;
                                        -fx-border-width: 1;
                                        -fx-border-radius: 10;
                                        -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                            <columnConstraints>
                                <ColumnConstraints minWidth="130.0" prefWidth="130.0" />
                                <ColumnConstraints minWidth="350.0" prefWidth="350.0" />
                            </columnConstraints>

                            <!-- 1. Marque (ordre Machine: marque) -->
                            <Label text="Marque :" GridPane.columnIndex="0" GridPane.rowIndex="0"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfMarque" promptText="Entrez la marque"
                                       GridPane.columnIndex="1" GridPane.rowIndex="0"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

                            <!-- 2. Modèle (ordre Machine: modele) -->
                            <Label text="Modèle :" GridPane.columnIndex="0" GridPane.rowIndex="1"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfModele" promptText="Entrez le modèle"
                                       GridPane.columnIndex="1" GridPane.rowIndex="1"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

                            <!-- 3. État (ordre Machine: etatM) -->
                            <Label text="État :" GridPane.columnIndex="0" GridPane.rowIndex="2"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfEtatM" promptText="Ex: Neuf, Bon, Occasion, Disponible"
                                       GridPane.columnIndex="1" GridPane.rowIndex="2"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

                            <!-- 4. N° Série (ordre Machine: numeroSerie) -->
                            <Label text="N° Série :" GridPane.columnIndex="0" GridPane.rowIndex="3"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfNumeroSerie" promptText="Entrez le numéro de série"
                                       GridPane.columnIndex="1" GridPane.rowIndex="3"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

                            <!-- 5. Date d'Achat (ordre Machine: dateAchat) -->
                            <Label text="Date d'Achat :" GridPane.columnIndex="0" GridPane.rowIndex="4"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <DatePicker fx:id="dpDateAchat" promptText="Sélectionnez la date d'achat"
                                        GridPane.columnIndex="1" GridPane.rowIndex="4"
                                        maxWidth="Infinity"
                                        style="-fx-font-size: 14px; -fx-padding: 5;"/>

                            <!-- 6. Nom (ordre Machine: nom) -->
                            <Label text="Nom :" GridPane.columnIndex="0" GridPane.rowIndex="5"
                                   style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #2C3E50;"/>
                            <TextField fx:id="tfNom" promptText="Entrez le nom de la machine"
                                       GridPane.columnIndex="1" GridPane.rowIndex="5"
                                       style="-fx-font-size: 14px; -fx-padding: 10; -fx-background-radius: 5; -fx-border-radius: 5; -fx-border-color: #bdc3c7;"/>

                        </GridPane>
                    </children>
                </VBox>

                <!-- Boutons d'action -->
                <HBox spacing="20.0" alignment="CENTER" style="-fx-padding: 10 0 0 0;">
                    <children>
                        <Button text="✓ MODIFIER" onAction="#handleModifier"
                                prefWidth="160.0" prefHeight="45.0"
                                style="-fx-background-color: #3498db;
                                      -fx-text-fill: white;
                                      -fx-font-weight: bold;
                                      -fx-font-size: 15px;
                                      -fx-cursor: hand;
                                      -fx-background-radius: 5;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>

                        <Button text="✗ ANNULER" onAction="#handleAnnuler"
                                prefWidth="160.0" prefHeight="45.0"
                                style="-fx-background-color: #95a5a6;
                                      -fx-text-fill: white;
                                      -fx-font-weight: bold;
                                      -fx-font-size: 15px;
                                      -fx-cursor: hand;
                                      -fx-background-radius: 5;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 5, 0, 0, 2);"/>
                    </children>
                </HBox>

                <!-- Message d'aide -->
                <Text text="Modifiez les informations de la machine et cliquez sur MODIFIER pour enregistrer les changements"
                      fill="#7f8c8d"
                      textAlignment="CENTER"
                      wrappingWidth="600"
                      style="-fx-font-size: 12px; -fx-font-style: italic;">
                    <VBox.margin>
                        <Insets top="10.0" />
                    </VBox.margin>
                </Text>

            </children>
        </VBox>
    </center>

</BorderPane>