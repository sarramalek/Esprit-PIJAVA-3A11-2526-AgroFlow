<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane prefWidth="780" prefHeight="680"
            style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Materiels.AjouterMaintenanceController">

    <top>
        <VBox style="-fx-background-color: #27ae60; -fx-padding: 22 28;">
            <Label text="Ajouter une maintenance"
                   style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Renseignez les informations de maintenance"
                   style="-fx-font-size: 12px; -fx-text-fill: #d5f5e3;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color: transparent; -fx-background: white;">
            <VBox spacing="18" style="-fx-padding: 24 28 18 28;">

                <GridPane hgap="18" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                        <ColumnConstraints percentWidth="50" hgrow="ALWAYS"/>
                    </columnConstraints>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label text="Machine *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <ComboBox fx:id="comboMachine" maxWidth="Infinity" promptText="Selectionner une machine"
                                  style="-fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 4;"/>
                        <Label fx:id="errMachine" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label text="Type de panne *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <TextField fx:id="txtTypePanne" promptText="Ex: Panne moteur"
                                   style="-fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 8;"/>
                        <Label fx:id="errTypePanne" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <Label text="Date de maintenance *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <DatePicker fx:id="datePickerMain" maxWidth="Infinity"
                                    style="-fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-font-size: 13px;"/>
                        <Label fx:id="errDate" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Label text="Cout (DT) *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <TextField fx:id="txtCout" promptText="Ex: 450.00"
                                   style="-fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 8;"/>
                        <Label fx:id="errCout" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <Label text="Statut *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <ComboBox fx:id="comboStatut" maxWidth="Infinity" promptText="Selectionner un statut"
                                  style="-fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 4;"/>
                        <Label fx:id="errStatut" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <Label text="Priorite *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <ComboBox fx:id="comboPriorite" maxWidth="Infinity" promptText="Selectionner une priorite"
                                  style="-fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 4;"/>
                        <Label fx:id="errPriorite" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
                    </VBox>

                    <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <Label text="Kilometrage *" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <TextField fx:id="txtKilometrage" promptText="Ex: 12000"
                                   style="-fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-font-size: 13px; -fx-padding: 8;"/>
                        <Label fx:id="errKilometrage" text="" style="-fx-text-fill: #e74c3c; -fx-font-size: 11px;"/>
                    </VBox>
                </GridPane>

                <VBox spacing="5">
                    <Label text="Description" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                    <TextArea fx:id="txtDescription" prefHeight="105" wrapText="true"
                              promptText="Details de l'intervention, pieces changees..."
                              style="-fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-font-size: 13px;"/>
                </VBox>

                <VBox spacing="5">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Recommandation IA" style="-fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="Generer IA" onAction="#genererRecommandation"
                                prefWidth="120" prefHeight="32"
                                style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    </HBox>
                    <TextArea fx:id="txtRecommandation" prefHeight="95" wrapText="true"
                              promptText="Laisser vide pour generer automatiquement selon la machine et le type de panne..."
                              style="-fx-background-radius: 6; -fx-border-color: #cbd5e0; -fx-border-radius: 6; -fx-font-size: 13px;"/>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox spacing="12" alignment="CENTER_RIGHT" style="-fx-padding: 16 28 20 28; -fx-background-color: #f8fafc;">
            <Button text="Annuler" onAction="#annuler" prefWidth="130" prefHeight="40"
                    style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-cursor: hand; -fx-font-size: 13px; -fx-background-radius: 6; -fx-font-weight: bold;"/>
            <Button text="Sauvegarder" onAction="#enregistrer" prefWidth="150" prefHeight="40"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-font-size: 13px; -fx-background-radius: 6;"/>
        </HBox>
    </bottom>
</BorderPane>
