<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Materiels.AfficherMaintenancesController"
            style="-fx-background-color: #ecf0f1;">

    <!-- SIDEBAR MODERNISÉE -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color:  #617e9c;">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Logo/Header MODERNE -->
            <StackPane prefWidth="100" prefHeight="100"  >
                <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                    <image><Image url="/style/logo.png"/></image>
                </ImageView>

            </StackPane>
            <padding>
                <Insets bottom="20" top="20" />
            </padding>
            <!-- Navigation Menu MODERNISÉE -->
            <VBox spacing="10">
                <!-- Dashboard -->
                <Button fx:id="dashboardBtn" onMouseClicked="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- GESTION PRINCIPALE avec sous-menu -->
                <VBox fx:id="gestionContainer" prefWidth="230" spacing="5" style="-fx-background-radius: 12;">
                    <Button fx:id="gestionBtn"  prefHeight="50" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"
                            text="⚙️  Gestion Utilisateurs">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                    <!-- Sous-menu MODERNE -->
                    <VBox fx:id="gestionSubmenu" spacing="3" style="-fx-padding: 5 0 5 15; -fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 0 0 12 12;">
                        <Button fx:id="personnesBtn" onMouseClicked="#handlePersonnes" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"
                                text="👥  Personnes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="tachesBtn" onMouseClicked="#handleTaches" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="✓  Tâches">
                            <font><Font name="System" size="13" /></font>
                        </Button>

                        <Button fx:id="abonnementsBtn" onMouseClicked="#handleAbonnements" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="💳  Abonnements">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="offresBtn" onMouseClicked="#handleOffres" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🎁  Offres">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Autres boutons MODERNISÉS -->
                <Button fx:id="stocksBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleStocks"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="terrainsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleTerrains"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Terrains">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="animauxBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleAnimals"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Animaux">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="materielBtn" prefHeight="48" prefWidth="230 " onMouseClicked="#handleMateriels"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🔧  Matériel">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="evenementsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleEvents"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🎉  Événements">
                    <font><Font name="System" size="14" /></font>
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout Button MODERNISÉ -->
            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>
    <!-- Contenu principal -->
    <center>
        <VBox spacing="10" style="-fx-padding: 20; -fx-background-color: #fcf8e6;">
            <HBox alignment="CENTER" spacing="12" style="-fx-cursor: hand;" onMouseClicked="#handleMonProfil">
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="userNameLabel" style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Admin">
                        <font><Font name="System Bold" size="15" /></font>
                    </Label>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" text="Administrateur">
                        <font><Font name="System" size="11" /></font>
                    </Label>
                </VBox>

                <!-- Avatar circulaire : photo si disponible, sinon emoji 👤 -->
                <StackPane>
                    <!-- Fond dégradé (visible si pas de photo) -->
                    <Circle fx:id="avatarBg" radius="24"
                            fill="linear-gradient(to bottom right, #667eea, #764ba2)" />
                    <!-- Emoji par défaut -->
                    <Label fx:id="avatarDefaultLabel"
                           style="-fx-font-size: 22px; -fx-text-fill: white;"
                           text="👤" />
                    <!-- Photo chargée depuis Cloudinary (clip appliqué en Java) -->
                    <ImageView fx:id="avatarImageView"
                               fitWidth="48" fitHeight="48"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>
            </HBox>
            <!-- EN-TETE -->
            <HBox alignment="CENTER_LEFT" spacing="15">
                <Button text="← Retour" onAction="#retourAccueil"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-padding: 9 18;
                               -fx-background-radius: 6; -fx-cursor: hand; -fx-font-weight: bold;"/>
                <Label text="Gestion des Maintenances"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            </HBox>

            <Separator/>

            <!-- ===== BARRE RECHERCHE + TRI + FILTRES ===== -->
            <VBox spacing="8"
                  style="-fx-background-color: #fcf8e6; -fx-padding: 12 16;
                         -fx-background-radius: 10; -fx-border-color: #e0d9c0;
                         -fx-border-width: 1; -fx-border-radius: 10;">

                <!-- LIGNE 1 : Recherche + Effacer + Export PDF + Export Excel -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="🔍 Recherche :"
                           style="-fx-font-size: 13px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                    <TextField fx:id="champRecherche"
                               promptText="Type de panne, machine, description, coût, date..."
                               prefWidth="360"
                               style="-fx-padding: 7 10; -fx-background-radius: 6;
                                      -fx-border-color: #c8b99a; -fx-border-width: 1.5;
                                      -fx-border-radius: 6; -fx-font-size: 13px;
                                      -fx-background-color: white;"/>
                    <Button text="✕  Effacer" onAction="#effacerRecherche"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-padding: 7 14; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="📄  Export PDF" onAction="#exporterPDF"
                            style="-fx-background-color: #c0392b; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-padding: 7 14; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Button text="📊  Export Excel" onAction="#exporterExcel"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-padding: 7 14; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>

                <!-- LIGNE 2 : Filtre Machine + Type + Tri Date + Actualiser -->
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="⚡ Filtrer par Machine :"
                           style="-fx-font-size: 12px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="comboMachine" promptText="Toutes les machines"
                              prefWidth="170" onAction="#filtrer"
                              style="-fx-background-radius: 6; -fx-font-size: 12px;
                                     -fx-background-color: white;"/>
                    <Label text="  🔧 Type :"
                           style="-fx-font-size: 12px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                    <ComboBox fx:id="comboTypePanne" promptText="Tous les types"
                              prefWidth="150" onAction="#filtrer"
                              style="-fx-background-radius: 6; -fx-font-size: 12px;
                                     -fx-background-color: white;"/>
                    <Label text="  📅 Trier :"
                           style="-fx-font-size: 12px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>
                    <Button text="▲ Récent" onAction="#trierPlusRecent"
                            style="-fx-background-color: #8e44ad; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Button text="▼ Ancien" onAction="#trierPlusAncien"
                            style="-fx-background-color: #7f8c8d; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Button text="💰 Coût ↑" onAction="#trierCoutEleve"
                            style="-fx-background-color: #e67e22; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Button text="💰 Coût ↓" onAction="#trierCoutFaible"
                            style="-fx-background-color: #7f8c8d; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Button text="⬆ Actualiser" onAction="#actualiser"
                            style="-fx-background-color: #3498db; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Button text="↺ Réinit." onAction="#reinitialiserFiltres"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                                   -fx-font-size: 12px; -fx-font-weight: bold;
                                   -fx-padding: 6 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>

            </VBox>

            <!-- TABLE -->
            <TableView fx:id="tableMaintenances" VBox.vgrow="ALWAYS" prefHeight="310"
                       style="-fx-background-color: white; -fx-border-color: #e2e8f0;
                              -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
                <columns>
                    <TableColumn fx:id="colMachine"     text="Machine"       prefWidth="150" minWidth="120"/>
                    <TableColumn fx:id="colTypePanne"   text="Type de Panne" prefWidth="140" minWidth="110"/>
                    <TableColumn fx:id="colDate"        text="Date"          prefWidth="110" minWidth="90"/>
                    <TableColumn fx:id="colCout"        text="Cout (DT)"     prefWidth="105" minWidth="85"/>
                    <TableColumn fx:id="colDescription" text="Description"   prefWidth="250" minWidth="170"/>
                </columns>
                <placeholder>
                    <Label text="Aucune maintenance trouvée"
                           style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
                </placeholder>
            </TableView>

            <!-- ===== STATISTIQUES ===== -->
            <HBox spacing="10" alignment="CENTER">

                <VBox spacing="4" alignment="CENTER"
                      style="-fx-background-color: #fcf8e6; -fx-padding: 10 14;
                             -fx-border-color: #3498db; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 5, 0, 0, 2);"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="📋 Total"
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Label fx:id="lblTotal" text="0"
                           style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #3498db;"/>
                    <Label fx:id="lblPctTotal" text="100%"
                           style="-fx-font-size: 11px; -fx-text-fill: #3498db; -fx-font-weight: bold;
                                  -fx-background-color: #eaf4fb; -fx-padding: 2 8; -fx-background-radius: 10;"/>
                </VBox>

                <VBox spacing="4" alignment="CENTER"
                      style="-fx-background-color: #fcf8e6; -fx-padding: 10 14;
                             -fx-border-color: #e74c3c; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 5, 0, 0, 2);"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="💰 Coût Total"
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Label fx:id="lblCoutTotal" text="0,00 DT"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"/>
                    <Label fx:id="lblPctCoutEleve" text="0% élevés"
                           style="-fx-font-size: 11px; -fx-text-fill: #e74c3c; -fx-font-weight: bold;
                                  -fx-background-color: #fdf0ef; -fx-padding: 2 8; -fx-background-radius: 10;"/>
                </VBox>

                <VBox spacing="4" alignment="CENTER"
                      style="-fx-background-color: #fcf8e6; -fx-padding: 10 14;
                             -fx-border-color: #f39c12; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 5, 0, 0, 2);"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="📊 Coût Moyen"
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Label fx:id="lblCoutMoyen" text="0,00 DT"
                           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f39c12;"/>
                    <Label fx:id="lblPctSousLaMoyenne" text="0% sous moy."
                           style="-fx-font-size: 11px; -fx-text-fill: #f39c12; -fx-font-weight: bold;
                                  -fx-background-color: #fef9ec; -fx-padding: 2 8; -fx-background-radius: 10;"/>
                </VBox>

                <VBox spacing="4" alignment="CENTER"
                      style="-fx-background-color: #fcf8e6; -fx-padding: 10 14;
                             -fx-border-color: #27ae60; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 5, 0, 0, 2);"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="🏆 Machine + Coûteuse"
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Label fx:id="lblMachineCouteuse" text="-"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #27ae60;"/>
                    <Label fx:id="lblPctMachine" text="0% du total"
                           style="-fx-font-size: 11px; -fx-text-fill: #27ae60; -fx-font-weight: bold;
                                  -fx-background-color: #eafaf1; -fx-padding: 2 8; -fx-background-radius: 10;"/>
                </VBox>

                <VBox spacing="4" alignment="CENTER"
                      style="-fx-background-color: #fcf8e6; -fx-padding: 10 14;
                             -fx-border-color: #9b59b6; -fx-border-width: 0 0 0 5;
                             -fx-background-radius: 8;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.07), 5, 0, 0, 2);"
                      HBox.hgrow="ALWAYS" maxWidth="Infinity">
                    <Label text="🔧 Type Dominant"
                           style="-fx-font-size: 11px; -fx-text-fill: #7f8c8d; -fx-font-weight: bold;"/>
                    <Label fx:id="lblTypeDominant" text="-"
                           style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #9b59b6;"/>
                    <Label fx:id="lblNbTypeDominant" text="0 occurrence(s)"
                           style="-fx-font-size: 11px; -fx-text-fill: #9b59b6; -fx-font-weight: bold;
                                  -fx-background-color: #f5eef8; -fx-padding: 2 8; -fx-background-radius: 10;"/>
                </VBox>

            </HBox>

            <!-- ===== BOUTONS CRUD ===== -->
            <VBox spacing="5">
                <HBox spacing="0" alignment="CENTER"
                      style="-fx-background-color: #fcf8e6; -fx-padding: 12 20;
                             -fx-background-radius: 10; -fx-border-color: #e0d9c0;
                             -fx-border-width: 1; -fx-border-radius: 10;">
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="＋  AJOUTER" onAction="#ouvrirFormulaireAjout"
                            prefWidth="160" prefHeight="44"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 8 0 0 8; -fx-cursor: hand;"/>
                    <Button text="✎  MODIFIER" onAction="#modifierSelection"
                            prefWidth="160" prefHeight="44"
                            style="-fx-background-color: #2980b9; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 0; -fx-cursor: hand;"/>
                    <Button text="🗑  SUPPRIMER" onAction="#supprimerSelection"
                            prefWidth="160" prefHeight="44"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 0; -fx-cursor: hand;"/>
                    <Button text="📊  STATISTIQUES" onAction="#afficherStatistiques"
                            prefWidth="180" prefHeight="44"
                            style="-fx-background-color: #8e44ad; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 0; -fx-cursor: hand;"/>
                    <Button text="🏭  COÛT/MACHINE" onAction="#ouvrirCoutMachine"
                            prefWidth="180" prefHeight="44"
                            style="-fx-background-color: #2980b9; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-background-radius: 0 8 8 0; -fx-cursor: hand;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <Label fx:id="lblSelectionInfo"
                       text="Sélectionnez une ligne pour Modifier / Supprimer"
                       alignment="CENTER" maxWidth="Infinity"
                       style="-fx-font-size: 12px; -fx-text-fill: #95a5a6; -fx-font-style: italic;"/>
            </VBox>

        </VBox>
    </center>

</BorderPane>
