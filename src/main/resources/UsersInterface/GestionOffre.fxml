<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import org.controlsfx.control.HyperlinkLabel?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.Image?>
<BorderPane style="-fx-background-color: #fcf8e6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.User.GestionOffres">

    <!-- SIDEBAR MODERNISÉE -->
    <!-- SIDEBAR MODERNISÉE -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color:  #617e9c;">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Logo/Header MODERNE -->
            <StackPane prefWidth="100" prefHeight="100"  >
                <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                    <image><Image url="/style/logo.png"/></image>
                </ImageView>

            </StackPane>
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Navigation Menu MODERNISÉE -->
            <VBox spacing="10">
                <!-- Dashboard -->
                <Button fx:id="dashboardBtn" onAction="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- GESTION PRINCIPALE avec sous-menu -->
                <VBox fx:id="gestionContainer" prefWidth="230" spacing="5" style="-fx-background-radius: 12;">
                    <Button fx:id="gestionBtn"  prefHeight="50" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"
                            text="⚙️  Gestion Utilisateurs">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                    <!-- Sous-menu MODERNE -->
                    <VBox fx:id="gestionSubmenu" spacing="3" style="-fx-padding: 5 0 5 15; -fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 0 0 12 12;">
                        <Button fx:id="personnesBtn" onMouseClicked="#handlePersonnes" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"
                                text="👥  Personnes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="tachesBtn" onMouseClicked="#handleTaches" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="✓  Tâches">
                            <font><Font name="System" size="13" /></font>
                        </Button>

                        <Button fx:id="abonnementsBtn" onMouseClicked="#handleAbonnements" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="💳  Abonnements">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="offresBtn" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🎁  Offres">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="StatsBtn" onMouseClicked="#openDashboard" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="📊 Statistiques ">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Autres boutons MODERNISÉS -->
                <Button fx:id="stocksBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleStocks"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="terrainsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleTerrains"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Terrains">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="animauxBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleAnimals"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Animaux">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="materielBtn" prefHeight="48" prefWidth="230 " onMouseClicked="#handleMateriels"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🔧  Matériel">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="evenementsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleEvents"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🎉  Événements">
                    <font><Font name="System" size="14" /></font>
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout Button MODERNISÉ -->
            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>
    <!-- Main Content Area -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #fcf8e6; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-background-color: #fcf8e6;">
                <padding>
                    <Insets bottom="30" left="30" right="30" top="30" />
                </padding>

                <!-- Top Bar -->
                <!-- Top Bar MODERNISÉE -->
                <HBox alignment="CENTER_LEFT" spacing="25" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a237e; -fx-effect: dropshadow(gaussian, rgba(26,35,126,0.2), 3, 0, 0, 1);" text="Gestion des Offres ">
                                <font><Font name="System Bold" size="32" /></font>
                            </Label>
                            <Label style="-fx-background-color: #E8EAF6; -fx-text-fill: #3949ab; -fx-padding: 6 12; -fx-background-radius: 20; -fx-font-size: 12px; -fx-font-weight: bold;" text="ACTIF">
                                <font><Font name="System Bold" size="12" /></font>
                            </Label>
                        </HBox>
                        <Label style="-fx-font-size: 15px; -fx-text-fill: #7F8C8D;" text="Gérer et visualiser les Offres Disponiblle ">
                            <font><Font name="System" size="15" /></font>
                        </Label>
                    </VBox>

                    <!-- User Profile MODERNISÉ -->
                    <HBox alignment="CENTER" spacing="18">
                        <Button fx:id="addOffreBtn" onMouseClicked="#handleAddOffre"
                                style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.4), 10, 0, 0, 3);"
                                text="+ Ajouter un Offre ">
                            <font><Font name="System Bold" size="14" /></font>
                        </Button>

                        <Separator orientation="VERTICAL" prefHeight="40" style="-fx-background-color: #E0E0E0;" />

                        <HBox alignment="CENTER" spacing="12" style="-fx-cursor: hand;" onMouseClicked="#handleMonProfil">
                            <VBox alignment="CENTER_RIGHT" spacing="2">
                                <Label fx:id="userNameLabel" style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Admin">
                                    <font><Font name="System Bold" size="15" /></font>
                                </Label>
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" text="Administrateur">
                                    <font><Font name="System" size="11" /></font>
                                </Label>
                            </VBox>

                            <!-- Avatar circulaire : photo si disponible, sinon emoji 👤 -->
                            <StackPane>
                                <!-- Fond dégradé (visible si pas de photo) -->
                                <Circle fx:id="avatarBg" radius="24"
                                        fill="linear-gradient(to bottom right, #667eea, #764ba2)" />
                                <!-- Emoji par défaut -->
                                <Label fx:id="avatarDefaultLabel"
                                       style="-fx-font-size: 22px; -fx-text-fill: white;"
                                       text="👤" />
                                <!-- Photo chargée depuis Cloudinary (clip appliqué en Java) -->
                                <ImageView fx:id="avatarImageView"
                                           fitWidth="48" fitHeight="48"
                                           preserveRatio="false"
                                           visible="false" managed="false" />
                            </StackPane>
                        </HBox>
                    </HBox>
                </HBox>


                <!-- Statistiques Cards -->
                <HBox spacing="15" alignment="CENTER">
                    <!-- Total des offres -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 32px;" text="🏷️" />
                            <VBox spacing="3">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Total des offres">
                                    <font><Font name="System" size="12" /></font>
                                </Label>
                                <Label fx:id="totalOffresLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="0">
                                    <font><Font name="System Bold" size="24" /></font>
                                </Label>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Offre la plus chère -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 32px;" text="💰" />
                            <VBox spacing="3">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Prix maximum">
                                    <font><Font name="System" size="12" /></font>
                                </Label>
                                <Label fx:id="maxPrixLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F39C12;" text="0 DT">
                                    <font><Font name="System Bold" size="24" /></font>
                                </Label>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Prix moyen -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 32px;" text="📊" />
                            <VBox spacing="3">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Prix moyen">
                                    <font><Font name="System" size="12" /></font>
                                </Label>
                                <Label fx:id="avgPrixLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #3498DB;" text="0 DT">
                                    <font><Font name="System Bold" size="24" /></font>
                                </Label>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Liste des Offres Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="25" left="25" right="25" top="25" />
                    </padding>

                    <!-- Card Header -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Liste des Offres">
                            <font><Font name="System Bold" size="20" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="searchField" prefWidth="250" promptText="🔍 Rechercher..."
                                   style="-fx-background-color: #F5F7FA; -fx-background-radius: 8;
                                          -fx-border-color: transparent; -fx-padding: 10;">
                            <font><Font name="System" size="14" /></font>
                        </TextField>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 10 0 8 0;">
                        <Label fx:id="selectedPersonLabel"
                               text="Sélectionnez une personne pour générer son PDF"
                               style="-fx-text-fill: #7F8C8D; -fx-font-size: 12px; -fx-font-style: italic;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="pdfBtn"
                                text="📄  Générer PDF abonnement"
                                onAction="#handleGeneratePdf"
                                disable="true"
                                style="-fx-background-color: #E74C3C;
                   -fx-text-fill: white;
                   -fx-font-size: 12px;
                   -fx-font-weight: bold;
                   -fx-background-radius: 8;
                   -fx-padding: 8 20 8 20;
                   -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.4), 8, 0, 0, 2);" />
                    </HBox>

                    <!-- Table -->
                    <TableView fx:id="offresTable" prefHeight="400.0" minHeight="350.0" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="idColumn" prefWidth="80" style="-fx-alignment: CENTER;" text="ID" />
                            <TableColumn fx:id="nomColumn" prefWidth="250" style="-fx-alignment: CENTER-LEFT;" text="Nom de l'offre" />
                            <TableColumn fx:id="descriptionColumn" prefWidth="300" style="-fx-alignment: CENTER-LEFT;" text="Description" />
                            <TableColumn fx:id="prixColumn" prefWidth="120" style="-fx-alignment: CENTER;" text="Prix (DT)" />
                            <TableColumn fx:id="dureeColumn" prefWidth="120" style="-fx-alignment: CENTER;" text="Durée (jours)" />
                            <TableColumn fx:id="actionsColumn" prefWidth="200" style="-fx-alignment: CENTER;" text="Actions" />
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
