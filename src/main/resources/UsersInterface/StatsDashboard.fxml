<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.User.StatsDashboardController"
            stylesheets="style.css"
            prefWidth="1140" prefHeight="820"
            style="-fx-background-color: #f5f7f5;">

    <top>
        <HBox styleClass="dash-header" alignment="CENTER_LEFT" spacing="14">
            <padding><Insets top="15" right="28" bottom="15" left="28"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="&#127807;" style="-fx-font-size:26;"/>
                <VBox spacing="1">
                    <Label text="AgroFlow" styleClass="header-brand"/>
                    <Label text="Tableau de bord  ·  Statistiques" styleClass="header-sub"/>
                </VBox>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="&#8635;  Actualiser" styleClass="btn-refresh" onAction="#handleRefresh"/>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="main-scroll" hbarPolicy="NEVER">
            <VBox spacing="22" styleClass="dash-body">
                <padding><Insets top="26" right="28" bottom="28" left="28"/></padding>

                <!-- Section label -->
                <Label text="VUE GÉNÉRALE" styleClass="section-label"/>

                <!-- KPI Cards -->
                <GridPane hgap="14" vgap="14">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>

                    <VBox styleClass="kpi-card" GridPane.columnIndex="0" GridPane.rowIndex="0" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="UTILISATEURS" styleClass="kpi-label"/>
                        </HBox>
                        <Label fx:id="lblTotalUsers" text="—" styleClass="kpi-value kpi-blue-val"/>
                        <Separator styleClass="kpi-sep"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Taux 2FA :" styleClass="kpi-meta-label"/>
                            <Label fx:id="lblTauxAdoption2FA" text="—" styleClass="kpi-meta-val kpi-blue-val"/>
                        </HBox>
                        <ProgressBar fx:id="progress2FA" maxWidth="1.7976931348623157E308" prefHeight="7" styleClass="pb-blue"/>
                    </VBox>

                    <VBox styleClass="kpi-card" GridPane.columnIndex="1" GridPane.rowIndex="0" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="ABONNEMENTS ACTIFS" styleClass="kpi-label"/>
                        </HBox>
                        <Label fx:id="lblAbonnementsActifs" text="—" styleClass="kpi-value kpi-green-val"/>
                        <Separator styleClass="kpi-sep"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Taux d'activité :" styleClass="kpi-meta-label"/>
                            <Label fx:id="lblAbonnementsSubtitle" text="—" styleClass="kpi-meta-val kpi-green-val"/>
                        </HBox>
                        <ProgressBar fx:id="progressActifs" maxWidth="1.7976931348623157E308" prefHeight="7" styleClass="pb-green"/>
                    </VBox>

                    <VBox styleClass="kpi-card" GridPane.columnIndex="2" GridPane.rowIndex="0" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="OFFRES DISPONIBLES" styleClass="kpi-label"/>
                        </HBox>
                        <Label fx:id="lblTotalOffres" text="—" styleClass="kpi-value kpi-orange-val"/>
                        <Separator styleClass="kpi-sep"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Revenu mensuel :" styleClass="kpi-meta-label"/>
                            <Label fx:id="lblRevenuMensuel" text="—" styleClass="kpi-meta-val kpi-orange-val"/>
                        </HBox>
                        <ProgressBar maxWidth="1.7976931348623157E308" prefHeight="7" styleClass="pb-orange" progress="1.0"/>
                    </VBox>

                    <VBox styleClass="kpi-card" GridPane.columnIndex="3" GridPane.rowIndex="0" spacing="10">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label text="TÂCHES EN COURS" styleClass="kpi-label"/>
                        </HBox>
                        <Label fx:id="lblTachesEnCours" text="—" styleClass="kpi-value kpi-red-val"/>
                        <Separator styleClass="kpi-sep"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="En retard :" styleClass="kpi-meta-label"/>
                            <Label fx:id="lblTachesRetard" text="—" styleClass="kpi-meta-val kpi-red-val"/>
                        </HBox>
                        <ProgressBar maxWidth="1.7976931348623157E308" prefHeight="7" styleClass="pb-red" progress="0.4"/>
                    </VBox>
                </GridPane>

                <!-- Section label -->
                <Label text="GRAPHIQUES" styleClass="section-label"/>

                <!-- Row 1: Pie charts -->
                <HBox spacing="14">
                    <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="Abonnements par statut" styleClass="chart-title"/>
                        <Separator styleClass="card-sep"/>
                        <PieChart fx:id="pieAbonnements" prefHeight="230"
                                  legendVisible="true" labelsVisible="true"/>
                    </VBox>
                    <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="Utilisateurs par rôle" styleClass="chart-title"/>
                        <Separator styleClass="card-sep"/>
                        <PieChart fx:id="pieUsers" prefHeight="230"
                                  legendVisible="true" labelsVisible="true"/>
                    </VBox>
                </HBox>

                <!-- Row 2: Bar charts -->
                <HBox spacing="14">
                    <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="Popularité des offres" styleClass="chart-title"/>
                        <Separator styleClass="card-sep"/>
                        <BarChart fx:id="barOffres" prefHeight="240" animated="true" legendVisible="false">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis label="Abonnés" minorTickVisible="false"/></yAxis>
                        </BarChart>
                    </VBox>
                    <VBox styleClass="chart-card" HBox.hgrow="ALWAYS" spacing="10">
                        <Label text="État des tâches" styleClass="chart-title"/>
                        <Separator styleClass="card-sep"/>
                        <BarChart fx:id="barTaches" prefHeight="240" animated="true" legendVisible="true">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis label="Nombre" minorTickVisible="false"/></yAxis>
                        </BarChart>
                    </VBox>
                </HBox>

                <!-- Section label -->
                <Label text="DÉTAIL DES OFFRES" styleClass="section-label"/>

                <!-- Table -->
                <VBox styleClass="chart-card" spacing="10">
                    <TableView fx:id="tableOffres" prefHeight="195" styleClass="stats-table"
                               maxWidth="1.7976931348623157E308">
                        <columns>
                            <TableColumn fx:id="colNomOffre"  text="Nom de l'offre" prefWidth="280"/>
                            <TableColumn fx:id="colPrix"      text="Prix (TND)"     prefWidth="160"/>
                            <TableColumn fx:id="colDuree"     text="Durée (mois)"   prefWidth="160"/>
                            <TableColumn fx:id="colNbAbonnes" text="Abonnés"        prefWidth="150"/>
                        </columns>
                        <placeholder>
                            <Label text="Aucune offre disponible"
                                   style="-fx-text-fill:#9ca3af; -fx-font-size:13px;"/>
                        </placeholder>
                    </TableView>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
