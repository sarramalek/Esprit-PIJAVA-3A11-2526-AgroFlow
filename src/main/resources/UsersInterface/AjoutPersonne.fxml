<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Line?>

<BorderPane style="-fx-background-color: #f4f7f6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.User.AjoutPersonne">
    <center>
        <VBox spacing="25" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 20, 0, 0, 10);">
            <BorderPane.margin>
                <Insets bottom="30" left="30" right="30" top="30" />
            </BorderPane.margin>

            <VBox spacing="5">
                <Label text="Nouvel Employé" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1a237e;" />
                <Label text="Veuillez remplir les informations pour enregistrer un nouveau membre dans l'équipe." style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
                <Line endX="450.0" stroke="#eeeeee" strokeWidth="1.0" />
            </VBox>

            <Label fx:id="errorLabel" visible="false" wrapText="true"
                   style="-fx-background-color: #ffebee; -fx-text-fill: #c62828; -fx-padding: 10; -fx-background-radius: 5; -fx-border-color: #ef9a9a; -fx-font-size: 13px;" maxWidth="Infinity"/>

            <HBox spacing="40">
                <VBox spacing="15" HBox.hgrow="ALWAYS">
                    <Label text="IDENTITÉ" style="-fx-font-weight: bold; -fx-text-fill: #3949ab; -fx-font-size: 12px;"/>

                    <VBox spacing="5">
                        <Label text="CIN *" style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>
                        <TextField fx:id="cinField" promptText="Ex: 12345678" style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #dcdde1; -fx-border-radius: 8;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Nom *" style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>
                        <TextField fx:id="nomField" promptText="Nom de famille" style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #dcdde1; -fx-border-radius: 8;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Prénom *" style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>
                        <TextField fx:id="prenomField" promptText="Prénom" style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #dcdde1; -fx-border-radius: 8;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Mot de passe *" style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>
                        <PasswordField fx:id="passwordField" promptText="6 caractères min." style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #dcdde1; -fx-border-radius: 8;"/>
                    </VBox>
                </VBox>

                <VBox spacing="15" HBox.hgrow="ALWAYS">
                    <Label text="COORDONNÉES" style="-fx-font-weight: bold; -fx-text-fill: #3949ab; -fx-font-size: 12px;"/>

                    <VBox spacing="5">
                        <Label text="Email *" style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>
                        <TextField fx:id="emailField" promptText="exemple@email.com" style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #dcdde1; -fx-border-radius: 8;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Téléphone *" style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>
                        <TextField fx:id="telField" promptText="Ex: 216..." style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #dcdde1; -fx-border-radius: 8;"/>
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Date de naissance" style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>
                        <DatePicker fx:id="dateNaissancePicker" maxWidth="Infinity" style="-fx-background-radius: 8; -fx-padding: 5; -fx-border-color: #dcdde1; -fx-border-radius: 8;"/>
                    </VBox>

                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Ville" style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>
                            <TextField fx:id="villeField" style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #dcdde1; -fx-border-radius: 8;"/>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>

            <VBox spacing="5">
                <Label text="Adresse complète" style="-fx-text-fill: #34495e; -fx-font-weight: bold;"/>
                <TextField fx:id="adresseField" promptText="Numéro, rue..." style="-fx-background-radius: 8; -fx-padding: 10; -fx-border-color: #dcdde1; -fx-border-radius: 8;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <HBox spacing="15" alignment="CENTER_RIGHT">
                <Button fx:id="cancelButton" text="Annuler" onAction="#handleCancel"
                        style="-fx-background-color: transparent; -fx-text-fill: #7f8c8d; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12 30;" />

                <Button fx:id="saveButton" text="💾 Enregistrer l'employé" onAction="#handleSave"
                        style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049);
                               -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold;
                               -fx-padding: 12 35; -fx-background-radius: 10; -fx-cursor: hand;
                               -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.3), 10, 0, 0, 5);"
                        defaultButton="true"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>