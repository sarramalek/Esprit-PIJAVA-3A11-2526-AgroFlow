<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<ScrollPane fitToWidth="true" style="-fx-background-color: #F8F9FA; -fx-border-color: transparent;" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.User.ProfilEmploye">
<VBox xmlns="http://javafx.com/javafx/17"

      spacing="20"
      style="-fx-background-color: #F5F6FA; -fx-padding: 30;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
        <Label style="-fx-font-size: 42px; -fx-background-color: linear-gradient(to bottom right, #667eea, #764ba2);
                      -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 50%;
                      -fx-min-width: 70; -fx-min-height: 70; -fx-alignment: center;"
               text="👤" />
        <VBox spacing="5">
            <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                   text="Mon Profil">
                <font><Font name="System Bold" size="24" /></font>
            </Label>
            <Label fx:id="roleLabel"
                   style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D; -fx-background-color: #E8EAF6;
                          -fx-padding: 4 12; -fx-background-radius: 12;">
                <font><Font name="System Bold" size="14" /></font>
            </Label>
        </VBox>
    </HBox>

    <!-- Formulaire -->
    <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 25;">

        <!-- Section Informations Personnelles -->
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"
               text="📋 Informations Personnelles">
            <font><Font name="System Bold" size="18" /></font>
        </Label>

        <Separator/>

        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="200"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="200"/>
            </columnConstraints>

            <!-- CIN (non modifiable) -->
            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;"
                       text="CIN">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>
                <TextField fx:id="cinField" editable="false"
                           style="-fx-background-color: #F0F0F0; -fx-padding: 10; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Nom -->
            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;"
                       text="Nom *">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>
                <TextField fx:id="nomField" promptText="Votre nom"
                           style="-fx-padding: 10; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Prénom -->
            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;"
                       text="Prénom *">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>
                <TextField fx:id="prenomField" promptText="Votre prénom"
                           style="-fx-padding: 10; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Email -->
            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="1">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;"
                       text="Email *">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>
                <TextField fx:id="emailField" promptText="votre.email@example.com"
                           style="-fx-padding: 10; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Téléphone -->
            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="2">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;"
                       text="Téléphone">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>
                <TextField fx:id="telField" promptText="+216 XX XXX XXX"
                           style="-fx-padding: 10; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Date de naissance -->
            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="2">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;"
                       text="Date de naissance">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>
                <DatePicker fx:id="dateNaissField"
                            style="-fx-padding: 10; -fx-background-radius: 6;"
                            prefWidth="200"/>
            </VBox>

            <!-- Adresse -->
            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="3">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;"
                       text="Adresse">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>
                <TextField fx:id="adresseField" promptText="Votre adresse"
                           style="-fx-padding: 10; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Ville -->
            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="3">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;"
                       text="Ville">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>
                <TextField fx:id="villeField" promptText="Votre ville"
                           style="-fx-padding: 10; -fx-background-radius: 6;"/>
            </VBox>
        </GridPane>

        <!-- Section Mot de Passe -->
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a237e; -fx-padding: 10 0 0 0;"
               text="🔒 Changer le Mot de Passe">
            <font><Font name="System Bold" size="18" /></font>
        </Label>
        <Button fx:id="2fauthBtn" onMouseClicked="#handleNavigateToSettings2FA"
                style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.4), 10, 0, 0, 3);"
                text="Activer l' Authentification a 2 Facteurs  ">
            <font><Font name="System Bold" size="14" /></font>
        </Button>
        <Separator/>

        <GridPane hgap="15" vgap="15">
            <columnConstraints>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="200"/>
                <ColumnConstraints hgrow="SOMETIMES" minWidth="150" prefWidth="200"/>
            </columnConstraints>

            <!-- Ancien mot de passe -->
            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;"
                       text="Ancien mot de passe">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>
                <PasswordField fx:id="ancienMdpField" promptText="••••••••"
                               style="-fx-padding: 10; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Nouveau mot de passe -->
            <VBox spacing="5" GridPane.columnIndex="1" GridPane.rowIndex="0">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;"
                       text="Nouveau mot de passe">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>
                <PasswordField fx:id="nouveauMdpField" promptText="••••••••"
                               style="-fx-padding: 10; -fx-background-radius: 6;"/>
            </VBox>

            <!-- Confirmation -->
            <VBox spacing="5" GridPane.columnIndex="0" GridPane.rowIndex="1">
                <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;"
                       text="Confirmer le mot de passe">
                    <font><Font name="System Bold" size="13" /></font>
                </Label>
                <PasswordField fx:id="confirmMdpField" promptText="••••••••"
                               style="-fx-padding: 10; -fx-background-radius: 6;"/>
            </VBox>
        </GridPane>

        <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D; -fx-font-style: italic;"
               text="💡 Laissez vide pour ne pas modifier le mot de passe">
            <font><Font name="System Italic" size="12" /></font>
        </Label>
    </VBox>

    <!-- Boutons d'action -->
    <HBox spacing="15" alignment="CENTER_RIGHT"
          style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">
        <Button fx:id="cancelBtn" onAction="#handleFermer"
                style="-fx-background-color: #95A5A6; -fx-text-fill: white; -fx-font-size: 14px;
                       -fx-padding: 12 30; -fx-background-radius: 8; -fx-cursor: hand;"
                text="❌ Annuler">
            <font><Font name="System Bold" size="14" /></font>
        </Button>
        <Button fx:id="saveBtn" onAction="#handleSave"
                style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049);
                       -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 30;
                       -fx-background-radius: 8; -fx-cursor: hand;"
                text="💾 Enregistrer">
            <font><Font name="System Bold" size="14" /></font>
        </Button>
        <Button fx:id="desactiverBtn" onAction="#handleDesactiver"
                prefHeight="48" prefWidth="200"
                style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 15px;
                       -fx-background-radius: 10; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.4), 10, 0, 0, 3);"
                text="🗑️  Désactiver mon compte">
            <font><Font name="System Bold" size="15" /></font>
        </Button>
    </HBox>


</VBox>
</ScrollPane>