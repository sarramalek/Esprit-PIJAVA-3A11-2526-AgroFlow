<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.User.AcceuilAgricole">

    <!-- SIDEBAR AGRICOLE -->
    <left>
        <VBox prefWidth="260"
              style="-fx-background-color: #FAFAF5; -fx-border-color: #E8EDE0; -fx-border-width: 0 1 0 0;">
            <padding><Insets top="0" bottom="20" /></padding>

            <!-- Logo Header -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #FFFFFF; -fx-padding: 16 20; -fx-border-color: #E8EDE0; -fx-border-width: 0 0 1 0;">
                <StackPane prefWidth="36" prefHeight="36">
                    <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                        <image><Image url="/style/logo.png"/></image>
                    </ImageView>
                </StackPane>
                <Label text="AgroFlow"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1B5E20;">
                    <font><Font name="System Bold" size="20" /></font>
                </Label>
            </HBox>

            <!-- User Info Card -->
            <VBox alignment="CENTER" spacing="6"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #E8EDE0;
                     -fx-border-width: 0 0 1 0; -fx-padding: 18 20;">

                <StackPane prefWidth="64" prefHeight="64">
                    <!-- Avatar background circle -->
                    <Circle fx:id="sidebarAvatarBg" radius="32"
                            fill="#E8F5E9" />
                    <!-- Default emoji -->
                    <Label fx:id="sidebarAvatarDefault"
                           style="-fx-font-size: 28px;"
                           text="👨‍🌾" />
                    <!-- Cloudinary photo -->
                    <ImageView fx:id="sidebarAvatarImageView"
                               fitWidth="64" fitHeight="64"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>

                <Label fx:id="userNameLabel"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A2E1A;"
                       text="Nom Agriculteur">
                    <font><Font name="System Bold" size="15" /></font>
                </Label>

                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;
                          -fx-background-color: #E8F5E9; -fx-padding: 3 10;
                          -fx-background-radius: 20;"
                       text="🌾 AGRICULTEUR">
                    <font><Font name="System Bold" size="11" /></font>
                </Label>

                <Hyperlink fx:id="aproposLink" text="👤 À propos de moi"
                           onAction="#handleAPropos"
                           style="-fx-text-fill: #388E3C; -fx-font-size: 12px;
                              -fx-border-color: #C8E6C9; -fx-padding: 4 14;
                              -fx-background-radius: 20; -fx-border-radius: 20;
                              -fx-cursor: hand; -fx-underline: false;">
                    <font><Font name="System" size="12" /></font>
                </Hyperlink>
            </VBox>

            <!-- Navigation Label -->
            <Label text="NAVIGATION"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9E9E9E;
                      -fx-padding: 16 20 6 20; -fx-letter-spacing: 1px;">
                <font><Font name="System Bold" size="10" /></font>
            </Label>

            <!-- Navigation Menu -->
            <VBox spacing="2" style="-fx-padding: 0 12;">

                <!-- Accueil - Active State -->
                <Button onAction="#handleDashboard" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: #E8F5E9; -fx-text-fill: #1B5E20;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #A5D6A7; -fx-border-radius: 10; -fx-border-width: 1;"
                        text="📊  Accueil">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Ouvriers -->
                <Button onMouseClicked="#handlemesouvriers" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="👷  Mes Ouvriers">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Terrains avec sous-menu -->
                <VBox spacing="0">
                    <Button onMouseClicked="#handleMesTerrains" prefHeight="44" prefWidth="236"
                            style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                               -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                            text="🌾  Mes Terrains  ▾">
                        <font><Font name="System Bold" size="13" /></font>
                    </Button>
                    <!-- Sous-menu -->
                    <VBox fx:id="terrainsSubMenu" spacing="1"
                          style="-fx-padding: 2 0 2 12;" visible="false" managed="false">
                        <Button onMouseClicked="#ouvrirTerrains" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: #F1F8E9; -fx-text-fill: #33691E;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-border-color: #DCEDC8; -fx-border-radius: 8; -fx-border-width: 1;"
                                text="🚜  Terrains">
                            <font><Font name="System Bold" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirPlantes" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🌱  Plantes">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirRotations" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="📋  Rotations">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Mes Animaux -->
                <Button onMouseClicked="#handleMesAnimaux" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="🐄  Mes Animaux">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Stocks -->
                <Button onMouseClicked="#handleMesArticles" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="📦  Mes Stocks">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mon Matériel -->
                <Button onMouseClicked="#ouvrirMachine" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="🚜  Mon Matériel">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Abonnements -->
                <Button onMouseClicked="#handleMonAbonnement" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="💳  Mes Abonnements">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Événements -->
                <Button onMouseClicked="#handleMesEvenements" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="📅  Événements">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Separator -->
            <Separator style="-fx-background-color: #E0E8D8;" />

            <!-- Déconnexion -->
            <VBox style="-fx-padding: 12 12 0 12;">
                <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: #FFF3F3; -fx-text-fill: #C62828;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #FFCDD2; -fx-border-radius: 10; -fx-border-width: 1;"
                        text="🚪  Déconnexion">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>
            </VBox>

        </VBox>
    </left>


    <!-- MAIN CONTENT -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #F8F9FA; -fx-border-color: transparent;">
            <VBox spacing="25" style="-fx-background-color: #F8F9FA;">
                <padding><Insets bottom="35" left="35" right="35" top="35" /></padding>

                <!-- Top Bar -->
                <HBox alignment="CENTER_LEFT" spacing="25"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;"
                                   text="Bienvenue,">
                                <font><Font name="System Bold" size="30" /></font>
                            </Label>
                            <!-- Nom dynamique dans le titre -->
                            <Label fx:id="welcomeNameLabel"
                                   style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #4CAF50;"
                                   text="Agriculteur">
                                <font><Font name="System Bold" size="30" /></font>
                            </Label>
                            <Label style="-fx-background-color: #E8F5E9; -fx-text-fill: #2E7D32;
                                          -fx-padding: 6 12; -fx-background-radius: 20;
                                          -fx-font-size: 12px; -fx-font-weight: bold;" text="ACTIF">
                                <font><Font name="System Bold" size="12" /></font>
                            </Label>
                        </HBox>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;"
                               text="Gérez votre exploitation agricole en toute simplicité">
                            <font><Font name="System" size="14" /></font>
                        </Label>
                    </VBox>
                    <Label style="-fx-font-size: 28px; -fx-background-color: linear-gradient(to bottom right, #4CAF50, #388E3C);
                                  -fx-text-fill: white; -fx-padding: 15; -fx-background-radius: 50%;
                                  -fx-min-width: 60; -fx-min-height: 60; -fx-alignment: center;" text="🌾" />
                </HBox>

                <!-- Stats Cards -->
                <GridPane hgap="20" vgap="20">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50" />
                    </columnConstraints>

                    <VBox spacing="15" GridPane.columnIndex="0" GridPane.rowIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label style="-fx-font-size: 36px; -fx-background-color: linear-gradient(to bottom right, #8BC34A, #689F38);
                                          -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 12;" text="🌾" />
                            <VBox spacing="3">
                                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="0">
                                    <font><Font name="System Bold" size="26" /></font>
                                </Label>
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D;" text="Terrains" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="0"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label style="-fx-font-size: 36px; -fx-background-color: linear-gradient(to bottom right, #8D6E63, #6D4C41);
                                          -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 12;" text="🐄" />
                            <VBox spacing="3">
                                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="0">
                                    <font><Font name="System Bold" size="26" /></font>
                                </Label>
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D;" text="Animaux" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="15" GridPane.columnIndex="0" GridPane.rowIndex="1"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label style="-fx-font-size: 36px; -fx-background-color: linear-gradient(to bottom right, #FF9800, #F57C00);
                                          -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 12;" text="📦" />
                            <VBox spacing="3">
                                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="0">
                                    <font><Font name="System Bold" size="26" /></font>
                                </Label>
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D;" text="Produits en stock" />
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="15" GridPane.columnIndex="1" GridPane.rowIndex="1"
                          style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25;
                                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                        <HBox alignment="CENTER_LEFT" spacing="15">
                            <Label style="-fx-font-size: 36px; -fx-background-color: linear-gradient(to bottom right, #607D8B, #455A64);
                                          -fx-text-fill: white; -fx-padding: 12; -fx-background-radius: 12;" text="🚜" />
                            <VBox spacing="3">
                                <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="0">
                                    <font><Font name="System Bold" size="26" /></font>
                                </Label>
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D;" text="Équipements" />
                            </VBox>
                        </HBox>
                    </VBox>
                </GridPane>

                <!-- Mes Abonnements -->
                <VBox spacing="20"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                               text="💳 Mes Abonnements">
                            <font><Font name="System Bold" size="22" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onMouseClicked="#handleMonAbonnement"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 13px;
                                       -fx-padding: 8 18; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🔄 Actualiser">
                            <font><Font name="System Bold" size="13" /></font>
                        </Button>
                    </HBox>
                    <!-- Container rempli dynamiquement -->
                    <VBox fx:id="abonnementsContainer" spacing="12" />
                </VBox>

                <!-- Accès Rapide -->
                <VBox spacing="20"
                      style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                    <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;"
                           text="⚡ Accès Rapide">
                        <font><Font name="System Bold" size="22" /></font>
                    </Label>
                    <GridPane hgap="15" vgap="15">
                        <Button onMouseClicked="#handleMesTerrains" prefHeight="80" prefWidth="180"
                                style="-fx-background-color: linear-gradient(to bottom right, #8BC34A, #689F38);
                                       -fx-background-radius: 12; -fx-cursor: hand;"
                                GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <graphic>
                                <VBox alignment="CENTER" spacing="6">
                                    <Label style="-fx-font-size: 26px;" text="🌾" />
                                    <Label style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: bold;" text="Mes Terrains">
                                        <font><Font name="System Bold" size="13" /></font>
                                    </Label>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button onMouseClicked="#handleMesAnimaux" prefHeight="80" prefWidth="180"
                                style="-fx-background-color: linear-gradient(to bottom right, #8D6E63, #6D4C41);
                                       -fx-background-radius: 12; -fx-cursor: hand;"
                                GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <graphic>
                                <VBox alignment="CENTER" spacing="6">
                                    <Label style="-fx-font-size: 26px;" text="🐄" />
                                    <Label style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: bold;" text="Mes Animaux">
                                        <font><Font name="System Bold" size="13" /></font>
                                    </Label>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button onMouseClicked="#handleMesArticles" prefHeight="80" prefWidth="180"
                                style="-fx-background-color: linear-gradient(to bottom right, #FF9800, #F57C00);
                                       -fx-background-radius: 12; -fx-cursor: hand;"
                                GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <graphic>
                                <VBox alignment="CENTER" spacing="6">
                                    <Label style="-fx-font-size: 26px;" text="📦" />
                                    <Label style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: bold;" text="Mes Stocks">
                                        <font><Font name="System Bold" size="13" /></font>
                                    </Label>
                                </VBox>
                            </graphic>
                        </Button>
                        <Button onMouseClicked="#ouvrirMachine" prefHeight="80" prefWidth="180"
                                style="-fx-background-color: linear-gradient(to bottom right, #607D8B, #455A64);
                                       -fx-background-radius: 12; -fx-cursor: hand;"
                                GridPane.columnIndex="3" GridPane.rowIndex="0">
                            <graphic>
                                <VBox alignment="CENTER" spacing="6">
                                    <Label style="-fx-font-size: 26px;" text="🚜" />
                                    <Label style="-fx-font-size: 13px; -fx-text-fill: white; -fx-font-weight: bold;" text="Mon Matériel">
                                        <font><Font name="System Bold" size="13" /></font>
                                    </Label>
                                </VBox>
                            </graphic>
                        </Button>
                    </GridPane>
                </VBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>