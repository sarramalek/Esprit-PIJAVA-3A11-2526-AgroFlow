<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane
        style="-fx-background-color: #F0F4FF;"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controllers.User.ModifierOffre"
        prefHeight="580.0"
        prefWidth="560.0">

    <center>
        <VBox alignment="TOP_CENTER" spacing="0">

            <!-- Header Banner -->
            <VBox alignment="CENTER" spacing="6"
                  style="-fx-background-color: #6A1B9A;
                         -fx-padding: 28 40 24 40;">
                <Label fx:id="titleLabel" text="✏️  Modifier l'offre"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;">
                    <font><Font name="System Bold" size="22.0"/></font>
                </Label>
                <Label text="Modifiez les informations de l'offre"
                       style="-fx-font-size: 12px; -fx-text-fill: #CE93D8; -fx-font-style: italic;">
                    <font><Font name="System Italic" size="12.0"/></font>
                </Label>
            </VBox>

            <!-- Card Form -->
            <VBox spacing="16"
                  style="-fx-background-color: white;
                         -fx-padding: 28 36 28 36;
                         -fx-effect: dropshadow(gaussian, rgba(106,27,154,0.12), 16, 0, 0, 4);">

                <!-- Error Label -->
                <Label fx:id="errorLabel" visible="false" wrapText="true" maxWidth="Infinity"
                       style="-fx-text-fill: #C62828; -fx-font-size: 12px;
                              -fx-background-color: #FFEBEE; -fx-background-radius: 6;
                              -fx-padding: 10 14; -fx-border-color: #EF9A9A;
                              -fx-border-radius: 6; -fx-border-width: 1;"/>

                <!-- Nom -->
                <VBox spacing="4">
                    <Label text="Nom de l'offre *"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474F;">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <TextField fx:id="nomField" promptText="Ex: Offre Premium"
                               style="-fx-font-size: 13px; -fx-padding: 9 12;
                                      -fx-background-color: #FDF8FF;
                                      -fx-border-color: #E1BEE7; -fx-border-radius: 7;
                                      -fx-background-radius: 7; -fx-border-width: 1.5;"/>
                </VBox>

                <!-- Description -->
                <VBox spacing="4">
                    <Label text="Description *"
                           style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474F;">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <TextArea fx:id="descriptionArea" promptText="Décrivez l'offre en détail..."
                              prefRowCount="4" wrapText="true"
                              style="-fx-font-size: 13px; -fx-padding: 9 12;
                                     -fx-background-color: #FDF8FF;
                                     -fx-border-color: #E1BEE7; -fx-border-radius: 7;
                                     -fx-background-radius: 7; -fx-border-width: 1.5;"/>
                </VBox>

                <!-- Prix + Durée side by side -->
                <HBox spacing="16">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Prix (DT) *"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474F;">
                            <font><Font name="System Bold" size="12.0"/></font>
                        </Label>
                        <TextField fx:id="prixField" promptText="Ex: 99.99"
                                   style="-fx-font-size: 13px; -fx-padding: 9 12;
                                          -fx-background-color: #FDF8FF;
                                          -fx-border-color: #E1BEE7; -fx-border-radius: 7;
                                          -fx-background-radius: 7; -fx-border-width: 1.5;"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Durée (jours) *"
                               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474F;">
                            <font><Font name="System Bold" size="12.0"/></font>
                        </Label>
                        <TextField fx:id="dureeField" promptText="Ex: 30"
                                   style="-fx-font-size: 13px; -fx-padding: 9 12;
                                          -fx-background-color: #FDF8FF;
                                          -fx-border-color: #E1BEE7; -fx-border-radius: 7;
                                          -fx-background-radius: 7; -fx-border-width: 1.5;"/>
                    </VBox>
                </HBox>

                <Separator style="-fx-background-color: #F3E5F5;"/>

                <!-- Footer -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="* Champs obligatoires"
                           style="-fx-font-size: 11px; -fx-text-fill: #90A4AE; -fx-font-style: italic;">
                        <font><Font name="System Italic" size="11.0"/></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="cancelButton" text="Annuler" onAction="#handleCancel"
                            minWidth="110"
                            style="-fx-background-color: transparent; -fx-text-fill: #546E7A;
                                   -fx-font-size: 13px; -fx-padding: 10 24; -fx-background-radius: 7;
                                   -fx-border-color: #B0BEC5; -fx-border-radius: 7;
                                   -fx-border-width: 1.5; -fx-cursor: hand;">
                        <font><Font name="System" size="13"/></font>
                    </Button>
                    <Button fx:id="saveButton" text="Enregistrer" onAction="#handleSave"
                            defaultButton="true" minWidth="130"
                            style="-fx-background-color: #6A1B9A; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-padding: 10 24; -fx-background-radius: 7; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(106,27,154,0.35), 8, 0, 0, 2);">
                        <font><Font name="System Bold" size="13"/></font>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
