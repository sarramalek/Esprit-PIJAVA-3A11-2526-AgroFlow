<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import org.controlsfx.control.HyperlinkLabel?>
<BorderPane style="-fx-background-color: #fcf8e6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.User.GestionAbonnements">

    <!-- SIDEBAR MODERNISÉE -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color:  #2C3E50;">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Logo/Header MODERNE -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 0 0 35 0;">
                <Label style="-fx-font-size: 32px;" text="🌱" />
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);" text="AgroFlow">
                        <font><Font name="System Bold" size="26" /></font>
                    </Label>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);" text="Gestion Agricole">
                        <font><Font name="System" size="11" /></font>
                    </Label>
                </VBox>
            </HBox>

            <!-- Navigation Menu MODERNISÉE -->
            <VBox spacing="10">
                <!-- Dashboard -->
                <Button fx:id="dashboardBtn" onAction="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- GESTION PRINCIPALE avec sous-menu -->
                <VBox fx:id="gestionContainer" prefWidth="230" spacing="5" style="-fx-background-radius: 12;">
                    <Button fx:id="gestionBtn"  prefHeight="50" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"
                            text="⚙️  Gestion Utilisateurs">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                    <!-- Sous-menu MODERNE -->
                    <VBox fx:id="gestionSubmenu" spacing="3" style="-fx-padding: 5 0 5 15; -fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 0 0 12 12;">
                        <Button fx:id="personnesBtn" onMouseClicked="#handlePersonnes" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"
                                text="👥  Personnes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="tachesBtn" onMouseClicked="#handleTaches" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="✓  Tâches">
                            <font><Font name="System" size="13" /></font>
                        </Button>

                        <Button fx:id="abonnementsBtn"  prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="💳  Abonnements">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="offresBtn" onMouseClicked="#handleOffres" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🎁  Offres">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="StatsBtn" onMouseClicked="#openDashboard" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text=" 📊 Statistiques">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Autres boutons MODERNISÉS -->
                <Button fx:id="stocksBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleStocks"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="terrainsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleTerrains"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Terrains">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="animauxBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleAnimals"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Animaux">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="materielBtn" prefHeight="48" prefWidth="230 " onMouseClicked="#handleMateriels"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🔧  Matériel">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="evenementsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleEvents"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🎉  Événements">
                    <font><Font name="System" size="14" /></font>
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout Button MODERNISÉ -->
            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #fcf8e6; -fx-border-color: transparent;">
            <VBox spacing="20" style="-fx-background-color: #fcf8e6;">
                <padding>
                    <Insets bottom="30" left="30" right="30" top="30" />
                </padding>

                <!-- Top Bar -->
                <HBox alignment="CENTER_LEFT" spacing="20">
                    <VBox spacing="5" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Gestion des Abonnements">
                            <font><Font name="System Bold" size="28" /></font>
                        </Label>
                        <Label style="-fx-font-size: 14px; -fx-text-fill: #7F8C8D;" text="Gérez les souscriptions aux offres">
                            <font><Font name="System" size="14" /></font>
                        </Label>
                    </VBox>

                    <!-- User Profile -->
                    <HBox alignment="CENTER" spacing="15">
                        <Button fx:id="addAbonnementBtn" onAction="#handleAddAbonnement"
                                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px;
                                       -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="➕ Nouvel abonnement">
                            <font><Font name="System" size="14" /></font>
                        </Button>
                        <HyperlinkLabel onMouseClicked="#handleMonProfil" text="Mon Profil"/>

                        <Label fx:id="userNameLabel" style="-fx-font-size: 14px; -fx-text-fill: #2C3E50;" text="Admin">
                            <font><Font name="System" size="14" /></font>
                        </Label>
                        <Label style="-fx-font-size: 24px; -fx-background-color: #ECF0F1; -fx-padding: 8; -fx-background-radius: 50%; -fx-cursor: hand;" text="👤" />
                    </HBox>
                </HBox>

                <!-- Statistiques Cards -->
                <HBox spacing="15" alignment="CENTER">
                    <!-- Total abonnements -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 32px;" text="💳" />
                            <VBox spacing="3">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Total">
                                    <font><Font name="System" size="12" /></font>
                                </Label>
                                <Label fx:id="totalAbonnementsLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="0">
                                    <font><Font name="System Bold" size="24" /></font>
                                </Label>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Actifs -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 32px;" text="✅" />
                            <VBox spacing="3">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Actifs">
                                    <font><Font name="System" size="12" /></font>
                                </Label>
                                <Label fx:id="actifsLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27AE60;" text="0">
                                    <font><Font name="System Bold" size="24" /></font>
                                </Label>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- Expirés -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 32px;" text="⏰" />
                            <VBox spacing="3">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Expirés">
                                    <font><Font name="System" size="12" /></font>
                                </Label>
                                <Label fx:id="expiresLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #E74C3C;" text="0">
                                    <font><Font name="System Bold" size="24" /></font>
                                </Label>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- En attente -->
                    <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;
                                                -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label style="-fx-font-size: 32px;" text="⏳" />
                            <VBox spacing="3">
                                <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="En attente">
                                    <font><Font name="System" size="12" /></font>
                                </Label>
                                <Label fx:id="enAttenteLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F39C12;" text="0">
                                    <font><Font name="System Bold" size="24" /></font>
                                </Label>
                            </VBox>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- Liste des Abonnements Card -->
                <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12;
                                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="25" left="25" right="25" top="25" />
                    </padding>

                    <!-- Card Header -->
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Liste des Abonnements">
                            <font><Font name="System Bold" size="20" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="searchField" prefWidth="250" promptText="🔍 Rechercher..."
                                   style="-fx-background-color: #F5F7FA; -fx-background-radius: 8;
                                          -fx-border-color: transparent; -fx-padding: 10;">
                            <font><Font name="System" size="14" /></font>
                        </TextField>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 10 0 8 0;">
                        <Label fx:id="selectedPersonLabel"
                               text="Sélectionnez une personne pour générer son PDF"
                               style="-fx-text-fill: #7F8C8D; -fx-font-size: 12px; -fx-font-style: italic;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="pdfBtn"
                                text="📄  Générer PDF abonnement"
                                onAction="#handleGeneratePdf"
                                disable="true"
                                style="-fx-background-color: #E74C3C;
                   -fx-text-fill: white;
                   -fx-font-size: 12px;
                   -fx-font-weight: bold;
                   -fx-background-radius: 8;
                   -fx-padding: 8 20 8 20;
                   -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.4), 8, 0, 0, 2);" />
                    </HBox>

                    <!-- Table -->
                    <TableView fx:id="abonnementsTable" prefHeight="400.0" minHeight="350.0" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <columns>
                            <TableColumn fx:id="idColumn" prefWidth="70" style="-fx-alignment: CENTER;" text="ID" />
                            <TableColumn fx:id="cinColumn" prefWidth="120" style="-fx-alignment: CENTER;" text="CIN" />
                            <TableColumn fx:id="offreColumn" prefWidth="200" style="-fx-alignment: CENTER-LEFT;" text="Offre" />
                            <TableColumn fx:id="dateInscriptionColumn" prefWidth="140" style="-fx-alignment: CENTER;" text="Date inscription" />
                            <TableColumn fx:id="dateExpirationColumn" prefWidth="140" style="-fx-alignment: CENTER;" text="Date expiration" />
                            <TableColumn fx:id="situationColumn" prefWidth="130" style="-fx-alignment: CENTER;" text="Situation" />
                            <TableColumn fx:id="actionsColumn" prefWidth="200" style="-fx-alignment: CENTER;" text="Actions" />
                        </columns>
                    </TableView>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
