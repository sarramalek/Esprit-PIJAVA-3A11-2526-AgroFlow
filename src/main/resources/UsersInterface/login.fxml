<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.Font?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controllers.User.Authentification"
            prefHeight="700.0" prefWidth="1500.0"
            style="-fx-background-color: #e8f5e9;">

    <!-- ══ FOND décoratif — bulles vertes douces ══ -->
    <Ellipse centerX="-40" centerY="350" radiusX="220" radiusY="380"
             fill="#c8e6c9" layoutX="0" layoutY="0" opacity="0.6"/>
    <Ellipse centerX="1460" centerY="100" radiusX="180" radiusY="260"
             fill="#c8e6c9" layoutX="0" layoutY="0" opacity="0.5"/>
    <Ellipse centerX="1300" centerY="580" radiusX="140" radiusY="130"
             fill="#a5d6a7" layoutX="0" layoutY="0" opacity="0.35"/>
    <Ellipse centerX="250" centerY="620" radiusX="110" radiusY="90"
             fill="#a5d6a7" layoutX="0" layoutY="0" opacity="0.25"/>

    <!-- Points décoratifs -->
    <Circle centerX="80"   centerY="80"  radius="5" fill="#4CAF50" opacity="0.35" layoutX="0" layoutY="0"/>
    <Circle centerX="160"  centerY="180" radius="3" fill="#66BB6A" opacity="0.3"  layoutX="0" layoutY="0"/>
    <Circle centerX="55"   centerY="520" radius="4" fill="#4CAF50" opacity="0.25" layoutX="0" layoutY="0"/>
    <Circle centerX="1380" centerY="55"  radius="6" fill="#43A047" opacity="0.2"  layoutX="0" layoutY="0"/>
    <Circle centerX="1420" centerY="450" radius="3" fill="#66BB6A" opacity="0.3"  layoutX="0" layoutY="0"/>
    <Circle centerX="400"  centerY="30"  radius="4" fill="#4CAF50" opacity="0.2"  layoutX="0" layoutY="0"/>

    <!-- ══ PARTIE GAUCHE — Branding (750px) ══ -->
    <VBox alignment="CENTER" layoutX="0" layoutY="0"
          prefWidth="750" prefHeight="700"
          spacing="30">
        <padding><Insets top="60" bottom="60" left="100" right="80"/></padding>

        <!-- Logo -->
        <StackPane prefWidth="300" prefHeight="350"
                   style="-fx-background-color: rgba(76,175,80,0.15);
                          -fx-background-radius: 40;
                          -fx-border-color: rgba(76,175,80,0.4);
                          -fx-border-radius: 40;
                          -fx-border-width: 2;
                          -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.25), 20, 0, 0, 4);">
            <ImageView fitWidth="400" fitHeight="200" preserveRatio="true">
                <image><Image url="/style/logo.png"/></image>
            </ImageView>

        </StackPane>

        <!-- Nom de l'app -->
        <VBox alignment="CENTER_LEFT" spacing="8">

            <Label text="Gérez votre exploitation agricole intelligemment."
                   style="-fx-font-size: 16px; -fx-text-fill: #558B2F;">
                <font><Font name="System" size="16"/></font>
            </Label>
        </VBox>

        <!-- Séparateur décoratif -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Rectangle width="50" height="3" arcWidth="3" arcHeight="3" fill="#4CAF50"/>
            <Rectangle width="18" height="3" arcWidth="3" arcHeight="3" fill="rgba(76,175,80,0.5)"/>
            <Rectangle width="9"  height="3" arcWidth="3" arcHeight="3" fill="rgba(76,175,80,0.25)"/>
        </HBox>

        <!-- Features pills -->
        <VBox spacing="18">
            <HBox spacing="18" alignment="CENTER_LEFT">
                <StackPane prefWidth="44" prefHeight="44"
                           style="-fx-background-color: rgba(76,175,80,0.18); -fx-background-radius: 12;">
                    <Label text="🌾" style="-fx-font-size: 20px;"/>
                </StackPane>
                <Label text="Gestion des terrains &amp; cultures"
                       style="-fx-font-size: 15px; -fx-text-fill: #33691E;">
                    <font><Font name="System" size="15"/></font>
                </Label>
            </HBox>
            <HBox spacing="18" alignment="CENTER_LEFT">
                <StackPane prefWidth="44" prefHeight="44"
                           style="-fx-background-color: rgba(76,175,80,0.18); -fx-background-radius: 12;">
                    <Label text="📊" style="-fx-font-size: 20px;"/>
                </StackPane>
                <Label text="Suivi en temps réel des ressources"
                       style="-fx-font-size: 15px; -fx-text-fill: #33691E;">
                    <font><Font name="System" size="15"/></font>
                </Label>
            </HBox>
            <HBox spacing="18" alignment="CENTER_LEFT">
                <StackPane prefWidth="44" prefHeight="44"
                           style="-fx-background-color: rgba(76,175,80,0.18); -fx-background-radius: 12;">
                    <Label text="👥" style="-fx-font-size: 20px;"/>
                </StackPane>
                <Label text="Gestion équipe &amp; affectations"
                       style="-fx-font-size: 15px; -fx-text-fill: #33691E;">
                    <font><Font name="System" size="15"/></font>
                </Label>
            </HBox>
        </VBox>

        <Region VBox.vgrow="ALWAYS"/>

        <Label text="© 2025 AgroFlow · Tous droits réservés"
               style="-fx-font-size: 12px; -fx-text-fill: #A5D6A7;">
            <font><Font name="System" size="12"/></font>
        </Label>
    </VBox>

    <!-- ══ SÉPARATEUR VERTICAL ══ -->
    <Line startX="0" endX="0" startY="60" endY="640"
          layoutX="750" layoutY="0"
          stroke="rgba(76,175,80,0.25)" strokeWidth="1"/>

    <!-- ══ PARTIE DROITE — Formulaire (750px) ══ -->
    <VBox layoutX="750" layoutY="0"
          prefWidth="750" prefHeight="700"
          alignment="CENTER" spacing="0">
        <padding><Insets top="60" bottom="50" left="150" right="150"/></padding>

        <!-- Titre -->
        <Label text="Bon retour ! 👋"
               style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: #1B5E20;">
            <font><Font name="System Bold" size="34"/></font>
        </Label>
        <Region prefHeight="8"/>
        <Label text="Connectez-vous à votre espace"
               style="-fx-font-size: 15px; -fx-text-fill: #78909C;">
            <font><Font name="System" size="15"/></font>
        </Label>

        <Region prefHeight="40"/>

        <!-- ── Email ── -->
        <VBox spacing="8" prefWidth="440">
            <Label text="ADRESSE EMAIL"
                   style="-fx-font-size: 11px; -fx-text-fill: #78909C;
                          -fx-font-weight: bold; -fx-padding: 0 0 0 4;">
                <font><Font name="System Bold" size="11"/></font>
            </Label>
            <StackPane>
                <TextField fx:id="emailField"
                           promptText="votre@email.com"
                           prefHeight="52" prefWidth="440"
                           style="-fx-background-color: white;
                                  -fx-background-radius: 12;
                                  -fx-border-color: #c5e1a5;
                                  -fx-border-radius: 12; -fx-border-width: 1.5;
                                  -fx-padding: 0 16 0 48;
                                  -fx-font-size: 15px; -fx-text-fill: #2E3B2E;
                                  -fx-prompt-text-fill: #B0BEC5;
                                  -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <font><Font name="System" size="15"/></font>
                </TextField>
                <Label text="✉" style="-fx-font-size: 17px; -fx-text-fill: #A5D6A7;"
                       translateX="-192"/>
            </StackPane>
        </VBox>

        <Region prefHeight="18"/>

        <!-- ── Mot de passe ── -->
        <VBox spacing="8" prefWidth="440">
            <Label text="MOT DE PASSE"
                   style="-fx-font-size: 11px; -fx-text-fill: #78909C;
                          -fx-font-weight: bold; -fx-padding: 0 0 0 4;">
                <font><Font name="System Bold" size="11"/></font>
            </Label>
            <StackPane>
                <PasswordField fx:id="passwordField"
                               promptText="••••••••"
                               prefHeight="52" prefWidth="440"
                               style="-fx-background-color: white;
                                      -fx-background-radius: 12;
                                      -fx-border-color: #c5e1a5;
                                      -fx-border-radius: 12; -fx-border-width: 1.5;
                                      -fx-padding: 0 16 0 48;
                                      -fx-font-size: 15px; -fx-text-fill: #2E3B2E;
                                      -fx-prompt-text-fill: #B0BEC5;
                                      -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">
                    <font><Font name="System" size="15"/></font>
                </PasswordField>
                <Label text="🔑" style="-fx-font-size: 16px; -fx-text-fill: #A5D6A7;"
                       translateX="-192"/>
            </StackPane>
        </VBox>

        <Region prefHeight="10"/>

        <!-- Mot de passe oublié -->
        <HBox prefWidth="440" alignment="CENTER_RIGHT">
            <Hyperlink fx:id="forgotPasswordLink" text="Mot de passe oublié ?"
                       onAction="#handleForgotPassword"
                       style="-fx-text-fill: #558B2F; -fx-font-size: 13px;
                              -fx-border-color: transparent; -fx-cursor: hand;">
                <font><Font name="System" size="13"/></font>
            </Hyperlink>
        </HBox>

        <Region prefHeight="28"/>

        <!-- ── Bouton Connexion ── -->
        <Button fx:id="loginButton" text="Se connecter  →"
                onAction="#handleLogin"
                prefWidth="440" prefHeight="54"
                style="-fx-background-color: linear-gradient(to right, #66BB6A, #2E7D32);
                       -fx-text-fill: white; -fx-font-size: 17px; -fx-font-weight: bold;
                       -fx-background-radius: 14; -fx-cursor: hand;
                       -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.45), 18, 0, 0, 4);">
            <font><Font name="System Bold" size="17"/></font>
        </Button>

        <Region prefHeight="16"/>

        <!-- Message erreur -->
        <Label fx:id="errorLabel" text=""
               prefWidth="440"
               style="-fx-text-fill: #C62828; -fx-font-size: 13px;
                      -fx-background-color: #FFEBEE;
                      -fx-background-radius: 8; -fx-padding: 10 14;"
               visible="false">
            <font><Font name="System" size="13"/></font>
        </Label>

        <Region prefHeight="16"/>

        <!-- Séparateur -->
        <HBox alignment="CENTER" spacing="12">
            <Line startX="0" endX="165" stroke="#c5e1a5" strokeWidth="1"/>
            <Label text="ou" style="-fx-font-size: 12px; -fx-text-fill: #A5C8A5;">
                <font><Font name="System" size="12"/></font>
            </Label>
            <Line startX="0" endX="165" stroke="#c5e1a5" strokeWidth="1"/>
        </HBox>

        <Region prefHeight="16"/>

        <!-- Créer compte -->
        <HBox alignment="CENTER" spacing="5">
            <Label text="Pas encore de compte ?"
                   style="-fx-font-size: 14px; -fx-text-fill: #90A4AE;">
                <font><Font name="System" size="14"/></font>
            </Label>
            <Hyperlink fx:id="signupLink" text="Créer un compte"
                       onAction="#handleSignup"
                       style="-fx-text-fill: #2E7D32; -fx-font-size: 14px;
                              -fx-font-weight: bold; -fx-border-color: transparent;
                              -fx-cursor: hand;">
                <font><Font name="System Bold" size="14"/></font>
            </Hyperlink>
        </HBox>

    </VBox>

</AnchorPane>
