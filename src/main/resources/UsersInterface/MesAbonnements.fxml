<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.User.MesAbonnements"  prefHeight="700.0" prefWidth="1500.0">

    <!-- SIDEBAR AGRICOLE -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: linear-gradient(to bottom, #2E7D32, #388E3C, #43A047);">
            <padding><Insets bottom="20" top="20" /></padding>

            <!-- Logo -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 0 0 20 0;">
                <Label style="-fx-font-size: 32px;" text="🌱" />
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;" text="AgroFlow">
                        <font><Font name="System Bold" size="26" /></font>
                    </Label>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);" text="Mon Exploitation">
                        <font><Font name="System" size="11" /></font>
                    </Label>
                </VBox>
            </HBox>

            <!-- Info Utilisateur -->
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15; -fx-padding: 20; -fx-margin: 10;">
                <Label style="-fx-font-size: 30px;" text="👨‍🌾" />
                <Label fx:id="userNameLabel1"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"
                       text="Nom Agriculteur">
                    <font><Font name="System Bold" size="16" /></font>
                </Label>
                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);
                              -fx-background-color: rgba(76,175,80,0.3); -fx-padding: 4 12;
                              -fx-background-radius: 15;"
                       text="🌾 AGRICULTEUR">
                    <font><Font name="System Bold" size="12" /></font>
                </Label>
                <Hyperlink fx:id="aproposLink" text="👤 À propos de moi"
                           onAction="#handleAPropos"
                           style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13px;
                                  -fx-border-color: rgba(255,255,255,0.4); -fx-padding: 5 15;
                                  -fx-background-radius: 20; -fx-border-radius: 20;
                                  -fx-cursor: hand;">
                    <font><Font name="System" size="13" /></font>
                </Hyperlink>
            </VBox>

            <!-- Navigation Menu -->
            <VBox spacing="8" style="-fx-padding: 20 0 0 0;">
                <Button onAction="#handleDashboard" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
                <Button onAction="#handleMesTerrains" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Mes Terrains">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
                <Button onAction="#handleMesAnimaux" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Mes Animaux">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
                <Button onAction="#handleMesStocks" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Mes Stocks">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
                <Button onAction="#handleMonMateriel" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🚜  Mon Matériel">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
                <Button onAction="#handleMonAbonnement" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049);
                               -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="💳  Mes Abonnements">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12;
                           -fx-cursor: hand;"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <AnchorPane fx:id="rootPane" style="-fx-background-color: #e8f5e9;">

            <VBox spacing="20" AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
                  AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

                <!-- Header -->
                <HBox style="-fx-background-color: #2e7d32; -fx-padding: 20;">
                    <Label text="Gestion des Abonnements AgroFlow" textFill="white">
                        <font><Font name="System Bold" size="24"/></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="userNameLabel" text="Utilisateur: " textFill="white">
                        <font><Font size="16"/></font>
                    </Label>
                </HBox>

                <!-- Contenu principal -->
                <HBox spacing="20" VBox.vgrow="ALWAYS">
                    <padding><Insets top="20" right="20" bottom="20" left="20"/></padding>

                    <!-- Section gauche - Mes Abonnements -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;"
                          prefWidth="400" HBox.hgrow="NEVER">

                        <Label text="Mes Abonnements Actifs"
                               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                        <Separator/>

                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                    style="-fx-background-color: transparent; -fx-border-color: transparent;">
                            <VBox fx:id="mesAbonnementsContainer" spacing="10"/>
                        </ScrollPane>

                        <Label fx:id="noAbonnementLabel" text="Aucun abonnement actif"
                               style="-fx-text-fill: #666; -fx-font-style: italic;"
                               visible="false" managed="false"/>
                    </VBox>

                    <!-- Section droite - Offres disponibles -->
                    <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20;"
                          HBox.hgrow="ALWAYS">

                        <Label text="Offres Disponibles"
                               style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                        <Separator/>

                        <HBox spacing="10" alignment="CENTER_RIGHT">
                            <Button text="🔄 Actualiser" onAction="#onRefreshOffres"
                                    style="-fx-background-color: #66bb6a; -fx-text-fill: white; -fx-cursor: hand;"/>
                        </HBox>

                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                    style="-fx-background-color: transparent; -fx-border-color: transparent;">
                            <VBox fx:id="offresContainer" spacing="15"/>
                        </ScrollPane>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Dialog Overlay -->
            <StackPane fx:id="dialogOverlay" visible="false" managed="false"
                       style="-fx-background-color: rgba(0,0,0,0.5);"
                       AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                       AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

                <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 30;"
                      maxWidth="600" maxHeight="500">

                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="dialogTitleLabel" text="Détails de l'offre"
                               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="✕" onAction="#onCloseDialog"
                                style="-fx-background-color: transparent; -fx-font-size: 20; -fx-cursor: hand;"/>
                    </HBox>

                    <Separator/>

                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <VBox fx:id="dialogContent" spacing="15">
                            <Label fx:id="dialogDescriptionLabel" wrapText="true"/>

                            <HBox spacing="30">
                                <VBox spacing="5">
                                    <Label text="Prix:" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="dialogPrixLabel" style="-fx-font-size: 24; -fx-text-fill: #2e7d32;"/>
                                </VBox>

                                <VBox spacing="5">
                                    <Label text="Durée:" style="-fx-font-weight: bold;"/>
                                    <Label fx:id="dialogDureeLabel" style="-fx-font-size: 16;"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="5">
                                <Label text="Date de début:" style="-fx-font-weight: bold;"/>
                                <DatePicker fx:id="dateDebutPicker" promptText="Sélectionnez la date de début"/>
                            </VBox>
                        </VBox>
                    </ScrollPane>

                    <HBox spacing="15" alignment="CENTER_RIGHT">
                        <Button text="Annuler" onAction="#onCloseDialog"
                                style="-fx-background-color: #e0e0e0; -fx-text-fill: #333; -fx-cursor: hand; -fx-padding: 10 20;"/>
                        <Button fx:id="souscrireButton" text="S'inscrire à cet abonnement" onAction="#onSouscrire"
                                style="-fx-background-color: #2e7d32; -fx-text-fill: white; -fx-cursor: hand; -fx-padding: 10 20; -fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
            </StackPane>

        </AnchorPane>
    </center>

</BorderPane>