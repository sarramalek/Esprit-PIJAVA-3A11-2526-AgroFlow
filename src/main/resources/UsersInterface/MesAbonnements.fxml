<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.User.MesAbonnements"
            prefHeight="700.0" prefWidth="1500.0">

    <!-- ═══════════════════════════════════════════════════
         SIDEBAR — identique à l'original
    ════════════════════════════════════════════════════ -->
    <!-- SIDEBAR AGRICOLE -->
    <left>
        <VBox prefWidth="260"
              style="-fx-background-color: #FAFAF5; -fx-border-color: #E8EDE0; -fx-border-width: 0 1 0 0;">
            <padding><Insets top="0" bottom="20" /></padding>

            <!-- Logo Header -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #FFFFFF; -fx-padding: 16 20; -fx-border-color: #E8EDE0; -fx-border-width: 0 0 1 0;">
                <StackPane prefWidth="36" prefHeight="36">
                    <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                        <image><Image url="/style/logo.png"/></image>
                    </ImageView>
                </StackPane>
                <Label text="AgroFlow"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1B5E20;">
                    <font><Font name="System Bold" size="20" /></font>
                </Label>
            </HBox>

            <!-- User Info Card -->
            <VBox alignment="CENTER" spacing="6"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #E8EDE0;
                     -fx-border-width: 0 0 1 0; -fx-padding: 18 20;">

                <StackPane prefWidth="64" prefHeight="64">
                    <!-- Avatar background circle -->
                    <Circle fx:id="sidebarAvatarBg" radius="32"
                            fill="#E8F5E9" />
                    <!-- Default emoji -->
                    <Label fx:id="sidebarAvatarDefault"
                           style="-fx-font-size: 28px;"
                           text="👨‍🌾" />
                    <!-- Cloudinary photo -->
                    <ImageView fx:id="sidebarAvatarImageView"
                               fitWidth="64" fitHeight="64"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>

                <Label fx:id="userNameLabel"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A2E1A;"
                       text="Nom Agriculteur">
                    <font><Font name="System Bold" size="15" /></font>
                </Label>

                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;
                          -fx-background-color: #E8F5E9; -fx-padding: 3 10;
                          -fx-background-radius: 20;"
                       text="🌾 AGRICULTEUR">
                    <font><Font name="System Bold" size="11" /></font>
                </Label>

                <Hyperlink fx:id="aproposLink" text="👤 À propos de moi"
                           onAction="#handleAPropos"
                           style="-fx-text-fill: #388E3C; -fx-font-size: 12px;
                              -fx-border-color: #C8E6C9; -fx-padding: 4 14;
                              -fx-background-radius: 20; -fx-border-radius: 20;
                              -fx-cursor: hand; -fx-underline: false;">
                    <font><Font name="System" size="12" /></font>
                </Hyperlink>
            </VBox>

            <!-- Navigation Label -->
            <Label text="NAVIGATION"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9E9E9E;
                      -fx-padding: 16 20 6 20; -fx-letter-spacing: 1px;">
                <font><Font name="System Bold" size="10" /></font>
            </Label>

            <!-- Navigation Menu -->
            <VBox spacing="2" style="-fx-padding: 0 12;">

                <!-- Accueil - Active State -->
                <Button onAction="#handleDashboard" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: #E8F5E9; -fx-text-fill: #1B5E20;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #A5D6A7; -fx-border-radius: 10; -fx-border-width: 1;"
                        text="📊  Accueil">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Ouvriers -->
                <Button onMouseClicked="#handlemesouvriers" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="👷  Mes Ouvriers">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Terrains avec sous-menu -->
                <VBox spacing="0">
                    <Button onMouseClicked="#handleMesTerrains" prefHeight="44" prefWidth="236"
                            style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                               -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                            text="🌾  Mes Terrains  ▾">
                        <font><Font name="System Bold" size="13" /></font>
                    </Button>
                    <!-- Sous-menu -->
                    <VBox fx:id="terrainsSubMenu" spacing="1"
                          style="-fx-padding: 2 0 2 12;" visible="false" managed="false">
                        <Button onMouseClicked="#ouvrirTerrains" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: #F1F8E9; -fx-text-fill: #33691E;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-border-color: #DCEDC8; -fx-border-radius: 8; -fx-border-width: 1;"
                                text="🚜  Terrains">
                            <font><Font name="System Bold" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirPlantes" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🌱  Plantes">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirRotations" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="📋  Rotations">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Mes Animaux -->
                <Button onMouseClicked="#handleMesAnimaux" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="🐄  Mes Animaux">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Stocks -->
                <Button onMouseClicked="#handleMesArticles" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="📦  Mes Stocks">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mon Matériel -->
                <Button onMouseClicked="#handleMonMateriel" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="🚜  Mon Matériel">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Abonnements -->
                <Button onMouseClicked="#handleMonAbonnement" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="💳  Mes Abonnements">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Événements -->
                <Button onMouseClicked="#handleMesEvenements" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="📅  Événements">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Separator -->
            <Separator style="-fx-background-color: #E0E8D8;" />

            <!-- Déconnexion -->
            <VBox style="-fx-padding: 12 12 0 12;">
                <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: #FFF3F3; -fx-text-fill: #C62828;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #FFCDD2; -fx-border-radius: 10; -fx-border-width: 1;"
                        text="🚪  Déconnexion">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>
            </VBox>

        </VBox>
    </left>

    <!-- ═══════════════════════════════════════════════════
         CONTENU PRINCIPAL
    ════════════════════════════════════════════════════ -->
    <center>
        <AnchorPane fx:id="rootPane" style="-fx-background-color: #e8f5e9;">

            <VBox spacing="0"
                  AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0"
                  AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

                <!-- ── Header ──────────────────────────────── -->
                <HBox alignment="CENTER_LEFT" spacing="16"
                      style="-fx-background-color: #2e7d32; -fx-padding: 16 24;">
                    <Label text="💳 Gestion des Abonnements" textFill="white">
                        <font><Font name="System Bold" size="22"/></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="userNameLabel1" text="Utilisateur: " textFill="white">
                        <font><Font size="14"/></font>
                    </Label>
                    <!-- ✅ Bouton PDF global -->
                    <Button text="📥 Exporter tout en PDF"
                            onAction="#handleGeneratePDFTous"
                            style="-fx-background-color: #1565C0; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-padding: 8 18;
                                   -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;">
                        <font><Font name="System Bold" size="13"/></font>
                    </Button>
                    <Button text="🔄 Actualiser" onAction="#onRefreshOffres"
                            style="-fx-background-color: #4CAF50; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-padding: 8 18;
                                   -fx-background-radius: 8; -fx-cursor: hand; -fx-font-size: 13;">
                        <font><Font name="System Bold" size="13"/></font>
                    </Button>
                </HBox>

                <!-- ── Corps : deux colonnes ────────────────── -->
                <HBox spacing="16" VBox.vgrow="ALWAYS">
                    <padding><Insets top="16" right="16" bottom="16" left="16"/></padding>

                    <!-- ══════════════════════════════════════
                         COLONNE GAUCHE — MES ABONNEMENTS
                    ═════════════════════════════════════════= -->
                    <VBox spacing="10"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),8,0,0,2);"
                          prefWidth="450" HBox.hgrow="NEVER">

                        <!-- Titre + compteur -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="📋 Mes Abonnements"
                                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="countAbonnementLabel"
                                   text="0 abonnement(s)"
                                   style="-fx-font-size: 12; -fx-text-fill: #888;
                                          -fx-background-color: #e8f5e9; -fx-padding: 3 10;
                                          -fx-background-radius: 20;"/>
                        </HBox>
                        <Separator/>

                        <!-- ✅ Barre de recherche -->
                        <TextField fx:id="searchAbonnementField"
                                   promptText="🔍  Rechercher (n°, statut, date…)"
                                   style="-fx-background-radius: 20; -fx-border-radius: 20;
                                          -fx-border-color: #c8e6c9; -fx-padding: 7 14;
                                          -fx-font-size: 13;"/>

                        <!-- ✅ Filtre situation + tri -->
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Statut :"
                                   style="-fx-font-size: 12; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="filterSituationCombo" prefWidth="130"
                                      style="-fx-background-radius: 8; -fx-border-radius: 8;
                                             -fx-border-color: #c8e6c9;"/>
                            <Label text="Trier :"
                                   style="-fx-font-size: 12; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="sortAbonnementCombo" prefWidth="180"
                                      style="-fx-background-radius: 8; -fx-border-radius: 8;
                                             -fx-border-color: #c8e6c9;"/>
                        </HBox>

                        <!-- Liste scrollable -->
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                    style="-fx-background-color: transparent;
                                           -fx-border-color: transparent;">
                            <VBox fx:id="mesAbonnementsContainer" spacing="12">
                                <padding><Insets right="4"/></padding>
                            </VBox>
                        </ScrollPane>

                        <Label fx:id="noAbonnementLabel"
                               text="Aucun abonnement trouvé"
                               style="-fx-text-fill: #999; -fx-font-style: italic; -fx-font-size: 13;"
                               visible="false" managed="false"/>
                    </VBox>

                    <!-- ══════════════════════════════════════
                         COLONNE DROITE — OFFRES DISPONIBLES
                    ═════════════════════════════════════════= -->
                    <VBox spacing="10"
                          style="-fx-background-color: white; -fx-background-radius: 12;
                                 -fx-padding: 18;
                                 -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.08),8,0,0,2);"
                          HBox.hgrow="ALWAYS">

                        <!-- Titre + compteur -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="🏷️ Offres Disponibles"
                                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="countOffreLabel"
                                   text="0 offre(s)"
                                   style="-fx-font-size: 12; -fx-text-fill: #888;
                                          -fx-background-color: #e8f5e9; -fx-padding: 3 10;
                                          -fx-background-radius: 20;"/>
                        </HBox>
                        <Separator/>

                        <!-- ✅ Barre de recherche offres -->
                        <TextField fx:id="searchOffreField"
                                   promptText="🔍  Rechercher une offre (nom, description, prix…)"
                                   style="-fx-background-radius: 20; -fx-border-radius: 20;
                                          -fx-border-color: #c8e6c9; -fx-padding: 7 14;
                                          -fx-font-size: 13;"/>

                        <!-- ✅ Tri offres -->
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="Trier :"
                                   style="-fx-font-size: 12; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                            <ComboBox fx:id="sortOffreCombo" prefWidth="200"
                                      style="-fx-background-radius: 8; -fx-border-radius: 8;
                                             -fx-border-color: #c8e6c9;"/>
                        </HBox>

                        <!-- Liste scrollable -->
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                    style="-fx-background-color: transparent;
                                           -fx-border-color: transparent;">
                            <VBox fx:id="offresContainer" spacing="16">
                                <padding><Insets right="4"/></padding>
                            </VBox>
                        </ScrollPane>

                        <Label fx:id="noOffresLabel"
                               text="Aucune offre trouvée"
                               style="-fx-text-fill: #999; -fx-font-style: italic; -fx-font-size: 13;"
                               visible="false" managed="false"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- ═══════════════════════════════════════════
                 DIALOG OVERLAY — Souscription (identique à l'original, mis à jour)
            ════════════════════════════════════════════ -->
            <StackPane fx:id="dialogOverlay" visible="false" managed="false"
                       style="-fx-background-color: rgba(0,0,0,0.55);"
                       AnchorPane.topAnchor="0" AnchorPane.bottomAnchor="0"
                       AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0">

                <VBox spacing="20"
                      style="-fx-background-color: white; -fx-background-radius: 16; -fx-padding: 32;"
                      maxWidth="580" maxHeight="500" minWidth="420">

                    <HBox alignment="CENTER_LEFT">
                        <Label fx:id="dialogTitleLabel" text="Détails de l'offre"
                               style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="✕" onAction="#onCloseDialog"
                                style="-fx-background-color: transparent; -fx-font-size: 20;
                                       -fx-cursor: hand; -fx-text-fill: #999;"/>
                    </HBox>
                    <Separator/>

                    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-border-color: transparent;">
                        <VBox fx:id="dialogContent" spacing="18">
                            <Label fx:id="dialogDescriptionLabel" wrapText="true"
                                   style="-fx-font-size: 13; -fx-text-fill: #555;"/>
                            <HBox spacing="40">
                                <VBox spacing="5">
                                    <Label text="Prix mensuel"
                                           style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                                    <Label fx:id="dialogPrixLabel"
                                           style="-fx-font-size: 26; -fx-text-fill: #2e7d32;
                                                  -fx-font-weight: bold;"/>
                                </VBox>
                                <VBox spacing="5">
                                    <Label text="Durée"
                                           style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                                    <Label fx:id="dialogDureeLabel"
                                           style="-fx-font-size: 18; -fx-text-fill: #333;"/>
                                </VBox>
                            </HBox>
                            <VBox spacing="6">
                                <Label text="Date de début :"
                                       style="-fx-font-weight: bold; -fx-text-fill: #444;"/>
                                <DatePicker fx:id="dateDebutPicker"
                                            promptText="Sélectionnez la date de début"
                                            prefWidth="250"/>
                            </VBox>
                        </VBox>
                    </ScrollPane>

                    <HBox spacing="12" alignment="CENTER_RIGHT">
                        <Button text="Annuler" onAction="#onCloseDialog"
                                style="-fx-background-color: #e0e0e0; -fx-text-fill: #333;
                                       -fx-cursor: hand; -fx-padding: 10 22; -fx-background-radius: 8;"/>
                        <Button fx:id="souscrireButton"
                                text="✅ Confirmer l'abonnement" onAction="#onSouscrire"
                                style="-fx-background-color: #2e7d32; -fx-text-fill: white;
                                       -fx-cursor: hand; -fx-padding: 10 22; -fx-font-weight: bold;
                                       -fx-background-radius: 8;"/>
                    </HBox>
                </VBox>
            </StackPane>

        </AnchorPane>
    </center>

</BorderPane>
