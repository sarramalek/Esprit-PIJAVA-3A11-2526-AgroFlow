<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.shape.Line?>

<BorderPane
        style="-fx-background-color: #F0F4FF;"
        xmlns="http://javafx.com/javafx/17.0.12"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="controllers.User.ModifierPersonne"
        prefHeight="700.0"
        prefWidth="760.0">

    <center>
        <VBox alignment="TOP_CENTER" spacing="0">

            <!-- Header Banner -->
            <VBox alignment="CENTER" spacing="6"
                  style="-fx-background-color: #004D40;
                         -fx-padding: 28 40 24 40;">
                <Label fx:id="titleLabel" text="✏️  Modifier l'employé"
                       style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;">
                    <font><Font name="System Bold" size="22.0"/></font>
                </Label>
                <Label text="Modifiez les informations du membre de l'équipe"
                       style="-fx-font-size: 12px; -fx-text-fill: #80CBC4; -fx-font-style: italic;">
                    <font><Font name="System Italic" size="12.0"/></font>
                </Label>
            </VBox>

            <!-- Card Form -->
            <VBox spacing="16"
                  style="-fx-background-color: white;
                         -fx-padding: 28 36 28 36;
                         -fx-effect: dropshadow(gaussian, rgba(0,77,64,0.12), 16, 0, 0, 4);">

                <!-- Error Label -->
                <Label fx:id="errorLabel" visible="false" wrapText="true" maxWidth="Infinity"
                       style="-fx-text-fill: #C62828; -fx-font-size: 12px;
                              -fx-background-color: #FFEBEE; -fx-background-radius: 6;
                              -fx-padding: 10 14; -fx-border-color: #EF9A9A;
                              -fx-border-radius: 6; -fx-border-width: 1;"/>

                <!-- Two-column layout -->
                <HBox spacing="30">

                    <!-- Left: Identité -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS">
                        <Label text="IDENTITÉ"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #00695C;">
                            <font><Font name="System Bold" size="11.0"/></font>
                        </Label>
                        <Line endX="200" stroke="#B2DFDB" strokeWidth="1.5"/>

                        <!-- CIN readonly -->
                        <VBox spacing="4">
                            <Label text="CIN (non modifiable)"
                                   style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #78909C;">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <TextField fx:id="cinField" editable="false"
                                       style="-fx-font-size: 13px; -fx-padding: 9 12;
                                              -fx-background-color: #ECEFF1;
                                              -fx-border-color: #CFD8DC; -fx-border-radius: 7;
                                              -fx-background-radius: 7; -fx-border-width: 1.5;
                                              -fx-text-fill: #78909C;"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Nom *" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474F;">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <TextField fx:id="nomField" promptText="Nom de famille"
                                       style="-fx-font-size: 13px; -fx-padding: 9 12;
                                              -fx-background-color: #F9FFFE;
                                              -fx-border-color: #B2DFDB; -fx-border-radius: 7;
                                              -fx-background-radius: 7; -fx-border-width: 1.5;"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Prénom *" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474F;">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <TextField fx:id="prenomField" promptText="Prénom"
                                       style="-fx-font-size: 13px; -fx-padding: 9 12;
                                              -fx-background-color: #F9FFFE;
                                              -fx-border-color: #B2DFDB; -fx-border-radius: 7;
                                              -fx-background-radius: 7; -fx-border-width: 1.5;"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Mot de passe *" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474F;">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <PasswordField fx:id="passwordField" promptText="Minimum 6 caractères"
                                           style="-fx-font-size: 13px; -fx-padding: 9 12;
                                                  -fx-background-color: #F9FFFE;
                                                  -fx-border-color: #B2DFDB; -fx-border-radius: 7;
                                                  -fx-background-radius: 7; -fx-border-width: 1.5;"/>
                        </VBox>
                    </VBox>

                    <!-- Right: Coordonnées -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS">
                        <Label text="COORDONNÉES"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #00695C;">
                            <font><Font name="System Bold" size="11.0"/></font>
                        </Label>
                        <Line endX="200" stroke="#B2DFDB" strokeWidth="1.5"/>

                        <VBox spacing="4">
                            <Label text="Email *" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474F;">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <TextField fx:id="emailField" promptText="exemple@email.com"
                                       style="-fx-font-size: 13px; -fx-padding: 9 12;
                                              -fx-background-color: #F9FFFE;
                                              -fx-border-color: #B2DFDB; -fx-border-radius: 7;
                                              -fx-background-radius: 7; -fx-border-width: 1.5;"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Téléphone *" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474F;">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <TextField fx:id="telField" promptText="Ex: 0612345678"
                                       style="-fx-font-size: 13px; -fx-padding: 9 12;
                                              -fx-background-color: #F9FFFE;
                                              -fx-border-color: #B2DFDB; -fx-border-radius: 7;
                                              -fx-background-radius: 7; -fx-border-width: 1.5;"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Date de naissance" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474F;">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <DatePicker fx:id="dateNaissancePicker" maxWidth="Infinity"
                                        style="-fx-font-size: 13px;
                                               -fx-background-color: #F9FFFE;
                                               -fx-border-color: #B2DFDB; -fx-border-radius: 7;
                                               -fx-background-radius: 7; -fx-border-width: 1.5;"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Ville" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474F;">
                                <font><Font name="System Bold" size="12.0"/></font>
                            </Label>
                            <TextField fx:id="villeField" promptText="Votre ville"
                                       style="-fx-font-size: 13px; -fx-padding: 9 12;
                                              -fx-background-color: #F9FFFE;
                                              -fx-border-color: #B2DFDB; -fx-border-radius: 7;
                                              -fx-background-radius: 7; -fx-border-width: 1.5;"/>
                        </VBox>
                    </VBox>
                </HBox>

                <!-- Adresse full width -->
                <VBox spacing="4">
                    <Label text="Adresse complète" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #37474F;">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>
                    <TextField fx:id="adresseField" promptText="Numéro, rue, quartier..."
                               style="-fx-font-size: 13px; -fx-padding: 9 12;
                                      -fx-background-color: #F9FFFE;
                                      -fx-border-color: #B2DFDB; -fx-border-radius: 7;
                                      -fx-background-radius: 7; -fx-border-width: 1.5;"/>
                </VBox>

                <Separator style="-fx-background-color: #E0F2F1;"/>

                <!-- Footer -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label text="* Champs obligatoires"
                           style="-fx-font-size: 11px; -fx-text-fill: #90A4AE; -fx-font-style: italic;">
                        <font><Font name="System Italic" size="11.0"/></font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="cancelButton" text="Annuler" onAction="#handleCancel"
                            minWidth="110"
                            style="-fx-background-color: transparent; -fx-text-fill: #546E7A;
                                   -fx-font-size: 13px; -fx-padding: 10 24; -fx-background-radius: 7;
                                   -fx-border-color: #B0BEC5; -fx-border-radius: 7;
                                   -fx-border-width: 1.5; -fx-cursor: hand;">
                        <font><Font name="System" size="13"/></font>
                    </Button>
                    <Button fx:id="saveButton" text="Enregistrer" onAction="#handleSave"
                            defaultButton="true" minWidth="130"
                            style="-fx-background-color: #004D40; -fx-text-fill: white;
                                   -fx-font-size: 13px; -fx-font-weight: bold;
                                   -fx-padding: 10 24; -fx-background-radius: 7; -fx-cursor: hand;
                                   -fx-effect: dropshadow(gaussian, rgba(0,77,64,0.35), 8, 0, 0, 2);">
                        <font><Font name="System Bold" size="13"/></font>
                    </Button>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
