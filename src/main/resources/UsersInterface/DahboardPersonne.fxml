<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import org.controlsfx.control.HyperlinkLabel?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.Image?>
<BorderPane style="-fx-background-color: #fcf8e6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.User.DashboardPersonnes">

    <!-- SIDEBAR MODERNISÉE -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color:  #617e9c;">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Logo/Header MODERNE -->
            <StackPane prefWidth="100" prefHeight="100"  >
                <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                    <image><Image url="/style/logo.png"/></image>
                </ImageView>

            </StackPane>
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Navigation Menu MODERNISÉE -->
            <VBox spacing="10">
                <!-- Dashboard -->
                <Button fx:id="dashboardBtn" onMouseClicked="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- GESTION PRINCIPALE avec sous-menu -->
                <VBox fx:id="gestionContainer" prefWidth="230" spacing="5" style="-fx-background-radius: 12;">
                    <Button fx:id="gestionBtn" onAction="#handleGestion" prefHeight="50" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"
                            text="⚙️  Gestion Utilisateurs">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                    <!-- Sous-menu MODERNE -->
                    <VBox fx:id="gestionSubmenu" spacing="3" style="-fx-padding: 5 0 5 15; -fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 0 0 12 12;">
                        <Button fx:id="personnesBtn" onMouseClicked="#handlePersonnes" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"
                                text="👥  Personnes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="tachesBtn" onMouseClicked="#handleTaches" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="✓  Tâches">
                            <font><Font name="System" size="13" /></font>
                        </Button>

                        <Button fx:id="abonnementsBtn" onMouseClicked="#handleAbonnements" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="💳  Abonnements">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="offresBtn" onMouseClicked="#handleOffres" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🎁  Offres">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="StatsBtn" onMouseClicked="#openDashboard" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="📊 Statistiques">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Autres boutons MODERNISÉS -->
                <Button fx:id="stocksBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleStocks"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="terrainsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleTerrains"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Terrains">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="animauxBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleAnimals"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Animaux">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="materielBtn" prefHeight="48" prefWidth="230 " onMouseClicked="#handleMateriels"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🔧  Matériel">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="evenementsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleEvents"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🎉  Événements">
                    <font><Font name="System" size="14" /></font>
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout Button MODERNISÉ -->
            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #fcf8e6; -fx-border-color: transparent;">
            <VBox spacing="25" style="-fx-background-color: #fcf8e6;">
                <padding>
                    <Insets bottom="35" left="35" right="35" top="35" />
                </padding>

                <!-- Top Bar MODERNISÉE -->
                <HBox alignment="CENTER_LEFT" spacing="25" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">
                    <VBox spacing="8" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a237e; -fx-effect: dropshadow(gaussian, rgba(26,35,126,0.2), 3, 0, 0, 1);" text="Gestion du Personnel">
                                <font><Font name="System Bold" size="32" /></font>
                            </Label>
                            <Label style="-fx-background-color: #E8EAF6; -fx-text-fill: #3949ab; -fx-padding: 6 12; -fx-background-radius: 20; -fx-font-size: 12px; -fx-font-weight: bold;" text="ACTIF">
                                <font><Font name="System Bold" size="12" /></font>
                            </Label>
                        </HBox>
                        <Label style="-fx-font-size: 15px; -fx-text-fill: #7F8C8D;" text="Gérer et visualiser les données sur les travailleurs">
                            <font><Font name="System" size="15" /></font>
                        </Label>
                    </VBox>

                    <!-- User Profile MODERNISÉ -->
                    <HBox alignment="CENTER" spacing="18">
                        <Button fx:id="addEmployeeBtn" onMouseClicked="#handleAddEmployee"
                                style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.4), 10, 0, 0, 3);"
                                text="+ Ajouter un employé">
                            <font><Font name="System Bold" size="14" /></font>
                        </Button>

                        <Separator orientation="VERTICAL" prefHeight="40" style="-fx-background-color: #E0E0E0;" />

                        <HBox alignment="CENTER" spacing="12" style="-fx-cursor: hand;" onMouseClicked="#handleMonProfil">
                            <VBox alignment="CENTER_RIGHT" spacing="2">
                                <Label fx:id="userNameLabel" style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Admin">
                                    <font><Font name="System Bold" size="15" /></font>
                                </Label>
                                <Label style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" text="Administrateur">
                                    <font><Font name="System" size="11" /></font>
                                </Label>
                            </VBox>

                            <!-- Avatar circulaire : photo si disponible, sinon emoji 👤 -->
                            <StackPane>
                                <!-- Fond dégradé (visible si pas de photo) -->
                                <Circle fx:id="avatarBg" radius="24"
                                        fill="linear-gradient(to bottom right, #667eea, #764ba2)" />
                                <!-- Emoji par défaut -->
                                <Label fx:id="avatarDefaultLabel"
                                       style="-fx-font-size: 22px; -fx-text-fill: white;"
                                       text="👤" />
                                <!-- Photo chargée depuis Cloudinary (clip appliqué en Java) -->
                                <ImageView fx:id="avatarImageView"
                                           fitWidth="48" fitHeight="48"
                                           preserveRatio="false"
                                           visible="false" managed="false" />
                            </StackPane>
                        </HBox>
                    </HBox>
                </HBox>

                <!-- Liste des Employés Card MODERNISÉE -->
                <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="30" left="30" right="30" top="30" />
                    </padding>

                    <!-- Card Header MODERNE -->
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <VBox spacing="5">
                            <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Liste des Employés">
                                <font><Font name="System Bold" size="22" /></font>
                            </Label>
                            <Label style="-fx-font-size: 13px; -fx-text-fill: #95A5A6;" text="Gérez votre équipe efficacement">
                                <font><Font name="System" size="13" /></font>
                            </Label>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="searchField" prefWidth="280" prefHeight="42" promptText="🔍 Rechercher par nom, email..."
                                   style="-fx-background-color: #F5F7FA; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 10 15; -fx-font-size: 14px;">
                            <font><Font name="System" size="14" /></font>
                        </TextField>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 10 0 8 0;">
                        <Label fx:id="selectedPersonLabel"
                               text="Cliquez sur le bouton générer  PDF pour exporter les données relatives aux utilisateurs  a AgroFlow "
                               style="-fx-text-fill: #7F8C8D; -fx-font-size: 12px; -fx-font-style: italic;" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="pdfBtn"
                                text="📄  Générer PDF "
                                onAction="#handleExportPDF"
                                disable="false"
                                style="-fx-background-color: #E74C3C;
                   -fx-text-fill: white;
                   -fx-font-size: 12px;
                   -fx-font-weight: bold;
                   -fx-background-radius: 8;
                   -fx-padding: 8 20 8 20;
                   -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.4), 8, 0, 0, 2);" />
                    </HBox>

                    <!-- Table MODERNISÉE -->
                    <TableView fx:id="employeeTable" prefHeight="400.0" minHeight="350.0" VBox.vgrow="ALWAYS"
                               style="-fx-background-color: transparent; -fx-border-color: #E8EAED; -fx-border-radius: 10; -fx-border-width: 1; -fx-background-radius: 10;">
                        <columns>
                            <TableColumn fx:id="nomColumn" prefWidth="220" style="-fx-alignment: CENTER-LEFT;" text="Nom Complet" />
                            <TableColumn fx:id="emailColumn" prefWidth="280" style="-fx-alignment: CENTER-LEFT;" text="Email" />
                            <TableColumn fx:id="roleColumn" prefWidth="170" style="-fx-alignment: CENTER;" text="Rôle" />
                            <TableColumn fx:id="dateColumn" prefWidth="170" style="-fx-alignment: CENTER;" text="Date d'ajout" />
                            <TableColumn fx:id="actionsColumn" prefWidth="210" style="-fx-alignment: CENTER;" text="Actions" />
                        </columns>
                    </TableView>
                </VBox>

                <!-- Assigner une Tâche Card MODERNISÉE -->
                <VBox spacing="20" style="-fx-background-color: white; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 15, 0, 0, 3);">
                    <padding>
                        <Insets bottom="25" left="30" right="30" top="25" />
                    </padding>

                    <!-- Card Header MODERNE -->
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="✓ Assigner une Tâche">
                            <font><Font name="System Bold" size="20" /></font>
                        </Label>
                        <Label style="-fx-background-color: #FFF3E0; -fx-text-fill: #F57C00; -fx-padding: 4 10; -fx-background-radius: 15; -fx-font-size: 11px; -fx-font-weight: bold;" text="NOUVEAU">
                            <font><Font name="System Bold" size="11" /></font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-font-size: 20px; -fx-text-fill: #BDC3C7; -fx-cursor: hand;" text="⋮" />
                    </HBox>

                    <!-- Form Grid MODERNE & COMPACT -->
                    <HBox spacing="20" alignment="CENTER_LEFT">
                        <!-- Sélectionner un employé -->
                        <VBox spacing="8">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;" text="Employé">
                                <font><Font name="System Bold" size="13" /></font>
                            </Label>
                            <ComboBox fx:id="employeeComboBox" prefWidth="260" prefHeight="42" promptText="Sélectionnez un employé..."
                                      style="-fx-background-color: #F8F9FA; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10; -fx-border-width: 1;">
                                <padding><Insets bottom="10" left="14" right="14" top="10" /></padding>
                            </ComboBox>
                        </VBox>

                        <!-- Description -->
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;" text="Description de la tâche">
                                <font><Font name="System Bold" size="13" /></font>
                            </Label>
                            <TextField fx:id="taskDescriptionField" prefHeight="42" promptText="Décrivez la tâche à effectuer..."
                                       style="-fx-background-color: #F8F9FA; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10; -fx-border-width: 1; -fx-padding: 10 14; -fx-font-size: 14px;">
                                <font><Font name="System" size="14" /></font>
                            </TextField>
                        </VBox>

                        <!-- Date -->
                        <VBox spacing="8">
                            <Label style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #34495E;" text="Date d'échéance">
                                <font><Font name="System Bold" size="13" /></font>
                            </Label>
                            <DatePicker fx:id="dueDatePicker" prefWidth="190" prefHeight="42" promptText="Choisir une date"
                                        style="-fx-background-color: #F8F9FA; -fx-background-radius: 10; -fx-border-color: #E0E0E0; -fx-border-radius: 10; -fx-border-width: 1;" />
                        </VBox>

                        <!-- Bouton -->
                        <VBox spacing="8" alignment="BOTTOM_CENTER">
                            <Label style="-fx-font-size: 13px; -fx-text-fill: transparent;" text="." />
                            <Button fx:id="assignTaskBtn" onAction="#handleAssignTask" prefWidth="160" prefHeight="42"
                                    style="-fx-background-color: linear-gradient(to right, #667eea, #764ba2); -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(102,126,234,0.4), 10, 0, 0, 3);"
                                    text="→ Assigner">
                                <font><Font name="System Bold" size="14" /></font>
                            </Button>
                        </VBox>
                    </HBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
