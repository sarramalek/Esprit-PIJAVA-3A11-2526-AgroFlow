<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane style="-fx-background-color: #F8F9FA;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.User.MesTaches" prefHeight="750.0" prefWidth="1500.0">

    <!-- ═══════════════════════════════ SIDEBAR ═══════════════════════════════ -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: #ffffff; -fx-border-color: #e8e8e8; -fx-border-width: 0 1 0 0;">
            <padding><Insets bottom="20" top="20" /></padding>

            <!-- Logo -->
            <StackPane prefWidth="100" prefHeight="100">
                <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                    <image><Image url="/style/logo.png"/></image>
                </ImageView>
            </StackPane>

            <!-- ══ Info Utilisateur + Avatar ══ -->
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: #f5f9f5; -fx-background-radius: 12;
                     -fx-padding: 16; -fx-margin: 10;
                     -fx-border-color: #d6e8d6; -fx-border-width: 1; -fx-border-radius: 12;">

                <!-- Conteneur avatar -->
                <StackPane prefWidth="64" prefHeight="64">
                    <Circle fx:id="avatarBg" radius="32" fill="#d6e8d6" />
                    <Label fx:id="avatarDefaultLabel"
                           text="👤"
                           style="-fx-font-size: 30px;" />
                    <ImageView fx:id="avatarImageView"
                               fitWidth="64" fitHeight="64"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>

                <Label fx:id="userNameLabel"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1a2e1a;"
                       text="Nom Employé">
                    <font><Font name="System Bold" size="15" /></font>
                </Label>
                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 11px; -fx-text-fill: #3a7d44;
                          -fx-background-color: #d6ead6; -fx-padding: 4 12;
                          -fx-background-radius: 15;"
                       text="👷 EMPLOYÉ">
                    <font><Font name="System Bold" size="11" /></font>
                </Label>
            </VBox>

            <!-- Navigation Menu -->
            <VBox spacing="4" style="-fx-padding: 16 12 0 12;">

                <!-- Dashboard (actif) — fond vert clair + bordure verte gauche -->
                <Button fx:id="dashboardBtn" onMouseClicked="#handleDashboard"
                        prefHeight="46" prefWidth="226"
                        style="-fx-background-color: #eaf4ea;
                           -fx-text-fill: #2d6a2d; -fx-font-size: 13px;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 8; -fx-cursor: hand;
                           -fx-border-color: #4a9e4a transparent transparent transparent;
                           -fx-border-width: 0 0 0 3; -fx-border-radius: 0;"
                        text="📊  Accueil">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Tâches -->
                <Button prefHeight="46" prefWidth="226"
                        style="-fx-background-color: transparent; -fx-text-fill: #3d3d3d;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 8;
                           -fx-cursor: hand;"
                        text="📋  Mes Tâches">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Stocks -->
                <Button prefHeight="46" prefWidth="226" onMouseClicked="#handleStocks"
                        style="-fx-background-color: transparent; -fx-text-fill: #3d3d3d;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 8;
                           -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mon Profil -->
                <Button onMouseClicked="#handleMonProfil" prefHeight="46" prefWidth="226"
                        style="-fx-background-color: transparent; -fx-text-fill: #3d3d3d;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 8;
                           -fx-cursor: hand;"
                        text="👤  Mon Profil">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Rotations -->
                <Button onMouseClicked="#ouvrirRotations" prefHeight="46" prefWidth="226"
                        style="-fx-background-color: transparent; -fx-text-fill: #3d3d3d;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 8;
                           -fx-cursor: hand;"
                        text="🌾  Mes Rotations">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Maintenances -->
                <Button onMouseClicked="#handleMateriel" prefHeight="46" prefWidth="226"
                        style="-fx-background-color: transparent; -fx-text-fill: #3d3d3d;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 8;
                           -fx-cursor: hand;"
                        text="🔧  Maintenances">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Événements et Participations -->
                <Button onMouseClicked="#handleEvenements" prefHeight="46" prefWidth="226"
                        style="-fx-background-color: transparent; -fx-text-fill: #3d3d3d;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 8;
                           -fx-cursor: hand;"
                        text="📅  Événements">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Séparateur -->
            <Separator style="-fx-background-color: #e0e0e0;" prefWidth="226">
                <padding><Insets left="12" right="12" bottom="8" /></padding>
            </Separator>

            <!-- Logout -->
            <Button fx:id="logoutBtn" onMouseClicked="#handleLogout"
                    prefHeight="46" prefWidth="226"
                    style="-fx-background-color: #fff0f0; -fx-text-fill: #c0392b;
                       -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                       -fx-padding: 0 0 0 16; -fx-background-radius: 8;
                       -fx-cursor: hand;
                       -fx-border-color: #e74c3c transparent transparent transparent;
                       -fx-border-width: 0 0 0 3; -fx-border-radius: 0;"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="13" /></font>
            </Button>
            <padding><Insets left="12" right="12" bottom="8" /></padding>
        </VBox>
    </left>

    <!-- ═══════════════════════════════ CONTENU PRINCIPAL ═══════════════════════════════ -->
    <center>
        <VBox spacing="15" style="-fx-background-color: #F8F9FA;">
            <padding><Insets top="25" right="25" bottom="25" left="25" /></padding>

            <!-- ── Header ── -->
            <HBox alignment="CENTER_LEFT" spacing="20"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 18;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);">
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a237e;"
                           text="📋 Mes Tâches"><font><Font name="System Bold" size="26" /></font></Label>
                    <Label style="-fx-font-size: 13px; -fx-text-fill: #7F8C8D;"
                           text="Gérez et suivez vos tâches assignées"><font><Font name="System" size="13" /></font></Label>
                </VBox>
                <Button fx:id="refreshBtn" onAction="#handleRefresh"
                        style="-fx-background-color: #3498DB; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-padding: 10 20; -fx-cursor: hand;"
                        text="🔄 Actualiser"><font><Font name="System Bold" size="13" /></font></Button>
            </HBox>

            <!-- ── Cartes Statistiques ── -->
            <HBox spacing="15" alignment="CENTER_LEFT">

                <!-- Total -->
                <VBox alignment="CENTER" spacing="5" prefWidth="150" prefHeight="80"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                             -fx-border-color: #E0E0E0; -fx-border-radius: 12; -fx-border-width: 0 0 0 5;
                             -fx-border-color: transparent transparent transparent #7F8C8D;"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="statTotal" text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;">
                        <font><Font name="System Bold" size="32" /></font></Label>
                    <Label text="📊 Total" style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;">
                        <font><Font name="System" size="12" /></font></Label>
                </VBox>

                <!-- En cours -->
                <VBox alignment="CENTER" spacing="5" prefWidth="150" prefHeight="80"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                             -fx-border-color: transparent transparent transparent #F39C12;
                             -fx-border-width: 0 0 0 5; -fx-border-radius: 12;"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="statEnCours" text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #F39C12;">
                        <font><Font name="System Bold" size="32" /></font></Label>
                    <Label text="▶ En cours" style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;">
                        <font><Font name="System" size="12" /></font></Label>
                </VBox>

                <!-- Terminées -->
                <VBox alignment="CENTER" spacing="5" prefWidth="150" prefHeight="80"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                             -fx-border-color: transparent transparent transparent #27AE60;
                             -fx-border-width: 0 0 0 5; -fx-border-radius: 12;"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="statTerminee" text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #27AE60;">
                        <font><Font name="System Bold" size="32" /></font></Label>
                    <Label text="✓ Terminées" style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;">
                        <font><Font name="System" size="12" /></font></Label>
                </VBox>

                <!-- En attente -->
                <VBox alignment="CENTER" spacing="5" prefWidth="150" prefHeight="80"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                             -fx-border-color: transparent transparent transparent #3498DB;
                             -fx-border-width: 0 0 0 5; -fx-border-radius: 12;"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="statEnAttente" text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #3498DB;">
                        <font><Font name="System Bold" size="32" /></font></Label>
                    <Label text="⏳ En attente" style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;">
                        <font><Font name="System" size="12" /></font></Label>
                </VBox>

                <!-- En retard -->
                <VBox alignment="CENTER" spacing="5" prefWidth="150" prefHeight="80"
                      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15;
                             -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 8, 0, 0, 2);
                             -fx-border-color: transparent transparent transparent #E74C3C;
                             -fx-border-width: 0 0 0 5; -fx-border-radius: 12;"
                      HBox.hgrow="ALWAYS">
                    <Label fx:id="statEnRetard" text="0"
                           style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #E74C3C;">
                        <font><Font name="System Bold" size="32" /></font></Label>
                    <Label text="⚠ En retard" style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;">
                        <font><Font name="System" size="12" /></font></Label>
                </VBox>

            </HBox>

            <!-- ── Barre Recherche + Filtres + Tri + Rapports ── -->
            <HBox spacing="10" alignment="CENTER_LEFT"
                  style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 15;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 8, 0, 0, 2);">

                <!-- Recherche -->
                <TextField fx:id="searchField" promptText="🔍 Rechercher..."
                           prefWidth="220"
                           style="-fx-background-color: #F5F6FA; -fx-background-radius: 8;
                                  -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-padding: 9;" />

                <!-- Filtre Statut -->
                <Label text="Statut :" style="-fx-font-size: 13px; -fx-text-fill: #555;" />
                <ComboBox fx:id="filterStatut" prefWidth="130"
                          style="-fx-background-color: #F5F6FA; -fx-background-radius: 8;
                                 -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />

                <!-- Filtre Priorité -->
                <Label text="Priorité :" style="-fx-font-size: 13px; -fx-text-fill: #555;" />
                <ComboBox fx:id="filterPriorite" prefWidth="130"
                          style="-fx-background-color: #F5F6FA; -fx-background-radius: 8;
                                 -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />

                <!-- Tri -->
                <Label text="Trier :" style="-fx-font-size: 13px; -fx-text-fill: #555;" />
                <ComboBox fx:id="sortCombo" prefWidth="210"
                          style="-fx-background-color: #F5F6FA; -fx-background-radius: 8;
                                 -fx-border-color: #E0E0E0; -fx-border-radius: 8;" />

                <Region HBox.hgrow="ALWAYS" />

                <!-- Boutons rapport -->
                <Button fx:id="rapportSelectionBtn" onAction="#handleRapportSelection"
                        style="-fx-background-color: #8E44AD; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-padding: 9 16; -fx-cursor: hand;"
                        text="📄 Rapport sélection">
                    <font><Font name="System Bold" size="12" /></font></Button>

                <Button fx:id="rapportToutBtn" onAction="#handleRapportTout"
                        style="-fx-background-color: #16A085; -fx-text-fill: white;
                               -fx-background-radius: 8; -fx-padding: 9 16; -fx-cursor: hand;"
                        text="📑 Rapport tout">
                    <font><Font name="System Bold" size="12" /></font></Button>

            </HBox>

            <!-- ── Tableau ── -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;
                         -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 10, 0, 0, 2);"
                  VBox.vgrow="ALWAYS">

                <TableView fx:id="taskTable" VBox.vgrow="ALWAYS"
                           style="-fx-background-color: transparent;">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="55" />
                        <TableColumn fx:id="titleColumn" text="Titre" prefWidth="190" />
                        <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="230" />
                        <TableColumn fx:id="statutColumn" text="Statut" prefWidth="110" />
                        <TableColumn fx:id="prioriteColumn" text="Priorité" prefWidth="100" />
                        <TableColumn fx:id="dateColumn" text="Échéance" prefWidth="110" />
                        <TableColumn fx:id="actionsColumn" text="Actions" prefWidth="185" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

            </VBox>
        </VBox>
    </center>

</BorderPane>
