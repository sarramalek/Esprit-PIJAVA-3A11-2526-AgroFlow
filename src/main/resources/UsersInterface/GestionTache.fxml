<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import org.controlsfx.control.HyperlinkLabel?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.Image?>
<BorderPane style="-fx-background-color: #fcf8e6;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.User.GestionTache">

    <!-- SIDEBAR MODERNISÉE -->
    <!-- SIDEBAR MODERNISÉE -->
    <left>
        <VBox prefWidth="260"
              style="-fx-background-color: #FAFAF5; -fx-border-color: #E8EDE0; -fx-border-width: 0 1 0 0;">
            <padding><Insets top="0" bottom="20" /></padding>

            <!-- Logo Header -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #FFFFFF; -fx-padding: 16 20; -fx-border-color: #E8EDE0; -fx-border-width: 0 0 1 0;">
                <StackPane prefWidth="36" prefHeight="36">
                    <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                        <image><Image url="/style/logo.png"/></image>
                    </ImageView>
                </StackPane>
                <Label text="AgroFlow"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1B5E20;">
                    <font><Font name="System Bold" size="20" /></font>
                </Label>
            </HBox>

            <!-- User Info Card -->
            <VBox alignment="CENTER" spacing="6"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #E8EDE0;
                     -fx-border-width: 0 0 1 0; -fx-padding: 18 20;">

                <StackPane prefWidth="64" prefHeight="64">
                    <!-- Avatar background circle -->
                    <Circle fx:id="sidebarAvatarBg" radius="32"
                            fill="#E8F5E9" />
                    <!-- Default emoji -->
                    <Label fx:id="sidebarAvatarDefault"
                           style="-fx-font-size: 28px;"
                           text="👨‍🌾" />
                    <!-- Cloudinary photo -->
                    <ImageView fx:id="sidebarAvatarImageView"
                               fitWidth="64" fitHeight="64"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>

                <Label fx:id="userNameLabel"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A2E1A;"
                       text="Nom Agriculteur">
                    <font><Font name="System Bold" size="15" /></font>
                </Label>

                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;
                          -fx-background-color: #E8F5E9; -fx-padding: 3 10;
                          -fx-background-radius: 20;"
                       text="🌾 AGRICULTEUR">
                    <font><Font name="System Bold" size="11" /></font>
                </Label>

                <Hyperlink fx:id="aproposLink" text="👤 À propos de moi"
                           onAction="#handleMonProfil"
                           style="-fx-text-fill: #388E3C; -fx-font-size: 12px;
                              -fx-border-color: #C8E6C9; -fx-padding: 4 14;
                              -fx-background-radius: 20; -fx-border-radius: 20;
                              -fx-cursor: hand; -fx-underline: false;">
                    <font><Font name="System" size="12" /></font>
                </Hyperlink>
            </VBox>

            <!-- Navigation Label -->
            <Label text="NAVIGATION"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9E9E9E;
                      -fx-padding: 16 20 6 20; -fx-letter-spacing: 1px;">
                <font><Font name="System Bold" size="10" /></font>
            </Label>

            <!-- Navigation Menu -->
            <VBox spacing="2" style="-fx-padding: 0 12;">

                <!-- Accueil - Active State -->
                <Button onAction="#handleDashboard" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: #E8F5E9; -fx-text-fill: #1B5E20;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #A5D6A7; -fx-border-radius: 10; -fx-border-width: 1;"
                        text="📊  Accueil">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Ouvriers -->
                <Button onMouseClicked="#handlemesouvriers" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="👷  Mes Ouvriers">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Terrains avec sous-menu -->
                <VBox spacing="0">
                    <Button onMouseClicked="#handleTerrains" prefHeight="44" prefWidth="236"
                            style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                               -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                            text="🌾  Mes Terrains  ▾">
                        <font><Font name="System Bold" size="13" /></font>
                    </Button>
                    <!-- Sous-menu -->
                    <VBox fx:id="terrainsSubMenu" spacing="1"
                          style="-fx-padding: 2 0 2 12;" visible="false" managed="false">
                        <Button onMouseClicked="#handleTerrains" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: #F1F8E9; -fx-text-fill: #33691E;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-border-color: #DCEDC8; -fx-border-radius: 8; -fx-border-width: 1;"
                                text="🚜  Terrains">
                            <font><Font name="System Bold" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#handleTerrains" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🌱  Plantes">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#handleTerrains" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="📋  Rotations">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Mes Animaux -->
                <Button onMouseClicked="#handleAnimals" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="🐄  Mes Animaux">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Stocks -->
                <Button onMouseClicked="#handleStocks" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="📦  Mes Stocks">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mon Matériel -->
                <Button onMouseClicked="#handleMateriels" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="🚜  Mon Matériel">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Abonnements -->
                <Button onMouseClicked="#handleAbonnements" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="💳  Mes Abonnements">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Événements -->
                <Button onMouseClicked="#handleEvents" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="📅  Événements">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Separator -->
            <Separator style="-fx-background-color: #E0E8D8;" />

            <!-- Déconnexion -->
            <VBox style="-fx-padding: 12 12 0 12;">
                <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: #FFF3F3; -fx-text-fill: #C62828;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #FFCDD2; -fx-border-radius: 10; -fx-border-width: 1;"
                        text="🚪  Déconnexion">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>
            </VBox>

        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #fcf8e6; -fx-border-color: transparent;">

        <VBox spacing="20" style="-fx-background-color: #fcf8e6;">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <!-- Top Bar -->
            <!-- Top Bar MODERNISÉE -->
            <HBox alignment="CENTER_LEFT" spacing="25" style="-fx-background-color: white; -fx-background-radius: 15; -fx-padding: 25; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 12, 0, 0, 2);">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Label style="-fx-font-size: 32px; -fx-font-weight: bold; -fx-text-fill: #1a237e; -fx-effect: dropshadow(gaussian, rgba(26,35,126,0.2), 3, 0, 0, 1);" text="Gestion des Taches ">
                            <font><Font name="System Bold" size="32" /></font>
                        </Label>
                        <Label style="-fx-background-color: #E8EAF6; -fx-text-fill: #3949ab; -fx-padding: 6 12; -fx-background-radius: 20; -fx-font-size: 12px; -fx-font-weight: bold;" text="ACTIF">
                            <font><Font name="System Bold" size="12" /></font>
                        </Label>
                    </HBox>
                    <Label style="-fx-font-size: 15px; -fx-text-fill: #7F8C8D;" text="Gérer et visualiser les Taches ">
                        <font><Font name="System" size="15" /></font>
                    </Label>
                </VBox>

                <!-- User Profile MODERNISÉ -->
                <HBox alignment="CENTER" spacing="18">
                    <Button fx:id="addTaskBtn" onMouseClicked="#handleAddTask"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 24; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-weight: bold; -fx-effect: dropshadow(gaussian, rgba(76,175,80,0.4), 10, 0, 0, 3);"
                            text="+ Ajouter une Tache ">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                    <Separator orientation="VERTICAL" prefHeight="40" style="-fx-background-color: #E0E0E0;" />

                    <HBox alignment="CENTER" spacing="12" style="-fx-cursor: hand;" onMouseClicked="#handleMonProfil">
                        <VBox alignment="CENTER_RIGHT" spacing="2">
                            <Label fx:id="userNameLabel" style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Admin">
                                <font><Font name="System Bold" size="15" /></font>
                            </Label>
                            <Label style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" text="Administrateur">
                                <font><Font name="System" size="11" /></font>
                            </Label>
                        </VBox>

                        <!-- Avatar circulaire : photo si disponible, sinon emoji 👤 -->
                        <StackPane>
                            <!-- Fond dégradé (visible si pas de photo) -->
                            <Circle fx:id="avatarBg" radius="24"
                                    fill="linear-gradient(to bottom right, #667eea, #764ba2)" />
                            <!-- Emoji par défaut -->
                            <Label fx:id="avatarDefaultLabel"
                                   style="-fx-font-size: 22px; -fx-text-fill: white;"
                                   text="👤" />
                            <!-- Photo chargée depuis Cloudinary (clip appliqué en Java) -->
                            <ImageView fx:id="avatarImageView"
                                       fitWidth="48" fitHeight="48"
                                       preserveRatio="false"
                                       visible="false" managed="false" />
                        </StackPane>
                    </HBox>
                </HBox>
            </HBox>


            <!-- Statistiques Cards -->
            <HBox spacing="15" alignment="CENTER">
                <!-- Total des tâches -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-size: 32px;" text="📋" />
                        <VBox spacing="3">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Total des tâches">
                                <font>
                                    <Font name="System" size="12" />
                                </font>
                            </Label>
                            <Label fx:id="totalTasksLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="0">
                                <font>
                                    <Font name="System Bold" size="24" />
                                </font>
                            </Label>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- En cours -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-size: 32px;" text="⏳" />
                        <VBox spacing="3">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="En cours">
                                <font>
                                    <Font name="System" size="12" />
                                </font>
                            </Label>
                            <Label fx:id="enCoursLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #F39C12;" text="0">
                                <font>
                                    <Font name="System Bold" size="24" />
                                </font>
                            </Label>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- Terminées -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-size: 32px;" text="✅" />
                        <VBox spacing="3">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="Terminées">
                                <font>
                                    <Font name="System" size="12" />
                                </font>
                            </Label>
                            <Label fx:id="termineesLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #27AE60;" text="0">
                                <font>
                                    <Font name="System Bold" size="24" />
                                </font>
                            </Label>
                        </VBox>
                    </HBox>
                </VBox>

                <!-- En retard -->
                <VBox spacing="10" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 8, 0, 0, 2);" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-size: 32px;" text="⚠️" />
                        <VBox spacing="3">
                            <Label style="-fx-font-size: 12px; -fx-text-fill: #7F8C8D;" text="En retard">
                                <font>
                                    <Font name="System" size="12" />
                                </font>
                            </Label>
                            <Label fx:id="enRetardLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #E74C3C;" text="0">
                                <font>
                                    <Font name="System Bold" size="24" />
                                </font>
                            </Label>
                        </VBox>
                    </HBox>
                </VBox>
            </HBox>

            <!-- Filtres et Recherche -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" prefWidth="300" promptText="🔍 Rechercher une tâche..." style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E0E0E0; -fx-border-radius: 8; -fx-padding: 10;">
                    <font>
                        <Font name="System" size="14" />
                    </font>
                </TextField>

                <ComboBox fx:id="filterComboBox" prefWidth="200" promptText="Filtrer par statut" style="-fx-background-color: white; -fx-background-radius: 8;">
                    <padding>
                        <Insets bottom="8" left="12" right="12" top="8" />
                    </padding>
                </ComboBox>

                <ComboBox fx:id="employeeFilterComboBox" prefWidth="200" promptText="Filtrer par employé" style="-fx-background-color: white; -fx-background-radius: 8;">
                    <padding>
                        <Insets bottom="8" left="12" right="12" top="8" />
                    </padding>
                </ComboBox>

                <Region HBox.hgrow="ALWAYS" />

                <Button onAction="#handleRefresh" style="-fx-background-color: #3498DB; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 20; -fx-background-radius: 8; -fx-cursor: hand;" text="🔄 Actualiser">

                    <font>
                        <Font name="System" size="14" />
                    </font>
                </Button>
            </HBox>

            <!-- Liste des Tâches -->
            <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" VBox.vgrow="ALWAYS">
                <padding>
                    <Insets bottom="25" left="25" right="25" top="25" />
                </padding>

                <!-- Card Header -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="Liste des Tâches">
                        <font>
                            <Font name="System Bold" size="20" />
                        </font>
                    </Label>
                    <Region HBox.hgrow="ALWAYS" />
                </HBox>
                <HBox alignment="CENTER_LEFT" spacing="14" style="-fx-padding: 10 0 8 0;">
                    <Label fx:id="selectedPersonLabel"
                           text="Sélectionnez une personne pour générer son PDF"
                           style="-fx-text-fill: #7F8C8D; -fx-font-size: 12px; -fx-font-style: italic;" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="pdfBtn"
                            text="📄  Générer PDF abonnement"
                            onAction="#handleGeneratePdf"
                            disable="true"
                            style="-fx-background-color: #E74C3C;
                   -fx-text-fill: white;
                   -fx-font-size: 12px;
                   -fx-font-weight: bold;
                   -fx-background-radius: 8;
                   -fx-padding: 8 20 8 20;
                   -fx-cursor: hand;
                   -fx-effect: dropshadow(gaussian, rgba(231,76,60,0.4), 8, 0, 0, 2);" />
                </HBox>

                <!-- Table -->
                <TableView fx:id="tasksTable" prefHeight="400.0" minHeight="350.0" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <columns>
                        <TableColumn fx:id="titleColumn" prefWidth="250" style="-fx-alignment: CENTER-LEFT;" text="Titre" />
                        <TableColumn fx:id="descriptionColumn" prefWidth="280" style="-fx-alignment: CENTER-LEFT;" text="Description" />
                        <TableColumn fx:id="assignedToColumn" prefWidth="180" style="-fx-alignment: CENTER;" text="Assignée à" />
                        <TableColumn fx:id="statusColumn" prefWidth="130" style="-fx-alignment: CENTER;" text="Statut" />
                        <TableColumn fx:id="dueDateColumn" prefWidth="130" style="-fx-alignment: CENTER;" text="Échéance" />
                        <TableColumn fx:id="actionsColumn" prefWidth="200" style="-fx-alignment: CENTER;" text="Actions" />
                    </columns>
                </TableView>
            </VBox>

        </VBox>
        </ScrollPane>
    </center>

</BorderPane>
