<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: #fcf8e6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ModifierAnimalController">
    <left>
        <VBox prefWidth="230.0" spacing="5.0" style="-fx-background-color: #2C3E50; -fx-padding: 15;">
            <children>
                <Text fill="WHITE" text="AGROFLOW">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Text>
                <Separator opacity="0.2" prefHeight="20.0" />

                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#naviguerAnimaux" prefHeight="45.0" style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-cursor: hand;" text="🐾 Gestion Animaux" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#naviguerMateriels" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="⚙️ Gestion Matériels" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#naviguerStocks" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="📦 Gestion Stocks" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#naviguerTerrains" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="🌱 Gestion Terrains" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#naviguerEvenements" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="📅 Événements" />
                <Button alignment="BASELINE_LEFT" maxWidth="Infinity" onAction="#naviguerUsers" prefHeight="45.0" style="-fx-background-color: transparent; -fx-text-fill: white; -fx-cursor: hand;" text="👥 Utilisateurs" />

                <Region VBox.vgrow="ALWAYS" />
                <Separator opacity="0.1" />
                <Button maxWidth="Infinity" style="-fx-background-color: #E74C3C; -fx-text-fill: white;" text="Déconnexion" />
            </children>
        </VBox>
    </left>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent;">
            <content>
                <VBox spacing="30.0" style="-fx-padding: 40;">
                    <children>
                        <Text fill="#2C3E50" text="Modifier la fiche Animal">
                            <font><Font name="System Bold" size="26.0" /></font>
                        </Text>

                        <GridPane hgap="15.0" vgap="15.0">
                            <columnConstraints>
                                <ColumnConstraints minWidth="150.0" prefWidth="180.0" />
                                <ColumnConstraints minWidth="300.0" prefWidth="400.0" />
                            </columnConstraints>
                            <children>
                                <Label text="Nom :" textFill="#2C3E50" GridPane.rowIndex="0" />
                                <TextField fx:id="tfNom" prefHeight="35.0" style="-fx-border-color: #A8C69F;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <Label text="Espèce :" textFill="#2C3E50" GridPane.rowIndex="1" />
                                <ComboBox fx:id="comboEspece" prefHeight="35.0" prefWidth="Infinity" style="-fx-border-color: #A8C69F;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                                <Label text="Poids (kg) :" textFill="#2C3E50" GridPane.rowIndex="2" />
                                <TextField fx:id="tfPoids" prefHeight="35.0" style="-fx-border-color: #A8C69F;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label text="Date Naissance :" textFill="#2C3E50" GridPane.rowIndex="3" />
                                <DatePicker fx:id="dpDate" prefHeight="35.0" prefWidth="Infinity" style="-fx-border-color: #A8C69F;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label text="Sexe :" textFill="#2C3E50" GridPane.rowIndex="4" />
                                <ComboBox fx:id="cbSexe" prefHeight="35.0" prefWidth="Infinity" style="-fx-border-color: #A8C69F;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <Label text="Suggestions d'aliments :" textFill="#2C3E50" GridPane.rowIndex="5" />
                                <ListView fx:id="lvSuggestions" prefHeight="100.0" prefWidth="Infinity" style="-fx-border-color: #A8C69F;" GridPane.columnIndex="1" GridPane.rowIndex="5" />
                            </children>
                        </GridPane>

                        <HBox spacing="15.0">
                            <children>
                                <Button onAction="#handleModifier" prefHeight="40.0" style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="ENREGISTRER LES MODIFS" />
                                <Button onAction="#retourListe" prefHeight="40.0" style="-fx-background-color: #A8C69F; -fx-text-fill: #2C3E50; -fx-cursor: hand;" text="ANNULER" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>