<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.Insets?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.Circle?>
<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #FDFBF0;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Animaux.AfficherAnimauxController">
    <!-- SIDEBAR MODERNISÉE -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color:  #617e9c;">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Logo/Header MODERNE -->
            <StackPane prefWidth="100" prefHeight="100"  >
                <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                    <image><Image url="/style/logo.png"/></image>
                </ImageView>

            </StackPane>
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Navigation Menu MODERNISÉE -->
            <VBox spacing="10">
                <!-- Dashboard -->
                <Button fx:id="dashboardBtn" onMouseClicked="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- GESTION PRINCIPALE avec sous-menu -->
                <VBox fx:id="gestionContainer" prefWidth="230" spacing="5" style="-fx-background-radius: 12;">
                    <Button fx:id="gestionBtn" onMouseClicked="#handleGestion" prefHeight="50" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"
                            text="⚙️  Gestion Utilisateurs">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                    <!-- Sous-menu MODERNE -->
                    <VBox fx:id="gestionSubmenu" spacing="3" style="-fx-padding: 5 0 5 15; -fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 0 0 12 12;">
                        <Button fx:id="personnesBtn" onMouseClicked="#handlePersonnes" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand; -fx-border-color: transparent;"
                                text="👥  Personnes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="tachesBtn" onMouseClicked="#handleTaches" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="✓  Tâches">
                            <font><Font name="System" size="13" /></font>
                        </Button>

                        <Button fx:id="abonnementsBtn" onMouseClicked="#handleAbonnements" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="💳  Abonnements">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="offresBtn" onMouseClicked="#handleOffres" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🎁  Offres">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Autres boutons MODERNISÉS -->
                <Button fx:id="stocksBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleStocks"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="terrainsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleTerrains"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Terrains">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="animauxBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleAnimals"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Animaux">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="materielBtn" prefHeight="48" prefWidth="230 " onMouseClicked="#handleMateriels"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🔧  Matériel">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="evenementsBtn" prefHeight="48" prefWidth="230" onMouseClicked="#handleEvents"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🎉  Événements">
                    <font><Font name="System" size="14" /></font>
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout Button MODERNISÉ -->
            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>
    <center>
        <VBox spacing="20.0" style="-fx-padding: 30;">
            <HBox alignment="CENTER" spacing="12" style="-fx-cursor: hand;" onMouseClicked="#handleMonProfil">
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="userNameLabel" style="-fx-font-size: 15px; -fx-text-fill: #2C3E50; -fx-font-weight: bold;" text="Admin">
                        <font><Font name="System Bold" size="15" /></font>
                    </Label>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: #95A5A6;" text="Administrateur">
                        <font><Font name="System" size="11" /></font>
                    </Label>
                </VBox>

                <!-- Avatar circulaire : photo si disponible, sinon emoji 👤 -->
                <StackPane>
                    <!-- Fond dégradé (visible si pas de photo) -->
                    <Circle fx:id="avatarBg" radius="24"
                            fill="linear-gradient(to bottom right, #667eea, #764ba2)" />
                    <!-- Emoji par défaut -->
                    <Label fx:id="avatarDefaultLabel"
                           style="-fx-font-size: 22px; -fx-text-fill: white;"
                           text="👤" />
                    <!-- Photo chargée depuis Cloudinary (clip appliqué en Java) -->
                    <ImageView fx:id="avatarImageView"
                               fitWidth="48" fitHeight="48"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>
            </HBox>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Text fill="#2C3E50" text="Gestion des Animaux">
                            <font><Font name="System Bold" size="26.0" /></font>
                        </Text>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onMouseClicked="#naviguerAnimaux" text="Table Animaux" style="-fx-background-color: #A3C1AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" />
                        <Button onMouseClicked="#naviguerVersExamens" text="Table Examens" style="-fx-background-color: #A3C1AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" />

                        <MenuButton mnemonicParsing="false" style="-fx-background-color: #34495E; -fx-text-fill: white; -fx-font-weight: bold;" text="🚀 Actions Avancées" textFill="WHITE">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#ouvrirSuggestions" text="💡 Suggestions Alimentaires" />
                                <MenuItem mnemonicParsing="false" onAction="#handleGenererCouples" text="🤝 Trouver Partenaire" />
                                <MenuItem mnemonicParsing="false" onAction="#handleGenererPDF" text="📄 Carnet Santé (PDF)" />
                                <MenuItem mnemonicParsing="false" onAction="#ouvrirStats" text="📊 Voir Statistiques" />
                            </items>
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </MenuButton>

                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <children>
                        <Label text="🔍 Rechercher :" style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" />
                        <TextField fx:id="filterField" prefWidth="400.0" promptText="Tapez un nom ou une espèce..." style="-fx-background-radius: 15; -fx-border-color: #A8C69F; -fx-border-radius: 15;" />
                    </children>
                </HBox>

                <TableView fx:id="tableAnimaux" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNom" prefWidth="150.0" text="Nom" />
                        <TableColumn fx:id="colEspece" prefWidth="150.0" text="Espèce" />
                        <TableColumn fx:id="colPoids" prefWidth="120.0" text="Poids (kg)" />
                        <TableColumn fx:id="colDate" prefWidth="180.0" text="Date Naissance" />
                        <TableColumn fx:id="colSexe" prefWidth="120.0" text="Sexe" />
                        <TableColumn fx:id="colAvatar" prefWidth="120.0" text="Photo Rèelle" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button onMouseClicked="#versAjout" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="+ AJOUTER" />
                        <Button onAction="#versModifier" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #A8C69F; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="MODIFIER" />
                        <Button onAction="#handleSupprimer" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="SUPPRIMER" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>