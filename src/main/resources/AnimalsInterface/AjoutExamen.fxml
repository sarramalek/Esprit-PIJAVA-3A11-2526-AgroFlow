<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="650.0" prefWidth="900.0" style="-fx-background-color: #FDFBF0;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Animaux.AjoutExamenController">
    <children>
        <VBox layoutX="300.0" layoutY="40.0" spacing="12.0" prefWidth="450.0">
            <children>
                <Text text="Nouvel Examen" style="-fx-font-size: 30; -fx-font-weight: bold; -fx-fill: #2C3E50;" />

                <Label text="Animal :" style="-fx-font-weight: bold;" />
                <ComboBox fx:id="cbAnimal" prefWidth="450.0" promptText="Choisir l'animal" />

                <Label text="Type d'Examen :" style="-fx-font-weight: bold;" />
                <TextField fx:id="tfType" promptText="Ex: Radio, Prise de sang" />

                <Label text="Date de l'Examen :" style="-fx-font-weight: bold;" />
                <DatePicker fx:id="dpDate" prefWidth="450.0" />

                <Label text="Diagnostic :" style="-fx-font-weight: bold;" />
                <TextArea fx:id="taDiagnostic" prefHeight="80.0" wrapText="true" />

                <Label text="Traitement prescrit :" style="-fx-font-weight: bold;" />
                <TextArea fx:id="taTraitement" prefHeight="80.0" wrapText="true" />

                <HBox spacing="20.0" alignment="CENTER_RIGHT" style="-fx-padding: 20 0 0 0;">
                    <children>
                        <Button onAction="#handleAjouter" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;" text="CONFIRMER L'AJOUT" />
                        <Button onAction="#retourListe" prefHeight="40.0" prefWidth="120.0" style="-fx-background-color: white; -fx-border-color: #2C3E50; -fx-border-radius: 5;" text="ANNULER" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </children>
</AnchorPane>