<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.geometry.Insets?>
<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #fcf8e6;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Animaux.ModifierExamenController">
    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: #2C3E50;">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Logo/Header -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 0 0 35 0;">
                <Label style="-fx-font-size: 32px;" text="🌱" />
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 5, 0, 0, 2);" text="AgroFlow">
                        <font><Font name="System Bold" size="26" /></font>
                    </Label>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);" text="Gestion Agricole">
                        <font><Font name="System" size="11" /></font>
                    </Label>
                </VBox>
            </HBox>

            <!-- Navigation Menu -->
            <VBox spacing="10">
                <!-- Dashboard -->
                <Button fx:id="dashboardBtn" onAction="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- Gestion Utilisateurs -->
                <VBox fx:id="gestionContainer" prefWidth="230" spacing="5" style="-fx-background-radius: 12;">
                    <Button fx:id="gestionBtn"  prefHeight="50" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"
                            text="⚙️  Gestion Utilisateurs">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                    <VBox fx:id="gestionSubmenu" spacing="3" style="-fx-padding: 5 0 5 15; -fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 0 0 12 12;">
                        <Button fx:id="personnesBtn" onMouseClicked="#handlePersonnes" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="👥  Personnes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="tachesBtn" onMouseClicked="#handleTaches" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="✓  Tâches">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="abonnementsBtn" onMouseClicked="#handleAbonnements" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="💳  Abonnements">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="offresBtn" onMouseClicked="#handleOffres" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🎁  Offres">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <Button fx:id="stocksBtn" onMouseClicked="#handleStocks" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="terrainsBtn" onMouseClicked="#handleTerrains" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Terrains">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="animauxBtn" onMouseClicked="#handleAnimals" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Animaux">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="materielBtn" onMouseClicked="#handleMateriels" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🔧  Matériel">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="evenementsBtn" onMouseClicked="#handleEvents" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🎉  Événements">
                    <font><Font name="System" size="14" /></font>
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout -->
            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox spacing="30.0" style="-fx-padding: 40;">
            <children>
                <Text fill="#2C3E50" text="Modifier l'Examen">
                    <font><Font name="System Bold" size="26.0" /></font>
                </Text>

                <GridPane hgap="15.0" vgap="15.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="120.0" />
                        <ColumnConstraints minWidth="300.0" />
                    </columnConstraints>
                    <children>
                        <Label text="Animal :" textFill="#2C3E50" GridPane.rowIndex="0" />
                        <ComboBox fx:id="cbAnimal" prefHeight="35.0" prefWidth="400.0" style="-fx-border-color: #A8C69F;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="Type d'examen :" textFill="#2C3E50" GridPane.rowIndex="1" />
                        <TextField fx:id="tfType" prefHeight="35.0" style="-fx-border-color: #A8C69F;" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="Date :" textFill="#2C3E50" GridPane.rowIndex="2" />
                        <DatePicker fx:id="dpDate" prefHeight="35.0" prefWidth="400.0" style="-fx-border-color: #A8C69F;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                        <Label text="Diagnostic :" textFill="#2C3E50" GridPane.rowIndex="3" />
                        <TextArea fx:id="taDiagnostic" prefHeight="80.0" style="-fx-border-color: #A8C69F;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                        <Label text="Traitement :" textFill="#2C3E50" GridPane.rowIndex="4" />
                        <TextArea fx:id="taTraitement" prefHeight="80.0" style="-fx-border-color: #A8C69F;" GridPane.columnIndex="1" GridPane.rowIndex="4" />
                    </children>
                </GridPane>

                <HBox spacing="15.0">
                    <children>
                        <Button onAction="#handleModifier" prefHeight="40.0" style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold;" text="ENREGISTRER LES MODIFS" />
                        <Button onAction="#retourListe" prefHeight="40.0" style="-fx-background-color: #A8C69F; -fx-text-fill: #2C3E50;" text="ANNULER" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>