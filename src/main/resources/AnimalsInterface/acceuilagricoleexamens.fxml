<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane prefHeight="805.0" prefWidth="1520.0"
            style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Animaux.AfficherExamensController">

    <!-- SIDEBAR AGRICOLE -->
    <left>
        <VBox prefWidth="260"
              style="-fx-background-color: #FAFAF5; -fx-border-color: #E8EDE0; -fx-border-width: 0 1 0 0;">
            <padding><Insets top="0" bottom="20" /></padding>

            <!-- Logo Header -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color: #FFFFFF; -fx-padding: 16 20; -fx-border-color: #E8EDE0; -fx-border-width: 0 0 1 0;">
                <StackPane prefWidth="36" prefHeight="36">
                    <ImageView fitWidth="36" fitHeight="36" preserveRatio="true">
                        <image><Image url="/style/logo.png"/></image>
                    </ImageView>
                </StackPane>
                <Label text="AgroFlow"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1B5E20;">
                    <font><Font name="System Bold" size="20" /></font>
                </Label>
            </HBox>

            <!-- User Info Card -->
            <VBox alignment="CENTER" spacing="6"
                  style="-fx-background-color: #FFFFFF; -fx-border-color: #E8EDE0;
                     -fx-border-width: 0 0 1 0; -fx-padding: 18 20;">

                <StackPane prefWidth="64" prefHeight="64">
                    <!-- Avatar background circle -->
                    <Circle fx:id="sidebarAvatarBg" radius="32"
                            fill="#E8F5E9" />
                    <!-- Default emoji -->
                    <Label fx:id="sidebarAvatarDefault"
                           style="-fx-font-size: 28px;"
                           text="👨‍🌾" />
                    <!-- Cloudinary photo -->
                    <ImageView fx:id="sidebarAvatarImageView"
                               fitWidth="64" fitHeight="64"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>

                <Label fx:id="userNameLabel"
                       style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1A2E1A;"
                       text="Nom Agriculteur">
                    <font><Font name="System Bold" size="15" /></font>
                </Label>

                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #2E7D32;
                          -fx-background-color: #E8F5E9; -fx-padding: 3 10;
                          -fx-background-radius: 20;"
                       text="🌾 AGRICULTEUR">
                    <font><Font name="System Bold" size="11" /></font>
                </Label>

                <Hyperlink fx:id="aproposLink" text="👤 À propos de moi"
                           onMouseClicked="#handleMonProfil"
                           style="-fx-text-fill: #388E3C; -fx-font-size: 12px;
                              -fx-border-color: #C8E6C9; -fx-padding: 4 14;
                              -fx-background-radius: 20; -fx-border-radius: 20;
                              -fx-cursor: hand; -fx-underline: false;">
                    <font><Font name="System" size="12" /></font>
                </Hyperlink>
            </VBox>

            <!-- Navigation Label -->
            <Label text="NAVIGATION"
                   style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #9E9E9E;
                      -fx-padding: 16 20 6 20; -fx-letter-spacing: 1px;">
                <font><Font name="System Bold" size="10" /></font>
            </Label>

            <!-- Navigation Menu -->
            <VBox spacing="2" style="-fx-padding: 0 12;">

                <!-- Accueil - Active State -->
                <Button onAction="#handleDashboard" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: #E8F5E9; -fx-text-fill: #1B5E20;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #A5D6A7; -fx-border-radius: 10; -fx-border-width: 1;"
                        text="📊  Accueil">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Ouvriers -->
                <Button onMouseClicked="#handlemesouvriers" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="👷  Mes Ouvriers">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Terrains avec sous-menu -->
                <VBox spacing="0">
                    <Button onMouseClicked="#handleMesTerrains" prefHeight="44" prefWidth="236"
                            style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                               -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                            text="🌾  Mes Terrains  ▾">
                        <font><Font name="System Bold" size="13" /></font>
                    </Button>
                    <!-- Sous-menu -->
                    <VBox fx:id="terrainsSubMenu" spacing="1"
                          style="-fx-padding: 2 0 2 12;" visible="false" managed="false">
                        <Button onMouseClicked="#ouvrirTerrains" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: #F1F8E9; -fx-text-fill: #33691E;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;
                                   -fx-border-color: #DCEDC8; -fx-border-radius: 8; -fx-border-width: 1;"
                                text="🚜  Terrains">
                            <font><Font name="System Bold" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirPlantes" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🌱  Plantes">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirRotations" prefHeight="38" prefWidth="224"
                                style="-fx-background-color: transparent; -fx-text-fill: #558B2F;
                                   -fx-font-size: 12px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 20; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="📋  Rotations">
                            <font><Font name="System" size="12" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <!-- Mes Animaux -->
                <Button onMouseClicked="#handleMesAnimaux" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="🐄  Mes Animaux">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Stocks -->
                <Button onMouseClicked="#handleMesArticles" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="📦  Mes Stocks">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mon Matériel -->
                <Button onMouseClicked="#handleMonMateriel" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="🚜  Mon Matériel">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Mes Abonnements -->
                <Button onMouseClicked="#handleMonAbonnement" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="💳  Mes Abonnements">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

                <!-- Événements -->
                <Button onMouseClicked="#handleMesEvenements" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: transparent; -fx-text-fill: #3E4A3E;
                           -fx-font-size: 13px; -fx-alignment: CENTER-LEFT;
                           -fx-padding: 0 0 0 16; -fx-background-radius: 10; -fx-cursor: hand;"
                        text="📅  Événements">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>

            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <!-- Separator -->
            <Separator style="-fx-background-color: #E0E8D8;" />

            <!-- Déconnexion -->
            <VBox style="-fx-padding: 12 12 0 12;">
                <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="44" prefWidth="236"
                        style="-fx-background-color: #FFF3F3; -fx-text-fill: #C62828;
                           -fx-font-size: 13px; -fx-font-weight: bold;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 16;
                           -fx-background-radius: 10; -fx-cursor: hand;
                           -fx-border-color: #FFCDD2; -fx-border-radius: 10; -fx-border-width: 1;"
                        text="🚪  Déconnexion">
                    <font><Font name="System Bold" size="13" /></font>
                </Button>
            </VBox>

        </VBox>
    </left>


    <!-- CONTENU PRINCIPAL -->
    <center>
        <VBox spacing="20.0" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="280.0" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="30.0">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Text fill="#2C3E50" text="Gestion des Examens">
                            <font><Font name="System Bold" size="26.0" /></font>
                        </Text>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button onMouseClicked="#handleMesAnimaux" style="-fx-background-color: #A3C1AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" text="Table Animaux" />
                        <Button style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" text="Table Examens" />

                        <MenuButton mnemonicParsing="false" style="-fx-background-color: #34495E; -fx-text-fill: white; -fx-font-weight: bold;" text="🔔 Suivi Médical" textFill="WHITE">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#ouvrirDetailsAlertes" text="⚠️ Voir les Alertes" />
                                <MenuItem mnemonicParsing="false" onAction="#ouvrirStats" text="📊 Stats Mensuelles" />
                                <SeparatorMenuItem />
                                <MenuItem mnemonicParsing="false" onAction="#traduireDiagnostics" text="🌍 Traduire Diagnostics (API)" />
                                <MenuItem mnemonicParsing="false" onAction="#afficherConseilsSante" text="💡 Conseils de Santé" />
                            </items>
                        </MenuButton>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <children>
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="🔍 Type d'Examen :" />
                                <TextField fx:id="filterType" prefWidth="180.0" promptText="Ex: Vaccin..." style="-fx-background-radius: 10; -fx-border-color: #A3C1AD;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0">
                            <children>
                                <Label style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" text="📅 Date précise :" />
                                <DatePicker fx:id="filterDate" prefWidth="160.0" style="-fx-border-color: #A3C1AD;" />
                            </children>
                        </VBox>
                        <Button onAction="#reinitialiserFiltres" style="-fx-background-color: #BDC3C7; -fx-text-fill: white; -fx-background-radius: 10;" text="Réinitialiser">
                            <HBox.margin><Insets top="20.0" /></HBox.margin>
                        </Button>
                    </children>
                </HBox>

                <TableView fx:id="tvExamens" style="-fx-background-radius: 10; -fx-border-color: #D5D8DC;" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colAnimal" prefWidth="100.0" text="Animal" />
                        <TableColumn fx:id="colType" prefWidth="110.0" text="Type" />
                        <TableColumn fx:id="colDate" prefWidth="95.0" text="Date" />
                        <TableColumn fx:id="colDiagnostic" prefWidth="120.0" text="Diagnostic" />
                        <TableColumn fx:id="colTraitement" prefWidth="120.0" text="Traitement" />
                        <TableColumn fx:id="colTraduction" prefWidth="140.0" text="Traduction (EN)" />
                        <TableColumn fx:id="colConseils" prefWidth="180.0" text="Conseils Médicaux" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <HBox alignment="CENTER" spacing="25.0">
                    <children>
                        <Button onMouseClicked="#naviguerAjout" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="+ AJOUTER" />
                        <Button onAction="#handleModifierAgr" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #A3C1AD; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-background-radius: 10;" text="MODIFIER" />
                        <Button onAction="#handleSupprimer" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="SUPPRIMER" />
                    </children>
                </HBox>
            </children>
        </VBox>


    </center>

</BorderPane>
