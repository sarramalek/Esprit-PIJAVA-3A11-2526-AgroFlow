<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.geometry.*?>

<?import javafx.scene.shape.Circle?>
<?import javafx.scene.image.ImageView?>
<BorderPane prefHeight="805.0" prefWidth="1520.0"
            style="-fx-background-color: #fcf8e6;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controllers.Animaux.AfficherAnimauxController">

    <!-- SIDEBAR AGRICOLE -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color: linear-gradient(to bottom, #2E7D32, #388E3C, #43A047);">
            <padding><Insets bottom="20" top="20" /></padding>

            <!-- Logo -->
            <HBox alignment="CENTER" spacing="12" style="-fx-padding: 0 0 20 0;">
                <Label style="-fx-font-size: 32px;" text="🌱" />
                <VBox alignment="CENTER_LEFT" spacing="2">
                    <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: white;" text="AgroFlow">
                        <font><Font name="System Bold" size="26" /></font>
                    </Label>
                    <Label style="-fx-font-size: 11px; -fx-text-fill: rgba(255,255,255,0.7);" text="Mon Exploitation">
                        <font><Font name="System" size="11" /></font>
                    </Label>
                </VBox>
            </HBox>

            <!-- Info Utilisateur avec Hyperlink À Propos -->
            <VBox alignment="CENTER" spacing="8"
                  style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 15; -fx-padding: 20; -fx-margin: 10;">

                <!-- Avatar circulaire -->
                <StackPane>
                    <!-- Fond dégradé (visible par défaut) -->
                    <Circle fx:id="sidebarAvatarBg" radius="35"
                            fill="rgba(255,255,255,0.2)" />
                    <!-- Emoji par défaut -->
                    <Label fx:id="sidebarAvatarDefault"
                           style="-fx-font-size: 30px;"
                           text="👨‍🌾" />
                    <!-- Photo Cloudinary (cachée par défaut, clip appliqué en Java) -->
                    <ImageView fx:id="sidebarAvatarImageView"
                               fitWidth="70" fitHeight="70"
                               preserveRatio="false"
                               visible="false" managed="false" />
                </StackPane>

                <Label fx:id="userNameLabel"
                       style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"
                       text="Nom Agriculteur">
                    <font><Font name="System Bold" size="16" /></font>
                </Label>
                <Label fx:id="userRoleLabel"
                       style="-fx-font-size: 12px; -fx-text-fill: rgba(255,255,255,0.8);
                  -fx-background-color: rgba(76,175,80,0.3); -fx-padding: 4 12;
                  -fx-background-radius: 15;"
                       text="🌾 AGRICULTEUR">
                    <font><Font name="System Bold" size="12" /></font>
                </Label>
                <!-- Hyperlink À Propos -->
                <Hyperlink fx:id="aproposLink" text="👤 À propos de moi"
                           onMouseClicked="#handleAPropos"
                           style="-fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 13px;
                      -fx-border-color: rgba(255,255,255,0.4); -fx-padding: 5 15;
                      -fx-background-radius: 20; -fx-border-radius: 20;
                      -fx-cursor: hand;">
                    <font><Font name="System" size="13" /></font>
                </Hyperlink>
            </VBox>

            <!-- Navigation Menu -->
            <VBox spacing="8" style="-fx-padding: 20 0 0 0;">
                <Button onMouseClicked="#handleDashboardAgricole" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📊  Acceuil ">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- Mes Terrains avec sous-menu (ouvert par défaut ici) -->
                <VBox spacing="0">
                    <Button onMouseClicked="#handleMesTerrains" prefHeight="48" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049);
                                   -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT;
                                   -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                            text="🌾  Mes Terrains  ▾">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>
                    <!-- Sous-menu Terrains -->
                    <VBox fx:id="terrainsSubMenu" spacing="2" style="-fx-padding: 4 0 0 0;" visible="true" managed="true">
                        <Button onMouseClicked="#ouvrirTerrains" prefHeight="40" prefWidth="230"
                                style="-fx-background-color: rgba(0,0,0,0.20); -fx-text-fill: white;
                                       -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 40;
                                       -fx-background-radius: 10; -fx-cursor: hand;"
                                text="🚜  Terrains">
                            <font><Font name="System Bold" size="13" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirPlantes" prefHeight="40" prefWidth="230"
                                style="-fx-background-color: rgba(0,0,0,0.15); -fx-text-fill: rgba(255,255,255,0.9);
                                       -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 40;
                                       -fx-background-radius: 10; -fx-cursor: hand;"
                                text="🌱  Plantes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button onMouseClicked="#ouvrirRotations" prefHeight="40" prefWidth="230"
                                style="-fx-background-color: rgba(0,0,0,0.15); -fx-text-fill: rgba(255,255,255,0.9);
                                       -fx-font-size: 13px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 40;
                                       -fx-background-radius: 10; -fx-cursor: hand;"
                                text="📋  Rotations">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <Button onMouseClicked="#handleMesAnimaux" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Mes Animaux">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
                <Button onAction="#handleMesStocks" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Mes Stocks">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
                <Button onAction="#handleMonMateriel" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🚜  Mon Matériel">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
                <Button onMouseClicked="#handleMonAbonnement" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white;
                               -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22;
                               -fx-background-radius: 12; -fx-cursor: hand;"
                        text="💳  Mes Abonnements">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>
            </VBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px;
                           -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12;
                           -fx-cursor: hand;"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>

    <!-- CONTENU PRINCIPAL -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 30;">
            <children>
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <children>
                        <Text fill="#2C3E50" text="Gestion des Animaux">
                            <font><Font name="System Bold" size="26.0" /></font>
                        </Text>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button  text="Table Animaux" style="-fx-background-color: #A3C1AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" />
                        <Button onAction="#goToExamens" text="Table Examens" style="-fx-background-color: #A3C1AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" />

                        <MenuButton mnemonicParsing="false" style="-fx-background-color: #34495E; -fx-text-fill: white; -fx-font-weight: bold;" text="🚀 Actions Avancées" textFill="WHITE">
                            <items>
                                <MenuItem mnemonicParsing="false" onAction="#ouvrirSuggestions" text="💡 Suggestions Alimentaires" />
                                <MenuItem mnemonicParsing="false" onAction="#handleGenererCouples" text="🤝 Trouver Partenaire" />
                                <MenuItem mnemonicParsing="false" onAction="#handleGenererPDF" text="📄 Carnet Santé (PDF)" />
                                <MenuItem mnemonicParsing="false" onAction="#ouvrirStats" text="📊 Voir Statistiques" />
                            </items>
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                        </MenuButton>
                    </children>
                </HBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0" style="-fx-background-color: white; -fx-padding: 10; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
                    <children>
                        <Label text="🔍 Rechercher :" style="-fx-font-weight: bold; -fx-text-fill: #2C3E50;" />
                        <TextField fx:id="filterField" prefWidth="400.0" promptText="Tapez un nom ou une espèce..." style="-fx-background-radius: 15; -fx-border-color: #A8C69F; -fx-border-radius: 15;" />
                    </children>
                </HBox>

                <TableView fx:id="tableAnimaux" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colNom" prefWidth="150.0" text="Nom" />
                        <TableColumn fx:id="colEspece" prefWidth="150.0" text="Espèce" />
                        <TableColumn fx:id="colPoids" prefWidth="120.0" text="Poids (kg)" />
                        <TableColumn fx:id="colDate" prefWidth="180.0" text="Date Naissance" />
                        <TableColumn fx:id="colSexe" prefWidth="120.0" text="Sexe" />
                        <TableColumn fx:id="colAvatar" prefWidth="120.0" text="Photo Rèelle" />
                    </columns>
                </TableView>

                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button onMouseClicked="#versAjoutAgr" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="+ AJOUTER" />
                        <Button onAction="#versModifierAgr" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #A8C69F; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="MODIFIER" />
                        <Button onAction="#handleSupprimer" prefHeight="45.0" prefWidth="160.0" style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand;" text="SUPPRIMER" />
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
