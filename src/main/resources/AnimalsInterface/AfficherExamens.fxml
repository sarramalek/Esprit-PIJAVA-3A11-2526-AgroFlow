<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #FDFBF0;" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.Animaux.AfficherExamensController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="250" style="-fx-background-color:  #617e9c;">
            <padding>
                <Insets bottom="20" top="20" />
            </padding>

            <!-- Logo/Header MODERNE -->
            <StackPane prefWidth="100" prefHeight="100"  >
                <ImageView fitWidth="200" fitHeight="150" preserveRatio="true">
                    <image><Image url="/style/logo.png"/></image>
                </ImageView>

            </StackPane>
            <padding>
                <Insets bottom="20" top="20" />
            </padding>
            <!-- Navigation Menu -->
            <VBox spacing="10">
                <!-- Dashboard -->
                <Button fx:id="dashboardBtn" onAction="#handleDashboard" prefHeight="50" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.15); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-border-color: rgba(255,255,255,0.2); -fx-border-width: 1; -fx-border-radius: 12;"
                        text="📊  Dashboard">
                    <font><Font name="System Bold" size="14" /></font>
                </Button>

                <!-- Gestion Utilisateurs -->
                <VBox fx:id="gestionContainer" prefWidth="230" spacing="5" style="-fx-background-radius: 12;">
                    <Button fx:id="gestionBtn"  prefHeight="50" prefWidth="230"
                            style="-fx-background-color: linear-gradient(to right, #4CAF50, #45a049); -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 8, 0, 0, 2);"
                            text="⚙️  Gestion Utilisateurs">
                        <font><Font name="System Bold" size="14" /></font>
                    </Button>

                    <VBox fx:id="gestionSubmenu" spacing="3" style="-fx-padding: 5 0 5 15; -fx-background-color: rgba(0,0,0,0.15); -fx-background-radius: 0 0 12 12;">
                        <Button fx:id="personnesBtn" onMouseClicked="#handlePersonnes" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="👥  Personnes">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="tachesBtn" onMouseClicked="#handleTaches" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="✓  Tâches">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="abonnementsBtn" onMouseClicked="#handleAbonnements" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="💳  Abonnements">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                        <Button fx:id="offresBtn" onMouseClicked="#handleOffres" prefHeight="42" prefWidth="215"
                                style="-fx-background-color: transparent; -fx-text-fill: rgba(255,255,255,0.95); -fx-font-size: 13px; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 15; -fx-background-radius: 8; -fx-cursor: hand;"
                                text="🎁  Offres">
                            <font><Font name="System" size="13" /></font>
                        </Button>
                    </VBox>
                </VBox>

                <Button fx:id="stocksBtn" onMouseClicked="#handleStocks" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="📦  Stocks">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="terrainsBtn" onMouseClicked="#handleTerrains" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🌾  Terrains">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="animauxBtn" onMouseClicked="#handleAnimals" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🐄  Animaux">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="materielBtn" onMouseClicked="#handleMateriels" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🔧  Matériel">
                    <font><Font name="System" size="14" /></font>
                </Button>
                <Button fx:id="evenementsBtn" onMouseClicked="#handleEvents" prefHeight="48" prefWidth="230"
                        style="-fx-background-color: rgba(255,255,255,0.1); -fx-text-fill: rgba(255,255,255,0.9); -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand;"
                        text="🎉  Événements">
                    <font><Font name="System" size="14" /></font>
                </Button>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS" />

            <!-- Logout -->
            <Button fx:id="logoutBtn" onAction="#handleLogout" prefHeight="50" prefWidth="230"
                    style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-size: 14px; -fx-alignment: CENTER-LEFT; -fx-padding: 0 0 0 22; -fx-background-radius: 12; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.4), 10, 0, 0, 3);"
                    text="🚪  Déconnexion">
                <font><Font name="System Bold" size="14" /></font>
            </Button>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: #FDFBF0;">

            <!-- Title + Tab Buttons -->
            <HBox alignment="CENTER">
                <Text fill="#2C3E50" text="Gestion des Examens">
                    <font><Font name="System Bold" size="24.0" /></font>
                </Text>
                <HBox alignment="CENTER" spacing="10.0" style="-fx-padding: 10;">
                    <Button onMouseClicked="#naviguerVersAnimaux" prefWidth="150.0" text="Table Animaux"
                            style="-fx-background-color: #A3C1AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" />
                    <Button prefWidth="150.0" text="Table Examens"
                            style="-fx-background-color: #A3C1AD; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 20;" />
                </HBox>
                <VBox.margin><Insets bottom="10.0" top="10.0" /></VBox.margin>
            </HBox>

            <!-- Table -->
            <TableView fx:id="tvExamens" prefHeight="380.0" prefWidth="650.0" VBox.vgrow="ALWAYS"
                       style="-fx-background-radius: 5; -fx-border-color: #D5D8DC;">
                <columns>
                    <TableColumn fx:id="colAnimal"     prefWidth="100.0" text="ID Animal" />
                    <TableColumn fx:id="colType"       prefWidth="150.0" text="Type Examen" />
                    <TableColumn fx:id="colDate"       prefWidth="120.0" text="Date Examen" />
                    <TableColumn fx:id="colDiagnostic" prefWidth="180.0" text="Diagnostic" />
                    <TableColumn fx:id="colTraitement" prefWidth="180.0" text="Traitement" />
                </columns>
            </TableView>

            <!-- Action Buttons -->
            <HBox alignment="CENTER" spacing="30.0">
                <Button onAction="#naviguerAjout" prefHeight="45.0" prefWidth="180.0"
                        style="-fx-background-color: #2D5A27; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                        text="+ AJOUTER" />
                <Button onAction="#handleModifier" prefHeight="45.0" prefWidth="180.0"
                        style="-fx-background-color: #A3C1AD; -fx-text-fill: #2C3E50; -fx-font-weight: bold; -fx-background-radius: 5;"
                        text="MODIFIER" />
                <Button onAction="#handleSupprimer" prefHeight="45.0" prefWidth="180.0"
                        style="-fx-background-color: #E74C3C; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 5;"
                        text="SUPPRIMER" />
                <VBox.margin><Insets top="10.0" /></VBox.margin>
            </HBox>

        </VBox>
    </center>

</BorderPane>